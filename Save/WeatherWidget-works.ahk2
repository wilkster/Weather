;@Ahk2Exe-SetName Weather
;@Ahk2Exe-SetDescription Weather App
;@Ahk2Exe-Set Comments, Weather
;@Ahk2Exe-SetVersion 2026.10.12
;@Ahk2Exe-SetCopyright Copyright (c) 2026 Tom Wilkason
;@Ahk2Exe-SetOrigFilename Weather.exe
;@Ahk2Exe-SetMainIcon Partly Cloudy.ico
#SingleInstance Off
#Requires AutoHotkey v2.0
/*
TODO
- seems to stay on all desktops, this is desired
- Don't write any settings that aren't changed in the app unless they don't already exist
- Add F or C option in settings, also windspeed, temperature_unit=fahrenheit, wind_speed_unit=mph
  current_units "wind_speed_10m": "mp/h" has it embedded, "temperature_2m": "°F"
- Moon phases for night, https://www.amp-what.com/unicode/search/moon
- Hourly air quality data? Wider GUI
- If changing days/interval, need to restart due to size changes, auto handle this? Better calculation of rows.
- https://github.com/Makin-Things/weather-icons (SVG, some are animated)
*/
class Weather {
   static Lat           := 34.0447
   static Lon           := -118.2493
   static CC            := "us"
   static Name          := "Los Angeles, CA"
   static Interval      := 30 * 60 * 1000   ; ms
   static Gui           := ""
   static Ctl           := {}
   static Menu          := ""
   Static ActiveIcon    := ""
   Static forecastDays  := 2
   Static hourIncrement := 3
   Static maxRows       := 8
  /*
      WMO Weather Codes Reference
      Code	      Description
      0	         Clear sky
      1, 2, 3	   Mainly clear, partly cloudy, and overcast
      45, 48	   Fog and depositing rime fog
      51, 53, 55	Drizzle: Light, moderate, and dense intensity
      56, 57	   Freezing Drizzle: Light and dense intensity
      61, 63, 65	Rain: Slight, moderate and heavy intensity
      66, 67	   Freezing Rain: Light and heavy intensity
      71, 73, 75	Snow fall: Slight, moderate, and heavy intensity
      77	         Snow grains
      80, 81, 82	Rain showers: Slight, moderate, and violent
      85, 86	   Snow showers slight and heavy
      95	         Thunderstorm: Slight or moderate
      96, 99	   Thunderstorm with slight and heavy hail

   */
   static Codes    := Map(
      0,  "Clear",
      1,  "Mainly clear",
      2,  "Partly cloudy",
      3,  "Overcast",
      45, "Fog",
      48, "Rime fog",
      51, "Light drizzle",
      53, "Drizzle",
      55, "Heavy drizzle",
      56, "Light Freezing drizzle",
      57, "Dense Freezing drizzle",
      61, "Light rain",
      63, "Rain",
      65, "Heavy rain",
      66, "Light Freezing rain",
      67, "Heavy Freezing rain",
      71, "Light snow",
      73, "Snow",
      75, "Heavy snow",
      77, "Snow grains",
      80, "Light showers",
      81, "Showers",
      82, "Heavy showers",
      85, "Snow showers",
      86, "Heavy snow showers",
      95, "Thunderstorm",
      96, "Thunderstorm, hail",
      99, "Intense Thunderstorm, hail"
   )
   Static Icons := Map(
      0, "Clear",               ;"Clear",
      1, "Light Clouds",        ;"Mainly clear",
      2, "Partly Cloudy",       ;"Partly cloudy",
      3, "Overcast",            ;"Overcast",
      45, "Fog",                ;"Fog",
      48, "Fog",                ;"Rime fog",
      51, "Drizzle",            ;"Light drizzle",
      53, "Drizzle",            ;"Drizzle",
      55, "Drizzle",            ;"Heavy drizzle",
      56, "Freezing drizzle",   ;"Freezing drizzle",
      57, "Freezing drizzle",   ;"Freezing drizzle",
      61, "Light Showers",      ;"Light rain",
      63, "Rain",               ;"Rain",
      65, "Rain",               ;"Heavy rain",
      66, "Freezing rain",      ;"Freezing rain",
      67, "Freezing rain",      ;"Freezing rain",
      71, "Light Snow",         ;"Light snow",
      73, "Snow",               ;"Snow",
      75, "Heavy Snow",         ;"Heavy snow",
      77, "Snow",               ;"Snow grains",
      80, "Light Showers",      ;"Light showers",
      81, "Light Showers",      ;"Showers",
      82, "Rain",               ;"Heavy showers",
      85, "Snow",               ;"Snow showers",
      86, "Snow",               ;"Heavy snow showers",
      95, "Thunderstorm",       ;"Thunderstorm",
      96, "Thunderstorm",       ;"Thunderstorm, hail",
      99, "Thunderstorm"        ;"Thunderstorm, hail"
   )
   Static emoji := map(
      0, "☀",         ;"Clear",
      1, "⛅",        ;"Mainly clear",
      2, "⛅",        ;"Partly cloudy",
      3, "☁",         ;"Overcast",
      45, "☁",        ;"Fog",
      48, "☁",        ;"Rime fog",
      51, "🌦",        ;"Light drizzle",
      53, "🌦",        ;"Drizzle",
      55, "☔",       ;"Heavy drizzle",
      56, "☔",       ;"Freezing drizzle",
      57, "☔",       ;"Freezing drizzle",
      61, "☔",       ;"Light rain",
      63, "☔",        ;"Rain",
      65, "☔",        ;"Heavy rain",
      66, "⛈",        ;"Freezing rain",
      67, "⛈",        ;"Freezing rain",
      71, "❄",        ;"Light snow",
      73, "❄",        ;"Snow",
      75, "⛄",       ;"Heavy snow",
      77, "❄",        ;"Snow grains",
      80, "☔",       ;"Light showers",
      81, "☔",       ;"Showers",
      82, "⛈",        ;"Heavy showers",
      85, "❄",        ;"Snow showers",
      86, "❄",        ;"Heavy snow showers",
      95, "🌩",        ;"Thunderstorm",
      96, "⛈",        ;"Thunderstorm, hail",
      99, "⛈"         ;"Thunderstorm, hail"
   )
   /**
    * Called during program startup
    */
   static Init() {
      this.Menu := Menu()
      this.iniFile := A_ScriptDir "\WeatherWidget.ini"
      this.NeedGeo := 1
      this.OnTop := 0
      If (FileExist(this.iniFile)) {
         ; Set default locations
         this.Name := IniRead(this.iniFile, A_ComputerName, "Loc", this.Name)
         If (obj := this.GeocodeName(this.Name)) {
            this.Lat     := obj.lat
            this.Lon     := obj.lon
            this.CC      := obj.CC
            this.NeedGeo := false
         }
         this.Interval      := IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30) * 60 * 1000
         this.OnTop         := IniRead(this.iniFile, A_ComputerName, "OnTop", this.OnTop)
         this.forecastDays  := IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays) * 1
         this.hourIncrement := IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement) * 1
         this.maxRows       := IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows) * 1

      } Else {
         this.NeedGeo := false
         IniWrite(this.Interval/60000, this.iniFile, A_ComputerName, "Refresh Minutes")
         IniWrite(this.Name, this.iniFile, A_ComputerName, "Loc")
         IniWrite(this.Name, this.iniFile, "Locations", "Loc1")
      }
      ; Build the GUI, should be DPI aware, composting helps with flicker
      g := this.Gui := Gui("-Caption +ToolWindow +Border +DPIScale +E0x02000000")
      g.BackColor := "1E1E2E"
      g.MarginX := 10, g.MarginY := 8
      /*
         y+N is relative to the bottom edge of the previous control.
         yp+N is relative to the top edge (Y position) of the previous control. p = previous
         ym adds a margin
         r8 means 8 rows
      */
      dw := "w260"
      ; BUG - nForecasts is too simplistic assumes today is over, dymaically adjust hourly control
      ;       Maybe set max intervarls instead
      this.Ctl.loc     := this.AddTextCtl("w170",                this.Name,    "s9  cA6ADC8",      "Segoe UI")
      this.Ctl.temp    := this.AddTextCtl("w78 y+2 Right",       "---°",       "s28 cFFFFFF Bold", "Segoe UI")
      this.Ctl.AQI     := this.AddTextCtl("w40 x+0 yp+12 Right" , "---",       "s20 cFFFFFF Bold", "Segoe UI")
      this.Ctl.AQIlab  := this.AddTextCtl("w30 x+2 yp+13"       ,"aqi",        "s9  cA6ADC8 Norm", "Segoe UI")
      this.Ctl.cond    := this.AddTextCtl(dw " xm y+18"         ,"Loading...", "s11 cd5defa Norm", "Segoe UI")
      this.Ctl.detail  := this.AddTextCtl(dw " y+8",,                          "s10 cbcc3e1",      "Segoe UI")
      this.Ctl.tod     := this.AddTextCtl(dw " y+8",,                          "s10 cF9E2AF",      "Consolas")
      this.Ctl.tom     := this.AddTextCtl(dw " y+2",,                          "s10 cb5a47f",      "Consolas")
      this.Ctl.hourly  := this.AddTextCtl(dw " r" this.maxRows " y+8",,        "s10 cCDD6F4",      "Consolas")
      this.Ctl.updated := this.AddTextCtl(dw,,                                 "s8  c6C7086",      "Segoe UI")
      this.Ctl.Icon    := g.AddPicture("H96 W96 X160 Y0")

      ; Pretty up the window
      this.Round11Corners(g.hWnd)
      this.DropShadow(g.hWnd)

      ; Hand mouse drag/tray click/RMB Menu
      OnMessage(0x201, this.Drag.bind(this))
      OnMessage(0x232, this.SnapToWorkArea.bind(this))   ; WM_EXITSIZEMOVE
      OnMessage(0x404, this.TrayMessage.Bind(this))
      g.OnEvent("ContextMenu", (*) => this.ShowRMB())

      ; Callback for refresh
      this.cbUpdateData := this.RefreshData.bind(this)

      ; Keep on visible monitors, measure first
      g.Show("NoActivate Hide AutoSize")
      g.GetPos(,,&W, &H)
      X := Min(IniRead(this.iniFile, A_ComputerName, "X", 0), SysGet(78) - W * A_ScreenDPI / 96)
      Y := Min(IniRead(this.iniFile, A_ComputerName, "Y", 0), SysGet(79) - H * A_ScreenDPI / 96)
      this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      g.Show("NoActivate x" X " y" Y)
      this.RefreshData()

      OnExit this.SaveOnExit.bind(this)
   }
   /**
    * Read the locations in the order they are in the ini file
    * loc=... is optional
    * Allows user to reorder as desired
    * @param iniFile Name of ini file
    * @param {String} section 
    * @returns {Array} Location names
    */
   Static ReadLocations(iniFile, section := "Locations") {
      cities := []
      for line in StrSplit(IniRead(iniFile, section), "`n", "`r") {
         pos := InStr(line, "=")
         city := Trim(pos ? SubStr(line, pos + 1) : line)
         if (city != "")
            cities.Push(city)
      }
      return cities
   } 
   /**
    * Helper method to add a text control with a font, returns the control
    * @param options size/placement options
    * @param default initial text
    * @param fontOpt font options (size, color, weight)
    * @param fontName font name
    * @returns {Gui.Text} the new control
    */
   Static AddTextCtl(options, default?, fontOpt?, fontName?) {
      if (IsSet(fontOpt) || IsSet(fontName))
         this.gui.SetFont(fontOpt ?? "", fontName ?? "")
      return this.gui.AddText(options, default ?? "")
   }
   /**
    * Build/Rebuild/Show the RMB menu
    */
   Static ShowRMB() {
      this.BuildRMB()
      this.Menu.Show()
   }
   /**
    * Rebuild the RMB menu before launching it in case the settings file changed
    */
   Static BuildRMB() {
      this.Menu.Delete()
      this.Menu := Menu()
      ; Read the whole section to so retain order in the file vs by number
      ; This allows duplicate entries or just loc=.......
      If (FileExist(this.iniFile)) {
         maxLoc :=IniRead(this.iniFile, "Default", "Max Locations", 50)
         for idx,loc in this.ReadLocations(this.iniFile) {
            this.menu.add(loc, this.setlocation.bind(this))
            if (loc = this.Name)
               this.menu.Check(loc)               
            if idx >= maxLoc
               break
         }
      } else
         this.Menu.Add("Refresh now", this.cbUpdateData)
      this.Menu.add()
      mn := "Always On Top"
      this.Menu.Add(mn, Toggle)  ; Creates a new menu item.
      If (this.OnTop)
         this.Menu.Check(mn)
      this.Menu.Add("Edit Settings File", (*) => Run(this.iniFile))  ; Creates a new menu item.
      this.Menu.Add("Exit", (*) => ExitApp())
      Toggle(*) {
         this.OnTop := !this.OnTop
         IniWrite(this.OnTop, this.iniFile, A_ComputerName, "OnTop")
         this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      } 
   }
   
   /**
    * Callback when user selects a new location
    * @param place Name of location
    * @param ItemPos menu position
    * @param MyMenu menu handle
    */
   Static SetLocation(place, ItemPos, MyMenu) {
      If (obj := this.GeocodeName(place)) {
         this.Lat           := obj.lat
         this.Lon           := obj.lon
         this.CC            := obj.CC
         this.NeedGeo       := false
         this.name          := place
         IniWrite(place, this.iniFile, A_ComputerName, "Loc")
         IniWrite(this.CC, this.iniFile, place, "CC")
         IniWrite(this.Lat, this.iniFile, place, "Lat")
         IniWrite(this.Lon, this.iniFile, place, "Lon")
      } Else {
         this.NeedGeo          := TRUE
         this.Ctl.updated.Text := "Location lookup failed for " place
         MsgBox("Failed to get a location for`n" place, "Location Error", 0x30)
      }
      ; User may have changed these by hand
      this.Interval      := IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30) * 60 * 1000
      this.forecastDays  := IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays) * 1
      this.hourIncrement := IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement) * 1
      this.maxRows       := IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows) * 1
      this.RefreshData()
   }
   /**
    * Save Gui location on exit
    */
   static SaveOnExit(ExitReason, ExitCode) {
      this.Gui.GetPos(&X, &Y)
      IniWrite(this.Name, this.iniFile, A_ComputerName, "Loc")
      IniWrite(X, this.iniFile, A_ComputerName, "X")
      IniWrite(Y, this.iniFile, A_ComputerName, "Y")
      IniWrite(this.Interval / 60000, this.iniFile, A_ComputerName, "Refresh Minutes")
      IniWrite(this.forecastDays, this.iniFile, A_ComputerName, "Forecast Days")
      IniWrite(this.hourIncrement, this.iniFile, A_ComputerName, "Hours Increment")
      IniWrite(this.maxRows, this.iniFile, A_ComputerName, "Max Rows")
   }
   /**
    * Drag the GUI on a message since we don't have a caption
    */
   static Drag(wParam, lParam, msg, hwnd) {
      If (hwnd = this.Gui.Hwnd) {
         DllCall("ReleaseCapture")
         PostMessage(0xA1, 2, , , this.Gui)   ; WM_NCLBUTTONDOWN, HTCAPTION
      }
   }
   /**
    * Snap the GUI so it is fully enclosed by a monitor
    */
   Static SnapToWorkArea(wParam, lParam, msg, hwnd) {
      If (hwnd != this.Gui.Hwnd)
         Return
      hMon := DllCall("MonitorFromWindow", "Ptr", hwnd, "UInt", 2, "Ptr")   ; MONITOR_DEFAULTTONEAREST
      mi := Buffer(40, 0)
      NumPut("UInt", 40, mi)                                                 ; MONITORINFO.cbSize
      DllCall("GetMonitorInfo", "Ptr", hMon, "Ptr", mi)
      L := NumGet(mi, 20, "Int"), T := NumGet(mi, 24, "Int")                 ; rcWork
      R := NumGet(mi, 28, "Int"), B := NumGet(mi, 32, "Int")
      WinGetPos(&x, &y, &w, &h, this.Gui)
      nx := Max(L, Min(x, R - w))
      ny := Max(T, Min(y, B - h))
      If (nx != x || ny != y)
         WinMove(nx, ny, , , this.Gui)
   }
   /**
    * Refresh the weather and Air Quality data
    * Reschedule the timer depending on result
    */
   Static RefreshData(*) {
      ok := this.UpdateWeather()
      ok := this.UpdateAirQuality() && ok
      SetTimer(this.cbUpdateData, ok ? this.Interval : -60000)
      this.PruneMemory()
      OutputDebug("WeatherWidget: Updated Weather and Air Quality for " this.name)
   }
   /**
    * Resolve lat/lon from the location name if needed.
    * @returns {Boolean} true if coordinates are available, false if the lookup failed
    */
   Static EnsureGeo() {
      If (!this.NeedGeo)
         Return true
      If (!(obj := this.GeocodeName(this.Name))) {
         this.Ctl.updated.Text := "Location lookup failed for " this.Name " - " FormatTime(, "h:mm tt")
         Return false
      }
      this.Lat := obj.lat, this.Lon := obj.lon, this.CC :=obj.CC, this.NeedGeo := false
      Return true
   }

   /**
    * GET a URL and hand the response text to a renderer.
    * On any failure, shows the error and schedules a retry.
    * @param url The full request URL
    * @param renderer Callback that receives the response text
    */
   Static Query(url, renderer) {
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(5000, 5000, 10000, 10000)
         http.Open("GET", url, false)
         http.Send()
         if (http.Status != 200)
            throw Error("HTTP " http.Status)
      } catch Any as e {
         this.Ctl.updated.Text := "Update failed " FormatTime(, "h:mm tt") " (" e.Message ")"
         Return false
      }
      Try {
         renderer(http.ResponseText)
      } Catch Any As e {
         this.Ctl.updated.Text := "Render Error " FormatTime(, "h:mm tt") " (" e.Message ")"
         Return false
      }
      Return true
   }

   /**
    * Query the JSON Air Quality data
    * NOTE : If location is in europe (), may be better to use the europe standard of european_aqi.
    *        Note, the color coding breakpoints would be differnt
    */
   Static UpdateAirQuality(*) {
      If (!this.EnsureGeo())
         Return false
      ; TODO - utilize hourly AQI data: add "&hourly=us_aqi" to the URL
      url := "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" this.Lat "&longitude=" this.Lon "&current=us_aqi"
      Return this.Query(url, this.RenderAQI.Bind(this))
   }

   /**
    * Query the JSON Weather data
    */
   Static UpdateWeather(*) {
      If (!this.EnsureGeo())
         Return false
      url := "https://api.open-meteo.com/v1/forecast?latitude=" this.Lat "&longitude=" this.Lon
         . "&current=weather_code,temperature_2m,wind_speed_10m,wind_direction_10m,apparent_temperature,relative_humidity_2m,is_day"
         . "&hourly=weather_code,temperature_2m,precipitation_probability,wind_speed_10m,wind_direction_10m,is_day"
         . "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max"
         . "&temperature_unit=fahrenheit&wind_speed_unit=mph&forecast_days=" max(this.forecastDays,2) "&timezone=auto"
      Return this.Query(url, this.RenderWeather.Bind(this))
   }

   /**
    * Render the US Air Quality data based on JSON data
    * @param json Query Results
    */
   Static RenderAQI(json) {
      cur := this.Section(json, "current")
      v := this.Value(cur, "us_aqi")
      If (!IsNumber(v)) {
         this.Ctl.AQI.Text := "---"
         Return
      }
      aqi := Integer(v)
      this.Ctl.AQI.Text := aqi
      this.Ctl.AQI.SetFont("C" this.AqiColor(aqi))
   }
   Static AqiColor(aqi) {
      Return (aqi = "" || aqi < 0) ? "ffffff"
      : aqi <= 50 ? "1dd31d"
      : aqi <= 100 ? "cece1f"
      : aqi <= 150 ? "c9721b"
      : aqi <= 200 ? "f93434"
      : aqi <= 300 ? "99004C"
      : "7E0023"
   }
   /**
    * Render the weather related text fields with updated data
    * @param json Json text to parse
    */
   static RenderWeather(json) {
      this.Ctl.loc.Text := this.Name
      cur := this.Section(json, "current")
      day := this.Section(json, "daily")
      hrs := this.Section(json, "hourly")

      code  := Integer(this.Value(cur, "weather_code"))
      isDay := Integer(this.Value(cur, "is_day"))
      tf    := Round(this.Value(cur, "temperature_2m"))
      d     := Compass(this.Value(cur, "wind_direction_10m"))
      this.Ctl.temp.Text := tf "°"
      this.Ctl.cond.Text := this.Codes.Get(code, "Code " code)
      this.Ctl.detail.Text := (tf < 40 ? "❄ " : "") . "Feels " Round(this.Value(cur, "apparent_temperature")) "°"
         . "   Hum " Round(this.Value(cur, "relative_humidity_2m")) "%"
         . "   Wind " Round(this.Value(cur, "wind_speed_10m")) " mph " d
      ; Today
      hi := Round(this.List(day, "temperature_2m_max")[1])
      lo := Round(this.List(day, "temperature_2m_min")[1])
      pop := this.List(day, "precipitation_probability_max")[1]
      this.Ctl.tod.Text := "Today    H " hi "° L " lo "° Precip " (IsNumber(pop) ? pop : "--") "%"
      ; Tomorrow
      hi := Round(this.List(day, "temperature_2m_max")[2])
      lo := Round(this.List(day, "temperature_2m_min")[2])
      pop := this.List(day, "precipitation_probability_max")[2]
      this.Ctl.tom.Text := "Tomorrow H " hi "° L " lo "° Precip " (IsNumber(pop) ? pop : "--") "%"

      ; Hourly slots every 3 hours for the rest of the day
      RegExMatch(cur, '"time":"[^T]+T(\d+)', &m)
      ; Hr data starts at today's midnight
      temps := this.List(hrs, "temperature_2m")
      pops  := this.List(hrs, "precipitation_probability")
      winds := this.List(hrs, "wind_speed_10m")
      dirs  := this.List(hrs, "wind_direction_10m")
      codes := this.List(hrs, "weather_code")
      dns   := this.List(hrs, "is_day")
      out   := "   Time  Temp    Prec    Wind`n"
      h     := Integer(m[1]) + 1 ; Next hour
      ; Build the 3 hours forecast for the next 
      while (A_Index <= this.maxRows && h < temps.Length) {
         dn := dns[h + 1]  ; 0 hour is midnight, 1am is 1
         t := temps[h + 1]  ; 0 hour is midnight, 1am is 1
         p := pops[h + 1]
         w := winds[h + 1]
         d := Compass(dirs[h + 1])
         wc := this.emoji.get(Integer(codes[h+1]),"🌈")
         out .= daynight(dn) . this.Pad(this.Hour12(h), 6)
            . this.Pad(IsNumber(t) ? (Round(t) "°") : "--", 5) . " " . wc
            . this.Pad(IsNumber(p) ? (p "%") : "--", 5)
            . "  " . this.Pad(IsNumber(w) ? (Round(w) " mph ") : ("--"),8) d "`n"
         h += this.hourIncrement
      }
      this.Ctl.hourly.Text := RTrim(out, "`n")
      this.Ctl.updated.Text := "Updated " FormatTime(, "h:mm tt")
      ; Added for tray and icons
      If (this.Icons.has(code)) {
         Icon := A_ScriptDir . "\" . this.Icons[code] . ".ico"
         ; Night time has some adjustments
         If (NOT isDay) {
            AltIcon := A_ScriptDir . "\Night " . this.Icons[code] . ".ico"
            if (FileExist(AltIcon))
               Icon := AltIcon
         }
         this.Gui.BackColor := isDay ? "1E1E2E" : "11111B"
         If (FileExist(Icon)) {
            If (Icon != this.ActiveIcon) {
               TraySetIcon(Icon)
               this.Ctl.Icon.Value := Icon
               this.ActiveIcon := Icon
            }
         } Else {
            OutputDebug("Missing expected Icon File:" Icon)
         }
         A_IconTip := this.Name "`n" (Round(this.Value(cur, "temperature_2m")) . "° - " . this.Codes[code])
      }
      static Compass(deg) {
         if (!IsNumber(deg))
            return "?"
         return ["↓","↙N","↙","↙E","←","↖E","↖","↖S","↑","S↗","↗","W↗","→","W↘","↘","N↘"][Mod(Round(deg / 22.5), 16) + 1]
      }
      Static daynight(dn) {
         if (!IsNumber(dn))
            return "?"
         return ["🌙","☀️"][dn+1]
      }
   }

   static Section(json, name) => RegExMatch(json, '"' name '":\{([^}]*)\}', &m) ? m[1] : ""
   static Value(sec, key)     => RegExMatch(sec, '"' key '":(-?[\d.]+)', &m) ? m[1] : ""
   static List(sec, key)      => RegExMatch(sec, '"' key '":\[([^\]]*)\]', &m) ? StrSplit(m[1], ",") : []
   static Hour12(h)           => ((h := Mod(h, 24)) = 0 ? 12 : h > 12 ? h - 12 : h) (h < 12 ? " AM" : " PM")
   static Pad(s, n)           => Format("{:" n "}", s)
   ;----------------------------------------------------------------------------
   ; Round the corners of the GUI for windows 11, ignored on Windows 10
   ; Also draws a rounded border
   ; Needed since we don't have a caption
   ; This value is supported starting with Windows 11 Build 22000
   ;----------------------------------------------------------------------------
   Static Round11Corners(hWnd, how := 2) {
      howRound := how
      ; round corners on windows 11, ignored by windows 10
      ; DWMWA_WINDOW_CORNER_PREFERENCE = 33
      ; DWMWCP_ROUND=2, 4 = size of int
      DllCall("dwmapi\DwmSetWindowAttribute"
         , "Ptr", hWnd
         , "UInt", DWMWA_WINDOW_CORNER_PREFERENCE := 33
         , "Int*", &howRound
         , "UInt", 4)

   }   
   /**
    * Give the window a drop shadow, since no caption it won't do it by default
    * Also gives it the standard windows 11 drop shadow
    */
   Static DropShadow(hwnd) {
      DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 2, "Int*", 2, "UInt", 4)   ; DWMWA_NCRENDERING_POLICY = DWMNCRP_ENABLED
      mar := Buffer(16, 0)
      NumPut("Int", 1, "Int", 1, "Int", 1, "Int", 1, mar)   ; left, right, top, bottom
      DllCall("dwmapi\DwmExtendFrameIntoClientArea", "Ptr", hwnd, "Ptr", mar)
   }

   /**
    * Tray message callback when icon is clicked, toggle the window visibility
    */
   Static TrayMessage(wParam, lParam, uMsg, hWnd) {
      ; debug(hex(lParam))
      Switch lParam {
         Case 0x201:   ; user left-clicked tray icon
            ; Send "#{Tab}"
         Case 0x202:   ; user left-clicked tray icon
            if (this.IsWindowVisible(this.Gui.hWnd))
               this.Gui.hide()
            else
               this.Gui.show()
         Case 0x203:   ; user double left-clicked tray icon
         Case 0x204:   ; user right-clicked tray icon
         Case 0x208:   ; user middle-clicked tray icon
         Default:
      }
   }
   Static IsWindowVisible(hwndTry) => DllCall("User32.dll\IsWindowVisible", "Ptr", hwndTry)
   Static PruneMemory() => DllCall("psapi\EmptyWorkingSet", "ptr", -1)

   /**
    * Return an object with the lat/long of some place
    * @param place Name of location
    * @returns {Integer | Object}  n.lat, n.lon, n.name
    */
   Static GeocodeName(place) {
      ; See if location is cached
      If (lat := IniRead(this.iniFile, place, "Lat", 0)) {
         lon := IniRead(this.iniFile, place, "Lon", 0)
         CC  := IniRead(this.iniFile, place, "CC", "us")
         return {lat: Round(lat,7), lon: Round(lon,7), name: place, CC: CC}
      }
      ; Query location data from openstreetmap
      url := "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&q=" UriEncode(place)
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(5000, 5000, 10000, 10000)
         http.Open("GET", url, false)
         http.SetRequestHeader("User-Agent", "AHK2-GeoLookup/1.0")   ; required by Nominatim
         http.Send()
         txt := http.ResponseText
      } catch
         return false

      if !RegExMatch(txt, '"lat":"(-?[\d.]+)"', &mLat)
      || !RegExMatch(txt, '"lon":"(-?[\d.]+)"', &mLon)
         return false   ; empty result "[]"

      RegExMatch(txt, '"display_name":"((?:[^"\\]|\\.)*)"', &mName)
      RegExMatch(txt, '"country_code":"([a-z]{2})"', &mCC)
      return {lat: Round(mLat[1],7), lon: Round(mLon[1],7), name: mName ? mName[1] : place, CC: mCC ? mCC[1] : ""}
      
      UriEncode(s) {
         n := StrPut(s, "UTF-8") - 1
         buf := Buffer(n + 1)
         StrPut(s, buf, "UTF-8")
         out := ""
         Loop n {
            b := NumGet(buf, A_Index - 1, "UChar")
            if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
            || b = 45 || b = 46 || b = 95 || b = 126
               out .= Chr(b)
            else
               out .= Format("%{:02X}", b)
         }
         return out
      }   
   }

}

/**
 * On unlock or resume from sleep, refresh immediatly
 */
SetupEventMonitoring() {
   Static WM_POWERBROADCAST    := 0x0218
   Static WM_DISPLAYCHANGE     := 0x7E
   Static WM_WTSSESSION_CHANGE := 0x2B1
   ; Registers to receive notification when the system is suspended or resumed
   Static hwndNotification := 0
   hwndNotification := DllCall("RegisterSuspendResumeNotification", "Ptr", A_ScriptHwnd, "UInt", 0, "Ptr")
   ; Registers the specified window to receive session change notifications
   ; DllCall("Wtsapi32.dll\WTSRegisterSessionNotification", "ptr", A_ScriptHwnd, "uint", 1)
   DllCall("Wtsapi32\WTSRegisterSessionNotification", "Ptr", A_ScriptHwnd, "UInt", 0) ; NOTIFY_FOR_THIS_SESSION = 0
   ; Message Hanlders are closures
   OnMessage(WM_POWERBROADCAST, cbPowerChangeEvent)
   OnMessage(WM_WTSSESSION_CHANGE, cbSessionChange)
   OnMessage(WM_DISPLAYCHANGE, cbDisplayChange)   ; WM_DISPLAYCHANGE

   /*==============================================================================
   Suspend resume messages, 7 means the user also initiated it vs system background
   AHK2 WM_BROADCAST:18, lparam=0, msg=536 PBT_APMRESUMEAUTOMATIC
   AHK2 WM_BROADCAST:7, lparam=0, msg=536 PBT_APMRESUMESUSPEND
   ================================================================================*/
   OnExit UnRegisterPower
   Return
   ; Session Change lock/unlock
   cbSessionChange(wParam, lParam, msg, hwnd) {
      Static WTS_SESSION_LOCK := 0x7, WTS_SESSION_UNLOCK := 0x8
      If (wParam = WTS_SESSION_LOCK) {
         SetTimer(Weather.cbUpdateData, 0)
      } Else If (wParam = WTS_SESSION_UNLOCK) {
         OutputDebug("WeatherWidget: Session Change")
         SetTimer(Weather.cbUpdateData, -5000)
      }
   }
   ; Resume from sleep
   cbPowerChangeEvent(wParam, lParam, Msg, hWnd) {
      Static PBT_APMRESUMESUSPEND := 0x7
      Switch wParam {
         Case PBT_APMRESUMESUSPEND :
            SetTimer(Weather.cbUpdateData, -10000)
            OutputDebug("WeatherWidget: Resume from Suspension")
         Default :
      }
   }
   /**
    * Hack if the GUI was on a disabled monitor, the composting will not
    * update the window itself
    * wParam = new bit depth
    * lParam is resolution (low word is width, high word is height)
    */
   cbDisplayChange(wParam, lParam, msg, hwnd) {
      OutputDebug("Redrawing Window due to refresh:")
      SetTimer(RefreshGui, -4000)   ; let the display stack settle first
      Return
      Static RefreshGui() {
         ; RDW_INVALIDATE|RDW_ERASE|RDW_FRAME|RDW_ALLCHILDREN|RDW_UPDATENOW
         Weather.Gui.Opt("-E0x02000000")
         Weather.Gui.Opt("+E0x02000000")
         DllCall("RedrawWindow", "Ptr", Weather.Gui.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x585)
      }
   }
   ;----------------------------------------------------------------------
   ; On exit, unregister handlers
   ;----------------------------------------------------------------------
   UnRegisterPower(ExitReason, ExitCode) {
      DllCall("Wtsapi32.dll\WTSUnRegisterSessionNotification", "ptr", A_ScriptHwnd)
      If (hwndNotification)
         DllCall("UnregisterSuspendResumeNotification", "ptr", hwndNotification)
   }
}

class MenuDarkMode {
   static Enable(mode := 2) {   ; 0 Default, 1 AllowDark (follows system), 2 ForceDark, 3 ForceLight
      static hMod := DllCall("LoadLibrary", "Str", "uxtheme", "Ptr")
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 135, "Ptr"), "Int", mode)
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 136, "Ptr"))
   }
}
; Start things up here
MenuDarkMode.Enable(1)   ; use 1 to follow the system theme instead of forcing dark
Weather.Init()
SetupEventMonitoring()

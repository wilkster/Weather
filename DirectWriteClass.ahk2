; Tom Wilkason with help from claude
; Direct Write handler for text widgets
#Requires AutoHotkey v2.1-
#DllLoad "ole32.dll"
#DllLoad "d2d1.dll"
#DllLoad "dwrite.dll"
struct D2D1_COLOR_F {
   r: Float32
   g: Float32
   b: Float32
   a: Float32
}
struct D2D1_RECT_F {
   left  : Float32
   top   : Float32
   right : Float32
   bottom: Float32
}
struct D2D1_SIZE_U {
   width : UInt32
   height: UInt32
}
struct D2D1_PIXEL_FORMAT {
   format   : UInt32
   alphaMode: UInt32
}
struct D2D1_RENDER_TARGET_PROPERTIES {
   renderType : UInt32
   pixelFormat: D2D1_PIXEL_FORMAT
   dpiX       : Float32
   dpiY       : Float32
   usage      : UInt32
   minLevel   : UInt32
}
struct D2D1_HWND_RENDER_TARGET_PROPERTIES {
   hwnd          : IntPtr
   pixelSize     : D2D1_SIZE_U
   presentOptions: UInt32
}
struct D2DT_RECT {
   left  : Int32
   top   : Int32
   right : Int32
   bottom: Int32
}
/**
 * Renders color text (emoji included) into a Text control using Direct2D / DirectWrite.
 * The background is always transparent: each repaint is filled with the GUI's current BackColor.
 * Create instances with Gui.AddD2DText, which stores the instance on the control (ctrl.D2D),
 * so you only need to keep the return value if you want to call methods on it later.
 * Constructing D2DText directly on your own control requires keeping a reference to it.
 * @example
 * d := myGui.AddD2DText("w400 r7 cA6ADC8", "Hello 😊")
 * d.SetAlign("Center")
 * d.Text := "Updated"
 */
class D2DText {
   /** ID2D1Factory pointer, shared by all instances. */
   static _d2d := 0
   /** IDWriteFactory pointer, shared by all instances. */
   static _dw  := 0

   /** Per-instance COM pointers: render target, brush, text format. */
   _rt := 0, _brush := 0, _fmt := 0
   /** Handlers for WM_PAINT / WM_ERASEBKGND, kept so they can be unhooked. */
   _paintFn := 0, _eraseFn := 0
   /** Uniform line height and baseline in DIPs; 0 = not set (see SetLineHeight). */
   _lineH := 0, _lineBase := 0, _retry := 0, _tabEm := 0
   /** Window DPI at target creation, and 96 / DPI (pixels -> DIPs). */
   _dpi := 96, sf := 1, _pw := 0, _ph := 0
   _dpiFn := 0

   /**
    * Creates the DirectWrite format and Direct2D render target for a Text control and draws the text.
    * Prefer Gui.AddD2DText, which also creates the control and fills in colors and font from the GUI.
    * Colors are 0xRRGGBB. The render target uses the window's DPI, so size and pad are DPI-independent.
    * @param {Gui.Text} ctrl The Text control to render into.
    * @param {String} [text=""] Initial text.
    * @param {String} [font="Segoe UI Emoji"] Font family name.
    * @param {Number} [size=10] Font size in points (same unit as AHK's s10 option).
    * @param {Integer|String} [fg=0xFFFFFF] Text color, 0xRRGGBB or a "RRGGBB" hex string.
    * @param {Integer} [weight=400] Font weight (400 = normal, 700 = bold).
    * @param {Number} [pad=0] Padding between control edge and text, in DIPs (1/96 inch).
    * @throws {OSError} If a Direct2D or DirectWrite call fails.
    */
   __New(ctrl, text := "", font := "Segoe UI Emoji", size := 10, fg := 0xFFFFFF, weight := 400, pad := 0) {
      D2DText._Init()
      this._ctrl   := ctrl
      this.sf      := 96 / DllCall("GetDpiForWindow", "Ptr", this._ctrl.Hwnd, "UInt")
      this._text   := text
      this._font   := font
      this._size   := size
      this._weight := weight || 400      ; 400 = normal; 0 or "" -> normal
      this._fg     := D2DText._ToRGB(fg)
      this._pad    := pad
      this._align  := 0      ; 0 = left, 1 = right, 2 = center
      this._wrap   := true
      this._rt     := this._brush := this._fmt := 0
      this._CreateFormat()
      this._CreateTarget()
      this._HookPaint()
      this.Draw()
   }

   /**
    * Returns the GUI's current BackColor as 0xRRGGBB, or the system dialog color if the GUI has none.
    * Read on every paint, which is what makes the control look transparent.
    * @param {Gui} g The GUI.
    * @returns {Integer}
    */
   static _GuiBack(g) {
      if (c := g.BackColor) != ""
         return D2DText._ToRGB(c)
      return D2DText._SysColor(15)                               ; COLOR_3DFACE
   }

   /** Unhooks the paint handlers and releases the render target, brush and text format. */
   __Delete() {
      this._UnhookPaint()
      this._FreeTarget()
      if this._fmt
         ObjRelease(this._fmt), this._fmt := 0
   }

   /** Releases the render target and brush (the device-dependent resources). */
   _FreeTarget() {
      if this._brush
         ObjRelease(this._brush), this._brush := 0
      if this._rt
         ObjRelease(this._rt), this._rt := 0
   }

   /**
    * Creates a Text control and attaches a D2DText renderer to it. Called through Gui.AddD2DText.
    * The background is always transparent (the GUI's BackColor shows through); a BackgroundXXXXXX option is ignored.
    * Colors are 0xRRGGBB. Anything left blank is taken from the GUI or the options string:
    *   fg   -> "cXXXXXX" in options, else the system text color
    *   font/size/weight -> the GUI's current font (read back from the new control)
    * @param {Gui} g The GUI that owns the control.
    * @param {String} [options=""] Same options as Gui.AddText (w, r, x, y, c, BackgroundXXXXXX ...).
    * @param {String} [text=""] Initial text.
    * @param {String} [font=""] Font family. Blank = GUI's current font.
    * @param {Number|String} [size=""] Size in points. Blank = GUI's current font size.
    * @param {Integer|String} [fg=""] Text color, 0xRRGGBB. Blank = see above.
    * @param {Integer|String} [weight=""] Font weight (400 = normal, 700 = bold). Blank = GUI's current font weight.
    * @param {Number} [pad=0] Padding in DIPs (1/96 inch).
    * @returns {D2DText} The renderer. The control is available as .Ctrl, and the renderer as ctrl.D2D.
    */
   static Create(g, options := "", text := "", font := "", size := "", fg := "", weight := "", pad := 0) {
      ; The native control is created with the text so r/w auto-sizing works and screen readers still see it.
      ctrl := g.AddText(options, text)

      ; Font defaults: read the LOGFONT the control inherited from the GUI
      if font = "" || size = "" || weight = "" {
         lf := Buffer(92, 0)
         hFont := SendMessage(0x31, 0, 0, ctrl)                  ; WM_GETFONT
         if hFont && DllCall("GetObject", "Ptr", hFont, "Int", 92, "Ptr", lf) {
            dpi := DllCall("GetDpiForWindow", "Ptr", ctrl.Hwnd, "UInt")
            if font = ""
               font := StrGet(lf.Ptr + 28, 32)                   ; lfFaceName
            if size = ""
               size := Round(-NumGet(lf, 0, "Int") * 72 / dpi, 1) ; lfHeight (px) -> points
            if weight = ""
               weight := NumGet(lf, 16, "Int")                   ; lfWeight
         }
         if font = ""
            font := "Segoe UI"
         if size = ""
            size := 9
         if !weight                                              ; "" or 0 -> normal
            weight := 400
      }

      ; Text color: option > system text color (SetFont colors can't be read back)
      if fg = "" {
         if RegExMatch(options, "i)(?:^|\s)c([0-9a-f]{6})(?=\s|$)", &m)
            fg := Integer("0x" m[1])
         else
            fg := D2DText._SysColor(8)                           ; COLOR_WINDOWTEXT
      }

      inst := this(ctrl, text, font, size, fg, weight, pad)      ; `this` is the class: D2DText, or a subclass such as D2DGrid
      ctrl.D2D := inst           ; keeps the instance alive as long as the control exists

      ; Alignment: AddText applies Left/Center/Right to the native control, but D2D draws the text itself
      if RegExMatch(options, "i)(?:^|\s)(center|right)(?=\s|$)", &a) {
         inst._align := a[1] = "Center" ? 2 : 1          ; 0 left, 1 right, 2 center
         ComCall(3, inst._fmt, "Int", inst._align)       ; SetTextAlignment
      }     
      return inst      
   }
   /** Releases the COM resources and breaks the ctrl <-> instance cycle. Call before destroying the GUI. */
   Dispose() {
      this.__Delete()
      if this._ctrl {
         try this._ctrl.DeleteProp("D2D")
         this._ctrl := ""
      }
   }

   /** Disposes every D2DText control in a GUI. */
   static DisposeAll(g) {
      for hwnd, ctrl in g
         if ctrl.HasProp("D2D")
            ctrl.D2D.Dispose()
   }
   /** The Text control this instance draws into. */
   Ctrl => this._ctrl

   /**
    * Returns a system color as 0xRRGGBB.
    * @param {Integer} idx GetSysColor index.
    * @returns {Integer}
    */
   static _SysColor(idx) {
      c := DllCall("GetSysColor", "Int", idx, "UInt")            ; COLORREF is 0x00BBGGRR
      return (c & 0xFF) << 16 | (c >> 8 & 0xFF) << 8 | (c >> 16 & 0xFF)
   }

   /**
    * The displayed text. Assigning a new value repaints the control.
    * @type {String}
    */
   Text {
      get => this._text
      set {
         this._text := value
         this.Refresh()
      }
   }

   /**
    * Changes the font and repaints. Alignment, wrap and line height are preserved.
    * @param {String} font Font family name.
    * @param {Number} size Font size in points.
    * @throws {OSError} If the text format cannot be created.
    */
   SetFont(font, size) {
      this._font := font
      this._size := size
      if this._fmt
         ObjRelease(this._fmt), this._fmt := 0
      this._CreateFormat()
      this.Refresh()
   }

   /**
    * Changes the text color and repaints.
    * @param {Integer|String} fg Text color, 0xRRGGBB (or a "RRGGBB" hex string).
    */
   SetColor(fg) {
      this._fg := D2DText._ToRGB(fg)
      if this._brush
         ComCall(8, this._brush, "Ptr", D2DText._Color(this._fg), "Int")   ; ID2D1SolidColorBrush::SetColor (void)
      this.Refresh()
   }

   /**
    * Normalizes a color to an integer 0xRRGGBB.
    * @param {Integer|String} c An integer, or a hex string such as "A6ADC8" or "0xA6ADC8".
    * @returns {Integer}
    */
   static _ToRGB(c) {
      if c is Integer
         return c
      c := String(c)
      return Integer(SubStr(c, 1, 2) = "0x" ? c : "0x" c)
   }

   /**
    * Moves/resizes the underlying control, then resizes the render target to match.
    * @param args Same arguments as Gui.Control.Move.
    */
   Move(args*) {
      this._ctrl.Move(args*)
      this.Resize()
   }

   /**
    * Sets horizontal text alignment and repaints.
    * @param {String} [align="Left"] "Left", "Center" or "Right".
    */
   SetAlign(align := "Left") {
      this._align := align = "Center" ? 2 : align = "Right" ? 1 : 0
      ComCall(3, this._fmt, "Int", this._align)                  ; SetTextAlignment
      this.Refresh()
   }

   /**
    * Turns word wrapping on or off and repaints.
    * @param {Boolean} [on=true] True to wrap at the control edge, false for no wrapping.
    */
   SetWrap(on := true) {
      this._wrap := on
      ComCall(5, this._fmt, "Int", on ? 0 : 1)                   ; SetWordWrapping
      this.Refresh()
   }
   /**
    * Sets the tab stop width, so text after a tab character lines up in columns with proportional fonts.
    * @param {Number} em Tab width in multiples of the font size (default 3.5 fits a 3-letter day name plus a gap).
    */
   SetTabStop(em := 3.5) {
      this._tabEm := em
      ComCall(8, this._fmt, "Float", em * this._size * 96 / 72, "Int")   ; SetIncrementalTabStop (DIPs)
      this.Refresh()
   }
   Resize() => this.Refresh()
   /** Invalidates the control and repaints it now through the WM_PAINT path (_OnPaint). Use this instead of Draw for updates. */
   Refresh() {
      DllCall("InvalidateRect", "Ptr", this._ctrl.Hwnd, "Ptr", 0, "Int", 0)
      DllCall("UpdateWindow", "Ptr", this._ctrl.Hwnd)
      ; OutputDebug("Refreshing " this._ctrl.Hwnd)
   }
   /**
    * Repaints every D2DText control in a GUI.
    * @param {Gui} g The GUI to refresh.
    */
   static RefreshAll(g) {
      for hwnd, ctrl in g
         if ctrl.HasProp("D2D")
            ctrl.D2D.Refresh()
   }
   /**
    * Returns if the window is occluded or now
    */
   IsOccluded() {
      Return (ComCall(57, this._rt, "Int") & 1)
   }
   /**
    * Paints immediately: fills with the GUI's BackColor (transparent look) and draws the text. Called from _OnPaint and __New;
    * use Refresh() for everything else. If the device was lost (D2DERR_RECREATE_TARGET),
    * the render target is rebuilt and drawing is retried.
    */
   Draw() {
      ; this._ClientSize(&w, &h)
      this._SyncTarget()
      w := this._pw, h := this._ph
      rt := this._rt

      ; D2D1_WINDOW_STATE_OCCLUDED = 1. Nothing is presented while occluded (lock screen, display off),
      ; and BeginPaint/EndPaint already validated the region, so no further WM_PAINT will come.
      st := ComCall(57, rt, "Int")                               ; CheckWindowState
      If (st & 1) {
         OutputDebug("D2DText occluded, retry " this._retry)
         this._RetryLater()
         Return
      }
      this._retry := 0

      ComCall(48, rt, "Int")                                     ; BeginDraw (void)
      ComCall(47, rt, "Ptr", D2DText._Color(D2DText._GuiBack(this._ctrl.Gui)), "Int")   ; Clear (void) with the GUI's current BackColor

      this._Render(rt, w, h)

      ; "Int" return type so D2DERR_RECREATE_TARGET is returned instead of thrown
      hr := ComCall(49, rt, "Ptr", 0, "Ptr", 0, "Int")           ; EndDraw
      if (hr & 0xFFFFFFFF) = 0x8899000C {   ; D2DERR_RECREATE_TARGET
         this._FreeTarget()
         this._CreateTarget()
         this.Draw()
      } else if hr
         OutputDebug "EndDraw hr=" Format("{:#x}", hr & 0xFFFFFFFF)
   }
   /**
    * Draws the control's content between BeginDraw and EndDraw. Subclasses override this (see D2DGrid).
    * @param {Integer} rt ID2D1HwndRenderTarget pointer.
    * @param {Integer} w Client width in physical pixels.
    * @param {Integer} h Client height in physical pixels.
    */
   _Render(rt, w, h) {
      Static rc := D2D1_RECT_F()
      p := this._pad
      rc.left := p, rc.top := p
      rc.right := w * this.sf - p, rc.bottom := h * this.sf - p
      ; 4 = D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT
      ComCall(27, rt
         , "Str", this._text
         , "UInt", StrLen(this._text)
         , "Ptr", this._fmt
         , "Ptr", rc
         , "Ptr", this._brush
         , "Int", 4
         , "Int", 0
         , "Int")   ; DrawText (void)
   }
   /** Window was occluded, so try again shortly. Gives up after ~10 s or if the control is hidden (Show repaints it). 
    *  This may happen if the windows is on an offscreen monitor
   */
   _RetryLater() {
      If (this._retry++ >= 3 || !DllCall("IsWindowVisible", "Ptr", this._ctrl.Hwnd))
         Return
      SetTimer(this._RetryDraw.Bind(this), -500)
   }
   _RetryDraw() {
      If (this._ctrl && this._rt)   ; may have been disposed meanwhile
         this.Refresh()
   }
   /**
    * Creates the HWND render target at the window's DPI (physical-pixel size from GetClientRect) and the solid color brush.
    * @throws {OSError} If the render target or brush cannot be created.
    */
   _CreateTarget() {
      this._ClientSize(&w, &h)
      this._pw := w, this._ph := h
      this._dpi := DllCall("GetDpiForWindow", "Ptr", this._ctrl.Hwnd, "UInt")
      this.sf := 96 / this._dpi

      rtp := D2D1_RENDER_TARGET_PROPERTIES()
      rtp.dpiX := rtp.dpiY := this._dpi

      hp := D2D1_HWND_RENDER_TARGET_PROPERTIES()
      hp.hwnd := this._ctrl.Hwnd
      hp.pixelSize.width := w
      hp.pixelSize.height := h

      rt := 0
      ComCall(14, D2DText._d2d, "Ptr", rtp, "Ptr", hp, "Ptr*", &rt)       ; CreateHwndRenderTarget
      this._rt := rt

      br := 0
      ComCall(8, rt, "Ptr", D2DText._Color(this._fg), "Ptr", 0, "Ptr*", &br)   ; CreateSolidColorBrush
      this._brush := br
   }
   /** Brings the render target in line with the window's current DPI and client size. Called at the start of Draw. */
   _SyncTarget() {
      dpi := DllCall("GetDpiForWindow", "Ptr", this._ctrl.Hwnd, "UInt")
      this._ClientSize(&w, &h)
      if dpi = this._dpi && w = this._pw && h = this._ph
         return
      if dpi != this._dpi {
         this._dpi := dpi, this.sf := 96 / dpi
         ComCall(51, this._rt, "Float", dpi, "Float", dpi, "Int")   ; ID2D1RenderTarget::SetDpi (void)
      }
      sz := D2D1_SIZE_U()
      sz.width := w, sz.height := h
      this._pw := w, this._ph := h
      ComCall(58, this._rt, "Ptr", sz)                              ; ID2D1HwndRenderTarget::Resize
   }
   /**
    * Creates the IDWriteTextFormat from the current font and size (points, converted to DIPs),
    * then applies the stored alignment, wrap and line height.
    * @throws {OSError} If the text format cannot be created.
    */
   _CreateFormat() {
      fmt := 0
      ComCall(15, D2DText._dw
         , "WStr", this._font
         , "Ptr", 0
         , "Int", this._weight
         , "Int", 0
         , "Int", 5
         , "Float", this._size * 96 / 72
         , "WStr", "en-us"
         , "Ptr*", &fmt
      )                        ; CreateTextFormat
      this._fmt := fmt
      ComCall(3, fmt, "Int", this._align)                        ; SetTextAlignment
      ComCall(5, fmt, "Int", this._wrap ? 0 : 1)                 ; SetWordWrapping
      if this._tabEm
         ComCall(8, fmt, "Float", this._tabEm * this._size * 96 / 72, "Int")   ; SetIncrementalTabStop
      this._ApplyLineHeight()
   }

   /**
    * Creates the shared Direct2D and DirectWrite factories once. The DLLs stay loaded via #DllLoad.
    * These are plain DLL exports, not COM methods, so they use DllCall.
    * @throws {OSError} If either factory cannot be created.
    */
   static _Init() {
      if this._d2d
         return

      iid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "Str", "{06152247-6f50-465a-9245-118bfd3b6007}", "Ptr", iid)
      f := 0
      hr := DllCall("d2d1\D2D1CreateFactory", "Int", 0, "Ptr", iid, "Ptr", 0, "Ptr*", &f, "Int")
      if hr || !f
         throw OSError(hr, , "D2D1CreateFactory")
      this._d2d := f

      iid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "Str", "{b859ee5a-d838-4b5b-a2e8-1adc7d93db48}", "Ptr", iid)
      d := 0
      hr := DllCall("dwrite\DWriteCreateFactory", "Int", 0, "Ptr", iid, "Ptr*", &d, "Int")
      if hr || !d
         throw OSError(hr, , "DWriteCreateFactory")
      this._dw := d
   }

   /**
    * Builds a D2D1_COLOR_F (4 floats, RGBA) from a 0xRRGGBB value.
    * @param {Integer|String} rgb Color, 0xRRGGBB or a "RRGGBB" hex string.
    * @param {Number} [a=1.0] Alpha, 0.0 to 1.0.
    * @returns {Buffer} 16-byte D2D1_COLOR_F structure.
    */
   static _Color(rgb, a := 1.0) {
      rgb := D2DText._ToRGB(rgb)
      c := D2D1_COLOR_F()
      c.r := (rgb >> 16 & 0xFF) / 255
      c.g := (rgb >> 8 & 0xFF) / 255
      c.b := (rgb & 0xFF) / 255
      c.a := a
      return c
   }

   /**
    * Forces a fixed line height so fallback fonts (e.g. emoji) can't make lines taller.
    * @param {Number} [px] Line height in physical pixels. Omit to match the control's own GDI font
    *                      (tmHeight + tmExternalLeading), so r7 / r1 sizing lines up exactly.
    */
   SetLineHeight(px?) {
      if !IsSet(px) {
         hdc := DllCall("GetDC", "Ptr", this._ctrl.Hwnd, "Ptr")
         hFont := SendMessage(0x31, 0, 0, this._ctrl)            ; WM_GETFONT
         old := DllCall("SelectObject", "Ptr", hdc, "Ptr", hFont, "Ptr")
         tm := Buffer(80, 0)
         DllCall("GetTextMetrics", "Ptr", hdc, "Ptr", tm)
         DllCall("SelectObject", "Ptr", hdc, "Ptr", old)
         DllCall("ReleaseDC", "Ptr", this._ctrl.Hwnd, "Ptr", hdc)
         px := NumGet(tm, 0, "Int") + NumGet(tm, 16, "Int")      ; tmHeight + tmExternalLeading
         asc := NumGet(tm, 4, "Int")                             ; tmAscent
      } else
         asc := px * 0.8
      this._lineH := px * this.sf                                ; pixels -> DIPs
      this._lineBase := asc * this.sf
      this._ApplyLineHeight()
      this.Refresh()
   }

   /** Applies the stored uniform line height to the current text format, if one was set. */
   _ApplyLineHeight() {
      if this._lineH
         ComCall(10, this._fmt, "Int", 1, "Float", this._lineH, "Float", this._lineBase)   ; SetLineSpacing, UNIFORM
   }

   /**
    * Hooks WM_PAINT and WM_ERASEBKGND on the control so Direct2D owns its painting.
    * The paint handler captures only the instance's address (ObjPtr), not a reference, so the
    * control's handler list doesn't keep the instance alive and __Delete can run.
    */
   _HookPaint() {
      this._dpiFn := (*) => ObjFromPtrAddRef(ptr).Refresh()
      this._ctrl.OnMessage(0x02E3, this._dpiFn)     ; WM_DPICHANGED_AFTERPARENT
      ptr := ObjPtr(this)
      this._paintFn := (*) => ObjFromPtrAddRef(ptr)._OnPaint()
      this._eraseFn := (*) => 1
      this._ctrl.OnMessage(0x000F, this._paintFn)   ; WM_PAINT
      this._ctrl.OnMessage(0x0014, this._eraseFn)   ; WM_ERASEBKGND
   }

   /**
    * WM_PAINT handler: BeginPaint/EndPaint consume the update region while Draw() paints.
    * Returns 0 to skip the static control's own painting.
    */
   _OnPaint() {
      Critical()
      ps := Buffer(A_PtrSize = 8 ? 72 : 64, 0)                     ; PAINTSTRUCT
      DllCall("BeginPaint", "Ptr", this._ctrl.Hwnd, "Ptr", ps, "Ptr")
      Try this.Draw()
      Finally DllCall("EndPaint", "Ptr", this._ctrl.Hwnd, "Ptr", ps)
      ; OutputDebug("WeatherWidget OnPaint Received: " this._ctrl.Hwnd)
      return 0
   }

   /** Removes the paint hooks (safe if the control is already destroyed). */
   _UnhookPaint() {
      if !this._paintFn
         return
      try this._ctrl.OnMessage(0x02E3, this._dpiFn, 0)
      this._dpiFn := 0         
      try this._ctrl.OnMessage(0x000F, this._paintFn, 0)
      try this._ctrl.OnMessage(0x0014, this._eraseFn, 0)
      this._paintFn := this._eraseFn := 0
   }

   /**
    * Gets the control's client size in physical pixels (GetPos reports scaled units under +DPIScale).
    * @param {VarRef} w Receives the width in pixels.
    * @param {VarRef} h Receives the height in pixels.
    */
   _ClientSize(&w, &h) {
      DllCall("GetClientRect", "Ptr", this._ctrl.Hwnd, D2DT_RECT, rc:= D2DT_RECT())
      w := rc.right, h := rc.bottom
   }

   /**
    * Gets the control's position and size in the GUI's scaled units (not physical pixels under +DPIScale).
    * @param {VarRef} [X] Receives the x position.
    * @param {VarRef} [Y] Receives the y position.
    * @param {VarRef} [W] Receives the width.
    * @param {VarRef} [H] Receives the height.
    */
   GetPos(&X?, &Y?, &W?, &H?) {
      this._ctrl.GetPos(&X, &Y, &W, &H)
   }
}

/**
 * Draws a table of colored text/emoji cells into one control. Each column has an alignment, a fixed or auto width
 * (auto = measured with DirectWrite) and an optional gap after it, so emoji and proportional fonts line up without
 * padding tricks. Rows are one uniform line high (SetLineHeight is applied automatically; call it again to override).
 * Widths and gaps are in DIPs (1/96 inch), like pad. Wrapping is off.
 *   Column: {al: "Left"|"Right"|"Center", w: DIPs | "auto", gap: DIPs after this column (default: SetGap, 8)}
 *   Cell:   a string, or {t: text, c: 0xRRGGBB, al: alignment override, span: number of columns to cover}
 * A cell with span > 1 is aligned within the combined width of the columns it covers and does not affect auto
 * widths, which makes it suitable for headers.
 * @example
 * g := myGui.AddD2DGrid("w300 cD7DCFF")
 * g.SetColumns([{al: "Left", w: "auto"}, {al: "Right", w: "auto", gap: 3}, {al: "Left", w: "auto"}])
 * g.SetRows([[{t: "Day / Temp", span: 3, al: "Center"}], ["Sat", "26°", "⛅"], ["Sun", {t: "24°", c: 0xFF8080}, "☃"]])
 * g.Fit()
 */
class D2DGrid extends D2DText {
   _cols := [], _rows := [], _gap := 8, _dirty := true, _items := []
   _justify := false, _lastW := 0, _natW := 0
   __New(args*) {
      super.__New(args*)
      this.SetWrap(false)
      this.SetLineHeight()
   }
   __Delete() {
      this._FreeLayouts()
      super.__Delete()
   }
/** Natural width in DIPs of pad + columns + inner gaps */
   ContentW {
      get {
         If this._dirty
            this._Layout()
         Return this._natW
      }
   }
   _FreeLayouts() {
      for items in this._items
         for it in items
            ObjRelease(it.p)
      this._items := []
   }

   /** Stretch the column gaps so the columns span the control's full width (only when the content is narrower). */
   SetJustify(on := true) {
      this._justify := on
      this._dirty := true
      this.Refresh()
   }
   ; Cached layouts copy the shared format's settings when created, so changing them invalidates the cache
   SetLineHeight(px?) {
      this._dirty := true
      super.SetLineHeight(px?)
   }
   SetAlign(align := "Left") {
      this._dirty := true
      super.SetAlign(align)
   }
   SetWrap(on := true) {
      this._dirty := true
      super.SetWrap(on)
   }
   SetTabStop(em := 3.5) {
      this._dirty := true
      super.SetTabStop(em)
   }
   /**
    * Defines the columns.
    * @param {Array} cols Objects {al: "Left"|"Right"|"Center", w: DIPs | "auto", gap: DIPs after the column}.
    */
   SetColumns(cols) {
      for c in cols
         c.a := D2DGrid._Al(c.HasProp("al") ? c.al : "Left")
      this._cols := cols
      this._dirty := true
      this.Refresh()
   }
   /**
    * Sets the rows and repaints.
    * @param {Array} rows Array of arrays of cells: a string, or {t: text, c: 0xRRGGBB, al: alignment, span: columns}.
    */
   SetRows(rows) {
      this._rows := rows
      this._dirty := true
      this.Refresh()
   }

   /** Sets the default horizontal gap after a column (columns without their own gap), in DIPs. */
   SetGap(dips) {
      this._gap := dips
      this._dirty := true
      this.Refresh()
   }

   /** Changes the font; column widths are re-measured. */
   SetFont(font, size) {
      this._dirty := true
      super.SetFont(font, size)
   }

   /** Sizes the control's height to the row count. Assumes +DPIScale (GUI units are DIPs). */
   Fit() => this.Move(, , , Ceil(this._rows.Length * this._lineH + 2 * this._pad))

   static _T(cell)    => String(IsObject(cell) ? cell.t : cell)
   static _Span(cell) => Max(1, IsObject(cell) && cell.HasProp("span") ? cell.span : 1)
   static _Al(al)     => al = "Center" ? 2 : al = "Right" ? 1 : 0           ; DWRITE_TEXT_ALIGNMENT: leading, trailing, centered

   /** Creates a layout for s from the shared format; &w receives its natural width in DIPs. The caller owns the layout. */
   _NewLayout(s, &w) {
      lay := 0
      ComCall(18, D2DText._dw, "WStr", s, "UInt", StrLen(s), "Ptr", this._fmt
         , "Float", 10000, "Float", 10000, "Ptr*", &lay)        ; CreateTextLayout
      m := Buffer(40, 0)
      ComCall(60, lay, "Ptr", m)                                ; GetMetrics (DWRITE_TEXT_METRICS)
      w := NumGet(m, 8, "Float")
      return lay
   }
   /** Computes each column's x and width. Run lazily from _Render when columns, rows or font changed. */
   /** Builds one layout per non-empty cell, sizes auto columns, then fits each layout to its cell box. */
   /**
    * Builds one layout per non-empty cell, sizes auto columns, positions the columns (stretching the gaps to fill dw
    * when SetJustify is on and the content is narrower), then fits each layout to its cell box.
    * Run lazily from _Render when columns, rows, font or (with justify) the control width changed.
    * @param {Number} dw Control width in DIPs; 0 = natural width (no stretching).
    */
   _Layout(dw := 0) {
      prev := Critical()
      Try {
         this._FreeLayouts()
         this._lastW := dw
         cols := this._cols, nc := cols.Length
         For c in cols
            c.cw := (c.HasProp("w") && (c.w is Number)) ? c.w : 0
         ; pass 1: create layouts, auto columns take the widest single-column cell
         For row in this._rows {
            items := [], ci := 1
            For cell in row {
               If ci > nc
                  Break
               span := Min(D2DGrid._Span(cell), nc - ci + 1)
               t := D2DGrid._T(cell)
               If t != "" {
                  c := cols[ci]
                  lay := this._NewLayout(t, &tw)
                  If span = 1 && !(c.HasProp("w") && (c.w is Number))
                     c.cw := Max(c.cw, tw)
                  items.Push({ p: lay, ci: ci, span: span, tw: tw
                     , al: IsObject(cell) && cell.HasProp("al") ? D2DGrid._Al(cell.al) : c.a
                     , c: IsObject(cell) && cell.HasProp("c") ? D2DText._ToRGB(cell.c) : "" })
               }
               ci += span
            }
            this._items.Push(items)
         }
         ; span cells (headers): if the text is wider than the columns and gaps it covers,
         ; widen the last covered auto column so the text can't overflow the grid's right edge
         For items in this._items
            For it in items {
               If it.span < 2
                  Continue
               e := cols[it.ci + it.span - 1]
               If e.HasProp("w") && (e.w is Number)
                  Continue                                           ; fixed-width column: leave it alone
               cov := 0
               Loop it.span {
                  c := cols[it.ci + A_Index - 1]
                  cov += c.cw
                  If A_Index < it.span
                     cov += c.HasProp("gap") ? c.gap : this._gap
               }
               If it.tw > cov
                  e.cw += it.tw - cov
            }
         ; column positions (natural)
         x := this._pad
         For c in cols {
            c.x := x
            x += c.cw + (c.HasProp("gap") ? c.gap : this._gap)
         }
         this._natW := nc ? cols[nc].x + cols[nc].cw + this._pad : 2 * this._pad   ; natural width, before any stretching
         ; stretch: spread the surplus over the inner gaps in proportion to their size, so tight pairs stay tight
         If this._justify && nc > 1 && dw > this._natW {
            extra := dw - this._natW
            tot := 0
            For i, c in cols
               If i < nc
                  tot += c.HasProp("gap") ? c.gap : this._gap
            acc := 0
            For i, c in cols {
               c.x += acc
               If i < nc {
                  g := c.HasProp("gap") ? c.gap : this._gap
                  acc += extra * (tot > 0 ? g / tot : 1 / (nc - 1))
               }
            }
         }
         ; pass 2: fit each layout to the box of the columns it covers, and set its alignment
         rh := this._lineH
         For items in this._items
            For it in items {
               c := cols[it.ci], e := cols[it.ci + it.span - 1]
               it.x := c.x
               ComCall(28, it.p, "Float", e.x + e.cw - c.x)         ; SetMaxWidth
               ComCall(29, it.p, "Float", rh)                       ; SetMaxHeight
               If it.al != this._align
                  ComCall(3, it.p, "Int", it.al)                    ; SetTextAlignment (the layout was created with this._align)
            }
         this._dirty := false
      } Finally {
         ; Restore what ever critical we had before
         Critical(prev)
      }
   }
   /**
    * Draw the cached text layouts for every row into the render target, re-laying them out first
    * when the content is dirty or (when justified) the client width has changed.
    * Items with their own color are drawn with the shared brush temporarily switched to that color;
    * the brush is restored to the default foreground color afterwards.
    * @param {Integer} rt ID2D1RenderTarget interface pointer to draw into (between BeginDraw/EndDraw)
    * @param {Integer} w Client width in physical pixels (scaled by this.sf to DIPs)
    * @param {Integer} h Client height in physical pixels (unused)
    * @returns {unset?}
    */
   _Render(rt, w, h) {
      static pt := Buffer(8)
      dw := w * this.sf                                          ; client width in DIPs (w is physical pixels)
      if this._dirty || (this._justify && dw != this._lastW)
         this._Layout(dw)
      rh := this._lineH, clr := this._fg
      for r, items in this._items {
         y := this._pad + (r - 1) * rh
         for it in items {
            want := it.c = "" ? this._fg : it.c
            if want != clr
               ComCall(8, this._brush, "Ptr", D2DText._Color(clr := want), "Int")   ; SetColor
            NumPut("Float", it.x, "Float", y, pt)                                    ; D2D1_POINT_2F is passed by value
            ComCall(28, rt, "Int64", NumGet(pt, "Int64"), "Ptr", it.p, "Ptr", this._brush, "Int", 4, "Int")   ; DrawTextLayout (void)
         }
      }
      if clr != this._fg
         ComCall(8, this._brush, "Ptr", D2DText._Color(this._fg), "Int")
   }  
}
;@reference DirectWriteClass.d.ahk
Gui.Prototype.DefineProp("AddD2DText", {Call: (g, args*) => D2DText.Create(g, args*)})
Gui.Prototype.DefineProp("AddD2DGrid", {Call: (g, args*) => D2DGrid.Create(g, args*)})

/*
Notes:
- The background is always "transparent": every paint is filled with the GUI's current BackColor, so a later
  oGui.BackColor change is picked up automatically. It does not show through to controls underneath.
- Text color, font, size and weight are captured when the control is created. A later oGui.SetFont call
  doesn't affect existing D2D controls; use SetColor / SetFont on the instance.
- The text color given as an option (cXXXXXX) must be 6-digit hex. Named colors are not parsed and fall
  back to the system text color; a named GUI BackColor makes AddD2DText throw.
- AHK can't read back the color set by oGui.SetFont("cXXXXXX"), so pass cXXXXXX in the options or fg.
- Font weight is read from the GUI font (or pass weight explicitly: 400 normal, 700 bold). Italic is not supported.
- Pass the family name only in font ("Consolas", not "Consolas bold"); use weight for bold.
- pad defaults to 0 so the text lines up with a native Text control.
- The instance and its control reference each other (ctrl.D2D), so __Delete runs at script exit,
  not when the GUI is destroyed.
- Emoji fallback fonts can increase line height; call SetLineHeight() to match native r<N> sizing.
- ComCall with the default "HRESULT" return type throws an OSError on failure. Void methods
  (BeginDraw, Clear, DrawText, SetColor) and EndDraw use "Int" so nothing is thrown for them.
- D2DGrid: alignment is per column (a cell can override it, SetAlign has no effect on a grid), column widths and gaps are
  DIPs, and "auto" widths are measured with IDWriteTextLayout. Cells are not clipped; fixed-width columns narrower than their
  text will overflow (use D2D1_DRAW_TEXT_OPTIONS_CLIP, 6 instead of 4 in _Render, to clip).
- D2DText.Create builds `this(...)`, so subclasses created through their own Create (D2DGrid.Create) construct themselves.
  Keep the factory calls as D2DText._Init() (not this._Init()) so subclasses share one pair of factories.
- Not yet handling dynamic DPI if moved between monitors with different DPIs, would need to handle DPI change
*/

/*
PruneMemory() => DllCall("psapi\EmptyWorkingSet", "ptr", -1)

; --- Demo ---
txt := ""
Loop 7 {
   txt .= a_index " Emoji=☀⛅☁☂☔⛈❄⛄⛈`n"
}
oGui := Gui("+Border +DPIScale +E0x02000000", "D2DText demo")
oGui.BackColor := "545485"
oGui.MarginX := 10, oGui.MarginY := 8
oGui.SetFont("s10  cA6ADC8", "Consolas")
tb0 := oGui.AddText("w400 r7 Background1E1E2E",txt)

d1 := oGui.AddD2DText("w400 r7 cA6ADC8", txt)                    ; transparent, text color from options
d1.SetLineHeight()
d2 := oGui.AddD2DText("w400 r1 cA6ADC8", "☀⛅☁☂☔⛈❄⛄⛈")          ; also transparent

gr := oGui.AddD2DGrid("w300 cA6ADC8")
gr.SetColumns([{al: "Left", w: "auto"}, {al: "Right", w: "auto"}, {al: "Left", w: "auto"}, {al: "Right", w: "auto"}, {al: "Left", w: "auto"}])
gr.SetRows([["Sat", "26°", "to", "30°", "⛅"], ["Sun", "24°", "to", {t: "35°", c: 0xFF8080}, "☃"], ["Mon", "11°", "to", "27°", "❄"]])
gr.Fit()

oGui.Show("AutoSize")
PruneMemory()
oGui.OnEvent("Close", (*) => ExitApp())
*/


/**
 * Return accurate fractional ms wall clock
 * @returns {Float} ms wall clock
 */
QPC() {
   static freq := 0
   if !freq
      DllCall("QueryPerformanceFrequency", "Int64*", &freq)
   DllCall("QueryPerformanceCounter", "Int64*", &t := 0)
   return t * 1000 / freq
}

;@Ahk2Exe-SetName Weather
;@Ahk2Exe-SetDescription Weather App
;@Ahk2Exe-Set Comments, Weather
;@Ahk2Exe-SetVersion 2026.11.11
;@Ahk2Exe-SetCopyright Copyright (c) 2026 Tom Wilkason
;@Ahk2Exe-SetOrigFilename Weather.exe
;@Ahk2Exe-SetMainIcon Partly Cloudy.ico
;@Ahk2Exe-AddResource WeatherWidget.manifest
#SingleInstance Off
#Requires AutoHotkey v2.1-
#include DirectWriteClass.ahk2
/*
TODO
- seems to stay on all desktops, this is desired
- Don't make static so would could have multiple instances at once for different locations
  Pass in location name into __Init
- Consider differnt layouts like MAC OS weather widget
- https://github.com/Makin-Things/weather-icons (SVG, some are animated)
*/

class Weather {
   /** @type {Gui} */
   static Gui             := ""
   static Lat             := 0.0
   static Lon             := 0.0
   static CC              := ""
   static userName        := ""
   static Interval        := 30 ; minutes
   static Ctl             := {}
   static Menu            := ""
   Static ActiveIcon      := ""
   Static forecastDays    := 5
   Static hourIncrement   := 3
   Static maxRows         := 8
   Static OnTop           := 0
   Static mks             := 0
   Static fontScaleFactor := 1
   Static ColorCodeDaily  := 1
   Static Assets          := A_ScriptDir . "\Assets\"
   Static Model           := "auto"
   Static RangeWidth      := 80 ; DIPs (before font scaling), width of the daily low/high range bar
   Static RangeHeight     := 0.3 ; thickness of the daily low/high range bar, as a fraction of the row height
   Static TempStops       := [0x7cacf8, 0x61cbc6, 0xf8dc80, 0xFAB387]  ; cold -> hot, for TempColor and the range bar gradient
   Static cbRefreshMe     := this.RefreshMe.Bind(this)
   Static cbUpdateData    := this.RefreshData.bind(this)
   Static Launched        := A_TickCount

  /*
      WMO Weather Codes Reference
      Code	      Description
      0	         Clear sky
      1, 2, 3	   Mainly clear, partly cloudy, and overcast
      45, 48	   Fog and depositing rime fog
      51, 53, 55	Drizzle: Light, moderate, and dense intensity
      56, 57	   Freezing Drizzle: Light and dense intensity
      61, 63, 65	Rain: Slight, moderate and heavy intensity
      66, 67	   Freezing Rain: Light and heavy intensity
      71, 73, 75	Snow fall: Slight, moderate, and heavy intensity
      77	         Snow grains
      80, 81, 82	Rain showers: Slight, moderate, and violent
      85, 86	   Snow showers slight and heavy
      95	         Thunderstorm: Slight or moderate
      96, 99	   Thunderstorm with slight and heavy hail

   */
   static Codes    := Map(
      0,  "Clear",
      1,  "Mainly clear",
      2,  "Partly cloudy",
      3,  "Overcast",
      45, "Fog",
      48, "Rime fog",
      51, "Light drizzle",
      53, "Drizzle",
      55, "Heavy drizzle",
      56, "Light Freezing drizzle",
      57, "Dense Freezing drizzle",
      61, "Light rain",
      63, "Rain",
      65, "Heavy rain",
      66, "Light Freezing rain",
      67, "Heavy Freezing rain",
      71, "Light snow",
      73, "Snow",
      75, "Heavy snow",
      77, "Snow grains",
      80, "Light showers",
      81, "Showers",
      82, "Heavy showers",
      85, "Snow showers",
      86, "Heavy snow showers",
      95, "Thunderstorm",
      96, "Thunderstorm, hail",
      97, "Thunderstorm",
      99, "Heavy Thunderstorm, hail"
   )
   Static Icons := Map(
      0, "Clear",               ;"Clear",
      1, "Light Clouds",        ;"Mainly clear",
      2, "Partly Cloudy",       ;"Partly cloudy",
      3, "Overcast",            ;"Overcast",
      45, "Fog",                ;"Fog",
      48, "Fog",                ;"Rime fog",
      51, "Drizzle",            ;"Light drizzle",
      53, "Drizzle",            ;"Drizzle",
      55, "Drizzle",            ;"Heavy drizzle",
      56, "Freezing drizzle",   ;"Freezing drizzle",
      57, "Freezing drizzle",   ;"Freezing drizzle",
      61, "Light Showers",      ;"Light rain",
      63, "Rain",               ;"Rain",
      65, "Rain",               ;"Heavy rain",
      66, "Freezing rain",      ;"Freezing rain",
      67, "Freezing rain",      ;"Freezing rain",
      71, "Light Snow",         ;"Light snow",
      73, "Snow",               ;"Snow",
      75, "Heavy Snow",         ;"Heavy snow",
      77, "Snow",               ;"Snow grains",
      80, "Light Showers",      ;"Light showers",
      81, "Light Showers",      ;"Showers",
      82, "Rain",               ;"Heavy showers",
      85, "Snow",               ;"Snow showers",
      86, "Snow",               ;"Heavy snow showers",
      95, "Thunderstorm",       ;"Thunderstorm",
      96, "Thunderstorm",       ;"Thunderstorm, hail",
      97, "Thunderstorm",       ;"Heavy Thunderstorm",
      99, "Thunderstorm"        ;"Thunderstorm, hail"
   )
   Static emoji := map(
       0, "☀️",         ;"Clear",
       1, "🌤️",        ;"Mainly clear",
       2, "⛅",        ;"Partly cloudy", 🌥️
       3, "☁️",         ;"Overcast",
      45, "🌫️",        ;"Fog",
      48, "🌫️",        ;"Rime fog",
      51, "🌦️",        ;"Light drizzle",
      53, "🌧️",        ;"Drizzle",
      55, "☔",       ;"Heavy drizzle",
      56, "🧊",       ;"Freezing drizzle",
      57, "🧊",       ;"Freezing drizzle",
      61, "🌦️",       ;"Light rain",
      63, "🌧️",        ;"Rain",
      65, "☔",        ;"Heavy rain",
      66, "🧊",        ;"Freezing rain",
      67, "🧊",        ;"Freezing rain",
      71, "🌨️",        ;"Light snow",
      73, "❄",        ;"Snow",
      75, "☃️",       ;"Heavy snow",
      77, "🌨️",        ;"Snow grains",
      80, "🌦️",       ;"Light showers",
      81, "🌦️",       ;"Showers",
      82, "⛈️",        ;"Heavy showers",
      85, "❄",        ;"Snow showers",
      86, "☃️",        ;"Heavy snow showers",
      95, "🌩️",        ;"Thunderstorm",
      96, "⛈️",        ;"Thunderstorm, hail",
      97, "🌩️",        ;"Heavy Thunderstorm",
      99, "⛈️"         ;"Thunderstorm, hail"
   )
   /**
    * Program entry point. Loads settings from the ini file, resolves the default location
    * (prompting the user if none is set), builds the GUI and starts the first data refresh.
    * Exits the app if no location can be set and the user declines to continue.
    */
   static Init() {
      this.Menu := Menu()
      this.iniFile := A_ScriptDir "\WeatherWidget.ini"
      this.NeedGeo := 1
      this.hourlyAQI := Map()

      ; Set default locations
      this.userName := IniRead(this.iniFile, A_ComputerName, "Loc", "")
      If (obj := this.GeocodeName(this.userName)) {
         this.Lat     := obj.lat
         this.Lon     := obj.lon
         this.CC      := obj.CC
         this.Model   := obj.Model
         this.setModel(obj)
         ; Default was initially used
         If (this.userName != obj.userName) {
            IniWrite(obj.userName, this.iniFile, A_ComputerName, "Loc") ; default
            IniWrite(obj.userName, this.iniFile, "Locations") ; add to locations
            ; Cache the loctation
            this.userName    := obj.userName
            this.cacheUserLocation(obj)
         }
         this.NeedGeo := 0
      } Else {
         if (MsgBox("Failed to set a location for weather, do you want to continue?",,0x4) = "No") 
            ExitApp()
      }
      this.Interval        := Integer(IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30))
      this.OnTop           := Integer(IniRead(this.iniFile, A_ComputerName, "OnTop", this.OnTop))
      this.MKS             := Integer(IniRead(this.iniFile, A_ComputerName, "MKS", this.MKS))
      this.forecastDays    := Integer(IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays))
      this.hourIncrement   := Integer(IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement))
      this.maxRows         := Integer(IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows))
      this.fontScaleFactor := Number(IniRead(this.iniFile, A_ComputerName, "FontScaling", this.fontScaleFactor))
      this.ColorCodeDaily  := IniRead(this.iniFile, A_ComputerName, "Color Code Daily", this.ColorCodeDaily)

      ; Build the GUI, should be DPI aware, composting helps with flicker
      X := IniRead(this.iniFile, A_ComputerName, "X", 0)
      Y := IniRead(this.iniFile, A_ComputerName, "Y", 0)

      g := this.BuildGUI(X?, Y?)
      OnMessage(0x404, this.TrayMessage.Bind(this))
      If (this.hasInternet) {
         this.RefreshData()
      } Else {
         MsgBox("You do not seem to be connected to the internet which is required for data")
         SetTimer(this.cbUpdateData, this.Interval * 60000)
      }
      OnExit this.SaveOnExit.bind(this)
      Sleep(100)
   }
   /**
    * Determine if Windows thinks it is connected to the internet (Network List Manager)
    * @returns {Boolean} true if connected, false if not or if the query fails
    */
   Static hasInternet {
      get {
         Try
            Return ComObject("{DCB00C01-570F-4A9B-8D69-199FDBA5723B}").IsConnectedToInternet
         Catch
            Return false
      }
   }   
   /**
    * Build (or rebuild) the widget GUI and all of its controls, scaled by fontScaleFactor.
    * Any existing GUI and its D2D resources are disposed first.
    * @param {Integer} X Screen X position for the window
    * @param {Integer} Y Screen Y position for the window
    * @returns {Gui} The new GUI object (also stored in Weather.Gui)
    */
   Static BuildGUI(X, Y) {
      If (this.Gui) {
         D2DText.DisposeAll(this.Gui)
         this.Gui.Destroy()
      }
      /** @type {Gui} */
      g := this.Gui := Gui("-Caption +ToolWindow +Border +DPIScale +E0x02000000")
      this.BackColor := g.BackColor := "1E1E2E"
      g.MarginX := fs(12), g.MarginY := fs(10)
      /*
         y+N is relative to the bottom edge of the previous control.
         yp+N is relative to the top edge (Y position) of the previous control. p = previous
         ym adds a margin
         r8 means 8 rows
      */
      wid := 310 ; hand tune this
      this.Ctl.loc     := this.AddTextCtl(fs("w" wid),                    this.userName,    fs("s11 Bold") " cA6ADC8", "Segoe UI")  ; Los Angeles

      this.Ctl.temp    := this.AddTextCtl(fs("w78 y+2") " Right",        "---°",       fs("s30") " cCDD6F4 Bold", "Segoe UI")  ; 75
      this.Ctl.AQI     := this.AddTextCtl(fs("w43 x+8 yp+12") " Right",  "---",        fs("s20") " cCDD6F4 Bold", "Segoe UI")  ; 34 same row
      this.Ctl.AQIlab  := this.AddTextCtl(fs("w30 x+2 yp+14"),           "aqi",        fs("s9")  " cA6ADC8 Norm", "Segoe UI")  ; aqi same row

      this.Ctl.hilo    := this.AddTextCtl(fs("w" wid " xm y+20"),      "Loading...",   fs("s11") " cCDD6F4 Norm", "Segoe UI")  ; H/L temp
      this.Ctl.cond    := this.AddTextCtl(fs("w" wid/3 " x" 2*wid/3 " yp Center"),,    fs("s11") " cCDD6F4 Bold", "Segoe UI")  ; Partly Cloudy on right

      this.Ctl.detail  := this.AddTextCtl(fs("w" wid " xm y+8"),,                      fs("s11") " cc7cfeb Norm", "Segoe UI")  ; Feels like ...

      this.Ctl.srss   := this.AddD2DTextCtl(fs("w200 xm y+8"), ,                     "Segoe UI", fs(12), "f3f4cd")   ; Sunrise/Sunset
      this.Ctl.moon   := this.AddD2DTextCtl(fs("w50 x+35 yp-6 Right"), ,             "Segoe UI", fs(20), "f3f4cd")   ; Moon phase, larger
      ; The grids take their row height from the GUI font in effect here (r<N> sizing), so match it to the grid font
      ; Column widths are measured from the text; only the gaps (DIPs, scaled with fs like everything else) are tuned
      this.Ctl.hourly := this.AddD2DGridCtl(fs("w" wid " xm y+8") " r" (this.maxRows + 1),,"Segoe UI", fs(10), "CDD6F4")   ; Direct Write grid for emojis
      this.Ctl.hourly.SetColumns([ ; gap is after the entry
         {al: "Right", w: "auto", gap: fs(10)},   ; time
         {al: "Right", w: "auto", gap: fs(4)},    ; temp
         {al: "Center",  w: "auto", gap: fs(8)}, ; condition icon
         {al: "Right", w: "auto", gap: fs(8)},   ; aqi
         {al: "Right", w: "auto", gap: fs(8)},   ; humidity
         {al: "Right", w: "auto", gap: fs(8)},   ; precip %
         {al: "Right", w: "auto", gap: fs(1)},    ; wind speed
         {al: "Center", w: "auto", gap: fs(1)},   ; "-"
         {al: "Right", w: "auto", gap: fs(3)},    ; wind speed gusts
         {al: "Left",  w: "auto"}])               ; wind direction

      this.Ctl.daily  := this.AddD2DGridCtl(fs("wp y+8") " r" (this.forecastDays + 1),,"Segoe UI", fs(10), "CDD6F4")   ; Direct Write grid for emojis
      this.Ctl.daily.SetColumns([
         {al: "Left",  w: "auto", gap: fs(4)},    ; day
         {al: "Right", w: "auto", gap: fs(4)},    ; low
         {al: "Left",  w: fs(this.RangeWidth), gap: fs(4)},    ; range bar (drawn, fixed width)
         {al: "Right", w: "auto", gap: fs(0)},    ; high
         {al: "Left",  w: "auto", gap: fs(6)},    ; condition icon
         {al: "Right", w: "auto", gap: fs(1)},    ; precip amount
         {al: "Left",  w: "auto", gap: fs(2)},    ; precip unit , necessary?
         {al: "Left",  w: "auto", gap: fs(4)},    ; precip icon
         {al: "Right", w: "auto", gap: fs(2)},    ; wind/gust speed
         {al: "Left",  w: "auto"}])               ; Gust Icon
      this.Ctl.daily.SetBarHeight(this.RangeHeight)
      this.Ctl.updated := this.AddTextCtl(fs("wp y+8"),,                                fs("s9")  " c7F849C", "Segoe UI")  ; overlay1
      this.ActiveIcon := ""
      this.Ctl.Icon := g.AddPicture(fs("H96 W96 X" (wid - 96 + 12) " Y0"))      ; X is width - 96
      if (this.dpi() > 96)
         this.DropShadow(g.hWnd) ; also border
      else
         this.Round11Corners(g.hWnd, 3) ; use slightly smaller corners, lowdpi less clipping on corners, breaks drop shadows
      ; Make the grid space with full width, looks better
      this.Ctl.hourly.SetJustify()
      this.Ctl.daily.SetJustify()
      ; Hand mouse drag/tray click/RMB Menu
      g.OnEvent("ContextMenu", (*) => this.ShowRMB())

      ; Keep on visible monitors, measure first
      g.Show("NoActivate Hide AutoSize")
      this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      g.Show("NoActivate x" X " y" Y)
      this.SnapToWorkArea(g, 0, 0, 0) ; in case it was off the screen

      ; in Init, after the controls are created
      this.Ctl.daily.GetPos(,,, &h1)
      this.Ctl.hourly.GetPos(,,, &h2)
      this.rowH1 := h1 // (this.forecastDays + 1)
      this.rowH2 := h2 // (this.maxRows + 1)      
      ; In case days/maxRows was zerod out, squash the title height
      if !(this.forecastDays && this.maxRows) 
         this.ApplyRowCounts()
      g.OnMessage(0x201, this.Drag.bind(this))
      g.OnMessage(0x232, this.SnapToWorkArea.bind(this))   ; WM_EXITSIZEMOVE

      Return g

      /**
       * Scale a number, or the numeric values in a GUI option string (x/y/w/h with m/p/+/- prefixes,
       * and font size s<N>), by the current fontScaleFactor.
       * @param {Number | String} val A number, or an option string such as "w310 xm y+8" or "s11 Bold"
       * @param {Integer} r Decimal places for rounding numbers and font sizes (positions are always whole)
       * @returns {Number | String} The scaled number, or the option string with scaled values
       */
      fs(val, r := 1) {
         k := this.fontScaleFactor
         if IsNumber(val)
            return Round(val * k, r)
         out := ""
         for tok in StrSplit(Trim(val), [" ", "`t"]) {
            if tok = ""
               continue
            if RegExMatch(tok, "i)^([xywh][msp]?[+-]?|s)(\d+(?:\.\d+)?)$", &m)
               tok := m[1] Round(m[2] * k, m[1] = "s" ? r : 0)
            out .= (out = "" ? "" : " ") tok
         }
         return out
      }

   }
   /**
    * Rebuild the GUI in place with a new scale factor and refresh the data.
    * Does nothing if sf is omitted or effectively unchanged.
    * @param {Number} [sf] New scale factor to use
    */
   Static ReBuildGUI(sf?) {
      If (IsSet(sf)) {
         If Abs(sf - this.fontScaleFactor) > 0.01 {
            this.fontScaleFactor := sf
            this.Gui.GetPos(&X, &Y, &W, &H)
            this.BuildGUI(X, Y)
            this.RefreshData()
         }
      }
   }
   /**
    * Resize the hourly and daily grids to match maxRows/forecastDays, reposition the
    * controls below them and auto-size the window. A count of 0 collapses that grid.
    * Call after changing maxRows, forecastDays or hourIncrement.
    */
   Static ApplyRowCounts() {
      c := this.Ctl
      hg := c.hourly, dg := c.daily
      gap := 8
      hg.GetPos(, &hY)
      hH := this.maxRows ? Ceil((this.maxRows + 1) * hg._lineH + 2 * hg._pad) : -gap
      dH := this.forecastDays ? Ceil((this.forecastDays + 1) * dg._lineH + 2 * dg._pad) : -gap
      dY := hY + hH + gap
      hg.Move(, , , hH)               ; adjust height only
      dg.Move(, dY, , dH)             ; height and new Y
      c.updated.Move(, dY + dH + gap) ; new Y only
      this.Gui.Show("NoActivate AutoSize")
   }
   /**
    * Return the approximate moon phase as a Unicode symbol (one of 8 phases)
    * @param {Number} deltaDay Days offset from now (e.g. 1 = tomorrow)
    * @returns {String} Moon phase character 🌑🌒🌓🌔🌕🌖🌗🌘
    */
   Static MoonPhase(deltaDay:=0) {
      p := 29.530588853                                  ; synodic month, days
      age := Mod(DateDiff(A_NowUTC, "20000106181400", "S") / 86400 + deltaDay, p)   ; days since the 2000-01-06 new moon
      idx := Mod(Floor(age / p * 8 + 0.5), 8)            ; 0 = new, 4 = full
      Return Chr(0x1F311 + idx)                          ; 🌑🌒🌓🌔🌕🌖🌗🌘
   }
   /**
    * Read the locations in the order they appear in the ini file, so the user can reorder them.
    * Lines may be bare names or key=name (the key is ignored).
    * @param {String} iniFile Path of the ini file
    * @param {String} section Section holding the location list
    * @returns {Array} Location names
    */
   Static ReadLocations(iniFile, section := "Locations") {
      cities := []
      for line in StrSplit(IniRead(iniFile, section), "`n", "`r") {
         pos := InStr(line, "=")
         city := Trim(pos ? SubStr(line, pos + 1) : line)
         if (city != "")
            cities.Push(city)
      }
      return cities
   } 
   /**
    * Add a transparent-background text control, optionally setting the GUI font first
    * @param {String} options Size/placement options
    * @param {String} [default] Initial text
    * @param {String} [fontOpt] Font options (size, color, weight)
    * @param {String} [fontName] Font name
    * @returns {Gui.Text} The new control
    */
   Static AddTextCtl(options, default?, fontOpt?, fontName?) {
      if (IsSet(fontOpt) || IsSet(fontName))
         this.gui.SetFont(fontOpt ?? "", fontName ?? "")
      return this.gui.AddText(options " BackgroundTrans", default ?? "")
   }
   /**
    * Wrapper for Gui.AddD2DText that first sets the GUI font, so r<N>/auto sizing matches the D2D font
    * @param {Any*} params AddD2DText arguments: options, text, fontName, fontSize, color
    * @returns {D2DText} The new control
    */
   Static AddD2DTextCtl(params*) {
      this.Gui.SetFont("S" params[4], params[3])
      return this.gui.AddD2DText(params*)
   }
   /**
    * Wrapper for Gui.AddD2DGrid that first sets the GUI font, so r<N> row sizing matches the grid font
    * @param {Any*} params AddD2DGrid arguments: options, text, fontName, fontSize, color
    * @returns {D2DGrid} The new grid control
    */
   Static AddD2DGridCtl(params*) {
      this.Gui.SetFont("S" params[4], params[3])
      return this.gui.AddD2DGrid(params*)
   }
   /**
    * Rebuild and show the right-click context menu
    */
   Static ShowRMB() {
      this.BuildRMB()
      this.Menu.Show()
   }
   /**
    * Rebuild the right-click menu from scratch (locations, display settings, toggles),
    * re-reading the ini file in case it was edited by hand
    */
   Static BuildRMB() {
      this.Menu.Delete()
      this.Menu := Menu()
      ; Read the whole section to so retain order in the file vs by number
      ; This allows duplicate entries or just loc=.......
      locs := []
      Try locs := this.ReadLocations(this.iniFile)
      this.Menu.Add("Manage Locations", (*) => LocationManager.Show())
      Try this.Menu.SetIcon("Manage Locations", this.Assets "Location.Ico")
      this.Menu.Add()
      If (locs.Length) {
         maxLoc := IniRead(this.iniFile, "Default", "Max Locations", 50)
         for idx, loc in locs {
            this.Menu.Add(loc, this.SetLocation.Bind(this))
            if (loc = this.userName)
               this.Menu.Check(loc)
            if idx >= maxLoc
               break
         }
      } Else
         this.Menu.Add("Refresh now", this.cbUpdateData)      

      this.Menu.add()
      this.Menu.Add("Display Max Hourly Rows", this.BuildNumMenu("maxRows", "Max Rows", 15,1, 0))
      this.Menu.Add("Display Hourly Interval", this.BuildNumMenu("hourIncrement", "Hours Increment", 6))
      this.Menu.Add("Display Forecast Days",   this.BuildNumMenu("forecastDays", "Forecast Days", 16,1, 0))
      this.Menu.Add("Refresh Minute Interval", this.BuildNumMenu("Interval", "Refresh Minutes", 60, 5, 5))
      this.Menu.Add("Display Scale Factor",    this.BuildSFMenu("fontScaleFactor", "FontScaling", 
      ["0.75", "0.8", "0.9", "0.95", "1", "1.05", "1.1", "1.2", "1.25", "1.5", "1.75", "2.0"]))

      this.Menu.Add()
      this.Menu.Add("Edit Settings File", (*) => Run(this.iniFile))  ; Creates a new menu item.
      Try this.Menu.SetIcon("Edit Settings File", this.Assets "Settings.Ico")

      mn := "Always On Top"
      this.Menu.Add(mn, ToggleOnTop)  ; Creates a new menu item.
      If (this.OnTop)
         this.Menu.Check(mn)

      mn := "Metric Units"
      this.Menu.Add(mn, ToggleMKS)  ; Creates a new menu item.
      if (this.mks)
         this.Menu.Check(mn)

      mn := "Color Code Temperature"
      this.Menu.Add(mn, ToggleTemp)  ; Creates a new menu item.
      if (this.ColorCodeDaily)
         this.Menu.Check(mn)
         
      If (A_IsCompiled) {
         this.Menu.Add("Run at Startup", (*) => this.SetStartup(!this.StartupEnabled))
         If (this.StartupEnabled)
            this.Menu.Check("Run at Startup")
      }

      this.Menu.Add()
      this.Menu.Add("Exit", (*) => ExitApp())
      Try this.Menu.SetIcon("Exit", this.Assets "Exit.Ico")
      /**
       * Menu callback: toggle Always On Top and save the setting
       */
      ToggleOnTop(*) {
         this.OnTop := !this.OnTop
         IniWrite(this.OnTop, this.iniFile, A_ComputerName, "OnTop")
         this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      }
      /**
       * Menu callback: toggle metric/imperial units, save the setting and refresh the data
       */
      ToggleMKS(*) {
         this.mks := !this.mks
         IniWrite(this.mks, this.iniFile, A_ComputerName, "MKS")
         this.RefreshData()
      }
      /**
       * Menu callback: toggle temperature color coding, save the setting and refresh the data
       */
      ToggleTemp(*) {
         this.ColorCodeDaily := !this.ColorCodeDaily
         IniWrite(this.ColorCodeDaily, this.iniFile, A_ComputerName, "Color Code Daily")
         this.RefreshData()
      }
   }
   /**
    * Build a submenu of scale factor choices, checking the current one.
    * Selecting an item rebuilds the GUI at that scale and saves it to the ini file.
    * @param {String} prop Name of the Weather property holding the current value
    * @param {String} iniKey Ini key to save the selection under
    * @param {Array} vals Scale factor values (as strings) to list
    * @returns {Menu} The submenu
    */
   static BuildSFMenu(prop, iniKey, vals) {
      sub := Menu()
      for v in vals {
         sub.Add(v, Rebuild.bind(v, prop, iniKey))
         if (v = this.%prop%)
            sub.Check(v)
      }
      return sub
      /**
       * Menu callback: rebuild the GUI at the chosen scale and save it
       * @param {String} sf Selected scale factor
       * @param {String} prop Name of the Weather property holding the value
       * @param {String} iniKey Ini key to save the value under
       */
      Rebuild(sf, prop, iniKey, *) {
         this.ReBuildGUI(sf)
         IniWrite(sf, this.iniFile, A_ComputerName, iniKey)
      }
   }
   /**
    * Build a numeric submenu (mn..mx by inc) for a Weather property, checking the current value
    * @param {String} prop Name of the Weather property to set
    * @param {String} iniKey Ini key to save the selection under
    * @param {Integer} mx Largest value listed
    * @param {Integer} inc Step between values
    * @param {Integer} mn Smallest value listed
    * @returns {Menu} The submenu
    */
   static BuildNumMenu(prop, iniKey, mx:=10, inc:=1, mn := 1) {
      sub := Menu()
      For I in Range(mn, mx, inc) {
         sub.Add(I, this.SetNum.Bind(this, prop, iniKey))
         if (I = this.%prop%)
            sub.Check(I)
      }
      return sub
   }
   /**
    * Menu callback for BuildNumMenu: set the property, move the check mark, save it,
    * then resize the grids and refresh the data
    * @param {String} prop Name of the Weather property to set
    * @param {String} iniKey Ini key to save the value under
    * @param {String} itemName Selected menu item text (the numeric value)
    * @param {Integer} itemPos Menu item position (unused)
    * @param {Menu} sub The submenu the item belongs to
    */
   static SetNum(prop, iniKey, itemName, itemPos, sub) {
      Try sub.Uncheck(this.%prop%) ; skip if value was set not on the menu
      this.%prop% := Integer(itemName)
      sub.Check(itemName)
      IniWrite(this.%prop%, this.iniFile, A_ComputerName, iniKey)
      this.ApplyRowCounts()
      this.RefreshData()
   }
   
   /**
    * Switch to a new location (menu callback, also called by LocationManager).
    * Geocodes the name, saves it as the default, re-reads display settings and refreshes the data.
    * @param {String} userName Name of the location
    * @param {Integer} ItemPos Menu item position (unused)
    * @param {Menu} MyMenu Menu the item belongs to (unused)
    */
   Static SetLocation(userName, ItemPos, MyMenu) {
      If (userName != this.userName) {
         If (obj := this.GeocodeName(userName)) {
            this.Lat      := obj.lat
            this.Lon      := obj.lon
            this.CC       := obj.CC
            this.Model    := obj.Model
            this.userName := userName
            this.NeedGeo  := 0
            IniWrite(userName, this.iniFile, A_ComputerName, "Loc")
            this.setModel(obj)
            If (!obj.cached) {
               this.cacheUserLocation(obj)
            }
         } Else {
            this.NeedGeo := 1
            this.Ctl.updated.Text := "Location lookup failed for " userName
            MsgBox("Failed to get a location for`n" userName, "Location Error", 0x30)
         }
      }
      ; User may have changed these by hand
      this.Interval      := Integer(IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30))
      this.forecastDays  := Integer(IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays) )
      this.hourIncrement := Integer(IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement) )
      this.maxRows       := Integer(IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows) )
      this.RefreshData()
   }
   /**
    * Pick the best forecast model for a location if it doesn't already have one
    * (NBM CONUS for the contiguous US, otherwise "auto"). Updates both obj.Model and Weather.Model.
    * @param {Object} obj Location object from GeocodeName
    * @returns {String} The model name in effect for the location
    */
   Static setModel(obj) {
      If (not obj.Model) {
         If obj.FullName ~= "Hawaii|Alaska|Puerto Rico"
            this.Model := obj.Model := "auto"
         else If obj.CC = "us"
            this.Model := obj.Model := "ncep_nbm_conus" ; best for US
         Else
            this.Model := obj.Model := "auto"
      }
      Return obj.Model
   }
   /**
    * Cache a location's geocode results in its own ini section, so later lookups skip the web query
    * @param {Object} obj Location object from GeocodeName (userName, CC, Lat, Lon, Model, fullName)
    */
   Static cacheUserLocation(obj) {
      IniWrite(obj.CC, this.iniFile, obj.userName, "CC")
      IniWrite(obj.Lat, this.iniFile, obj.userName, "Lat")
      IniWrite(obj.Lon, this.iniFile, obj.userName, "Lon")
      IniWrite(obj.Model, this.iniFile, obj.userName, "Model")
      IniWrite(obj.fullName, this.iniFile, obj.userName, "FullName")
   }
   /**
    * OnExit callback: save the window position and current location, and write any
    * settings that are missing from the ini file so the user can find and edit them
    * @param {String} ExitReason Reason the script is exiting
    * @param {Integer} ExitCode Exit code
    */
   static SaveOnExit(ExitReason, ExitCode) {
      this.Gui.GetPos(&X, &Y)
      IniWrite(this.userName, this.iniFile, A_ComputerName, "Loc")
      IniWrite(X, this.iniFile, A_ComputerName, "X")
      IniWrite(Y, this.iniFile, A_ComputerName, "Y")
      this.writeIfBlank(this.ColorCodeDaily, A_ComputerName, "Color Code Daily")
      this.writeIfBlank(this.Interval, A_ComputerName, "Refresh Minutes")
      this.writeIfBlank(this.forecastDays, A_ComputerName, "Forecast Days")
      this.writeIfBlank(this.fontScaleFactor, A_ComputerName, "FontScaling") ;
      this.writeIfBlank(this.maxRows, A_ComputerName, "Max Rows")
   }
   /**
    * Write a value to the ini file only if the key doesn't already exist
    * @param {Any} val Value to write
    * @param {String} section Ini section
    * @param {String} tag Ini key
    */
   Static writeIfBlank(val, section, tag) {
      If (IniRead(this.iniFile, section, tag, "xxx") == "xxx") {
         IniWrite(val, this.iniFile, section, tag)
      }
   }
   /**
    * WM_LBUTTONDOWN handler: start a window drag, since the GUI has no caption
    * @param {Gui | Gui.Control} GuiOrCtrlObj Window or control that was clicked
    * @param {Integer} wParam Message wParam
    * @param {Integer} lParam Message lParam
    * @param {Integer} msg Message number
    */
   static Drag(GuiOrCtrlObj, wParam, lParam, msg) {
      DllCall("ReleaseCapture")
      this.RefreshMe()
      PostMessage(0xA1, 2, , , GuiOrCtrlObj.hWnd)   ; WM_NCLBUTTONDOWN, HTCAPTION
   }
   /**
    * Move the window, if needed, so it lies fully within the work area of its nearest monitor.
    * Used as the WM_EXITSIZEMOVE handler and called directly after showing the GUI.
    * @param {Gui} GuiOrCtrlObj Window to snap
    * @param {Integer} wParam Message wParam (unused)
    * @param {Integer} lParam Message lParam (unused)
    * @param {Integer} msg Message number (unused)
    */
   Static SnapToWorkArea(GuiOrCtrlObj, wParam, lParam, msg) {
      hMon := DllCall("MonitorFromWindow", "Ptr", GuiOrCtrlObj.hwnd, "UInt", 2, "Ptr")   ; MONITOR_DEFAULTTONEAREST
      mi := Buffer(40, 0)
      NumPut("UInt", 40, mi)                                                 ; MONITORINFO.cbSize
      DllCall("GetMonitorInfo", "Ptr", hMon, "Ptr", mi)
      L := NumGet(mi, 20, "Int"), T := NumGet(mi, 24, "Int")                 ; rcWork
      R := NumGet(mi, 28, "Int"), B := NumGet(mi, 32, "Int")
      WinGetPos(&x, &y, &w, &h, GuiOrCtrlObj)
      nx := Max(L, Min(x, R - w))
      ny := Max(T, Min(y, B - h))
      If (nx != x || ny != y)
         WinMove(nx, ny, , , GuiOrCtrlObj)
   }
   /**
    * Returns true if any part of the window lies on an attached monitor.
    * @param {Gui|Integer} hGui A Gui object or its Hwnd.
    * @returns {Boolean}
    */
   Static IsOnMonitor(hGui) {
      hGui := IsObject(hGui) ? hGui.Hwnd : hGui
      Return !!DllCall("MonitorFromWindow", "Ptr", hGui, "UInt", 0, "Ptr")   ; MONITOR_DEFAULTTONULL
   }   
   /**
    * Determine if the workstation is locked, by checking whether the input desktop can be opened
    * @returns {Boolean} true if locked (input desktop not accessible), false if unlocked
    */
   Static IsScreenLocked(*) {
      ; If it returns a handle, we must close it and report as unlocked.
      If hDesktop := DllCall("User32\OpenInputDesktop", "Int", 0, "Int", 0, "Int", 0x100, "Ptr") {
         DllCall("User32\CloseDesktop", "Ptr", hDesktop)
         Return false
      }
      Return true
   }
   /**
    * Query and render the weather and air quality data, then repaint the GUI.
    * Skips the update (retrying in a minute) if the screen is locked, the window is off-screen
    * or there is no internet; on success reschedules for the normal refresh interval.
    */
   Static RefreshData(*) {
      hwnd := this.Gui.Hwnd
      If (this.IsScreenLocked()) {
         OutputDebug("WeatherWidget: Screen Is Locked, trying again in a minute")
         SetTimer(this.cbUpdateData, -60000)         ; retry in a minute; a successful run restores the normal interval
         Return         
      }
      If !this.IsOnMonitor(hwnd) {
         OutputDebug("WeatherWidget: Window not on an attached monitor, trying again in a minute")
         SetTimer(this.cbUpdateData, -60000)
         Return
      }
      If ( Not this.hasInternet) {
         this.Ctl.updated.Text := "No Internet Connection"
         OutputDebug("No Internet connection detected, trying again in a minute")
         SetTimer(this.cbUpdateData, -60000)         ; retry in a minute; a successful run restores the normal interval
         Return
      }
      ; Perform the query now
      SendMessage(0x000B, 0, 0, , hwnd)   ; WM_SETREDRAW , helps with flicker
      Try {
         ok := this.UpdateAirQuality()
         ok := this.UpdateWeather() && ok
      } Finally {
         SendMessage(0x000B, 1, 0, , hwnd)   ; WM_SETREDRAW on
      }
      ; Everything updated, now refresh GUI all at once
      ; Change backcolor outside of WM_SETREDRAW off
      If (ok) {
         this.RefreshMe()
         If (this.Gui.BackColor != this.BackColor) {
            this.Gui.BackColor := this.BackColor ; triggers a repaint
         }
         OutputDebug("WeatherWidget: Updated Weather and Air Quality for " this.userName " using model " this.Model)
         this.PruneMemory()
         SetTimer(this.cbUpdateData, this.Interval * 60000)
      } Else {
         OutputDebug("WeatherWidget: Query Failed, trying again in a minute")
         SetTimer(this.cbUpdateData, -60000)
      }
   }
   /**
    * Resolve lat/lon from the location name if not already known (NeedGeo).
    * Shows an error in the footer if the lookup fails.
    * @returns {Boolean} true if coordinates are available, false if the lookup failed
    */
   Static EnsureGeo() {
      If (!this.NeedGeo)
         Return true
      If (!(obj := this.GeocodeName(this.userName))) {
         this.Ctl.updated.Text := "Location lookup failed for " this.userName " - " FormatTime(, "h:mm tt")
         Return false
      }
      this.Lat := obj.lat, this.Lon := obj.lon, this.CC :=obj.CC, this.NeedGeo := 0
      Return true
   }

   /**
    * GET a URL and hand the response text to a renderer.
    * On any failure, shows the error in the footer and returns false (the caller schedules the retry).
    * @param {String} url The full request URL
    * @param {Func} renderer Callback that receives the response text
    * @returns {Boolean} true if the request and render both succeeded
    */
   Static Query(url, renderer) {
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(3000, 3000, 8000, 8000)
         http.Open("GET", url, false)
         http.Send()
         if (http.Status != 200)
            throw Error("HTTP " http.Status)
      } catch Any as e {
         this.Ctl.updated.Text := "Update failed " FormatTime(, "h:mm tt") " (" e.Message ")"
         OutputDebug("Update failed " FormatTime(, "h:mm tt") " (" e.Message ")")
         Return false
      }
      Try {
         renderer(http.ResponseText)
      } Catch Any As e {
         this.Ctl.updated.Text := "Render Error " FormatTime(, "h:mm tt") " (" e.Message ")"
         OutputDebug("Render Error " FormatTime(, "h:mm tt") " (" e.Message ")")
         Return false
      }
      Return true
   }

   /**
    * Query the Open-Meteo air quality API (current and hourly US AQI) and render it
    * NOTE : If location is in Europe, it may be better to use the European standard european_aqi.
    *        Note, the color coding breakpoints would be different
    * @returns {Boolean} true on success
    */
   Static UpdateAirQuality(*) {
      If (!this.EnsureGeo())
         Return false
      url := "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" this.Lat "&longitude=" this.Lon
         . "&current=us_aqi&hourly=us_aqi&forecast_hours=" this.maxRows * this.hourIncrement + 2 "&timezone=auto"
      Return this.Query(url, this.RenderAQI.Bind(this))
   }

   /**
    * Query the Open-Meteo forecast API (current, hourly and daily) in the selected units and model, and render it
    * @returns {Boolean} true on success
    */
   Static UpdateWeather(*) {
      If (!this.EnsureGeo())
         Return false
      If (this.mks) {
         ws := "kmh"
         tu := "celsius"
         pu := "mm"
      } Else {
         ws := "mph"
         tu := "fahrenheit"
         pu := "inch"
      }
      url := "https://api.open-meteo.com/v1/forecast?latitude=" this.Lat "&longitude=" this.Lon 
         . (!(this.Model = "auto" || this.Model = "") ? "&models=" this.Model : "")
         . "&current=weather_code,temperature_2m,wind_gusts_10m,wind_speed_10m,wind_direction_10m,apparent_temperature,relative_humidity_2m,is_day"
         . "&hourly=weather_code,temperature_2m,precipitation_probability,wind_speed_10m,wind_gusts_10m,wind_direction_10m,relative_humidity_2m,is_day"
         . "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,snowfall_sum,precipitation_probability_max,"
         . "wind_speed_10m_max,wind_gusts_10m_max,sunrise,sunset" ;; wind_direction_10m_dominant
         . "&precipitation_unit=" pu "&temperature_unit=" tu "&wind_speed_unit=" ws "&forecast_days=" max(this.forecastDays,1)
         . "&forecast_hours=" this.maxRows * this.hourIncrement + 2 "&timezone=auto"
      Return this.Query(url, this.RenderWeather.Bind(this))
   }

   /**
    * Render the current US AQI and save the hourly values (keyed by time) for RenderWeather
    * @param {String} json Air quality API response text
    */
   Static RenderAQI(json) {
      cur   := this.Section(json, "current")
      hrs   := this.Section(json, "hourly")
      times := this.List(hrs, "time")
      haqi  := this.List(hrs, "us_aqi")
      ; Save this for weather render stage, keyed by hour so it aligns with the weather data
      this.hourlyAQI := Map()
      Loop times.Length
         this.hourlyAQI[times[A_Index]] := haqi.Has(A_Index) ? haqi[A_Index] : ""
      v := this.Value(cur, "us_aqi")
      If (!IsNumber(v)) {
         this.Ctl.AQI.Text := "---"
         Return
      }
      aqi := Integer(v)
      this.Ctl.AQI.Text := aqi
      this.Ctl.AQI.SetFont("C" this.AqiColor(aqi))
   }
   /**
    * Map a US AQI value to its standard category color
    * @param {Integer | String} aqi AQI value, or "" if unknown
    * @returns {String} RRGGBB color (white if unknown)
    */
   Static AqiColor(aqi) {
      Return (aqi = "" || aqi < 0) ? "ffffff"
      : aqi <= 50 ? "1dd31d"
      : aqi <= 100 ? "cece1f"
      : aqi <= 150 ? "c9721b"
      : aqi <= 200 ? "f93434"
      : aqi <= 300 ? "da006d"
      : "7E0023"
   }
   /**
    * Render the weather data: current conditions, hourly and daily grids, footer, condition icon and tray tip
    * @param {String} json Forecast API response text
    */
   static RenderWeather(json) {
      cur    := this.Section(json, "current")
      day    := this.Section(json, "daily")
      hrs    := this.Section(json, "hourly")

      code  := Integer(this.Value(cur, "weather_code"))
      isDay := Integer(this.Value(cur, "is_day"))
      tf    := Round(this.Value(cur, "temperature_2m"))
      d     := Compass(this.Value(cur, "wind_direction_10m"))
      ; Time for weather location
      off      := Integer(this.Value(json, "utc_offset_seconds"))
      localNow := DateAdd(A_NowUTC, off, "Seconds")

      ; change background if transitioning from day ⬌ Night
      this.BackColor:= isDay ? "1E1E2E" : "11111B"
      ;-----------------------------------------------------------------------
      ; Constants
      ;-----------------------------------------------------------------------
      hc       := 0xFFFFFF ; Header Color
      tc       := this.Ctl.daily._fg ; Normal Text Color (same as default)
      tcbright := this.ScaleBrightness(tc, 25)
      tcdim    := this.ScaleBrightness(tc, -25)
      tcrb     := this.ScaleBrightness(tc, -50)
      cc       := this.ColorCodeDaily ; boolean
      ;-----------------------------------------------------------------------
      ; Current
      ;-----------------------------------------------------------------------
      this.Ctl.loc.Text  := this.userName
      this.Ctl.temp.Text := tf "°"
      wsu                := this.mks ? " km/h " : " mph "
      sr                 := "☀↑  " StrLower(FormatTime(RegExReplace(this.List(day, "sunrise")[1] , "\D"), "h:mm tt"))   ; "7:22 am"
      ss                 := "🌙↓  " StrLower(FormatTime(RegExReplace(this.List(day, "sunset")[1] , "\D"), "h:mm tt"))   ; "7:22 am"
      this.Ctl.srss.Text := sr . "  " ss ; . "       " this.MoonPhase()
      this.Ctl.moon.Text := this.MoonPhase()
      hi                 := Round(this.List(day, "temperature_2m_max")[1])
      lo                 := Round(this.List(day, "temperature_2m_min")[1])
      this.Ctl.cond.Text := this.Codes.Get(code, "Code " code)
      this.Ctl.hilo.Text := "🡩" hi "° 🡫" lo "°" ; 45 is hand tuned
      cold := this.mks ? 4 : 40, hot := this.mks ? 32 : 90
      this.Ctl.detail.Text := (tf < cold ? "❄ " : tf > hot ? "🌡️ " : "") 
         . "Feels " Round(this.Value(cur, "apparent_temperature")) "°"
         . "   Hum " Round(this.Value(cur, "relative_humidity_2m")) "%"
         . "   Wind " Round(this.Value(cur, "wind_speed_10m")) . wsu . d
      ;-----------------------------------------------------------------------
      ; Hourly data starts at the current hour (forecast_hours), not midnight
      ;-----------------------------------------------------------------------
      times := this.List(hrs, "time")
      temps := this.List(hrs, "temperature_2m")
      pops  := this.List(hrs, "precipitation_probability")
      hums  := this.List(hrs, "relative_humidity_2m")
      winds := this.List(hrs, "wind_speed_10m")
      windg := this.List(hrs, "wind_gusts_10m")
      dirs  := this.List(hrs, "wind_direction_10m")
      codes := this.List(hrs, "weather_code")
      dns   := this.List(hrs, "is_day")
      RegExMatch(times[1], "T(\d+)", &m)
      h0    := Integer(m[1])      ; clock hour of array element 1
      ; Get the temperature range
      hrArray := []
      Loop temps.length {
         t := IsNumber(temps[A_Index]) ? Round(temps[A_Index]) : 0 ; if every 0 will through off range
         hrArray.push(t)
      }
      loHr := Min(hrArray*), hiHr := Max(hrArray*)
      i := 2
      rows := []
      while (A_Index <= this.maxRows && i <= temps.Length) {
         hr := Mod(h0 + i - 1, 24)   ; clock hour for this element
         dn := dns[i]
         t  := temps[i]
         p  := pops[i]
         w  := winds[i]
         g  := windg[i]
         h  := hums[i]
         a  := this.hourlyAQI.Get(times[i], "")   ; from AQI query, matched by hour
         d  := Compass(dirs[i])
         wcn := Integer(codes[i])
         if (wcn = 0 and !dn)
            wc := this.MoonPhase()
         else
            wc := this.emoji.get(wcn, "🌈")
         if A_Index == 1
            rows.Push([
               {t: "Time", span: 1, al: "Center", c:hc}, 
               {t: "Temp", span: 2, al: "Center", c:hc}, 
               {t: "AQI",  al: "Center", c:hc}, 
               {t: "Hum",  al: "Center", c:hc}, 
               {t: "Prec", al: "Center", c:hc}, 
               {t: "Wind" . wsu, span: 4, al: "Center", c:hc}
            ])
         rows.Push([
              { t: this.Hour12(hr), c: dn ? tcbright: tcdim}
            , { t: (IsNumber(t) ? this.fixfix(Round(t) "°") : "--"), c: cc && IsNumber(t) ? TempColor(Round(t), loHr, hiHr) : tc }
            , wc
            , IsNumber(a) ? {t: a, c: this.AqiColor(a)} : "--"
            , IsNumber(h) ? h "%" : "--"
            , IsNumber(p) ? p "%" : "--"
            , IsNumber(w) ? Round(w) : "--"
            , "-"
            , IsNumber(g) ? Round(g) : "--"
            , d
         ])
         i += this.hourIncrement
      }
      this.Ctl.hourly.SetRows(rows)
      ;-----------------------------------------------------------------------
      ; Daily Forecast
      ;-----------------------------------------------------------------------
      rnd := this.mks ? 0 : 1
      If (this.forecastDays) {
         days  := this.List(day, "time")
         tempMin := this.List(day, "temperature_2m_min")
         tempMax := this.List(day, "temperature_2m_max")
         rows := []
         lows := [], highs := []
         ; Stop after valid values, the model may not have returned what we requested, they would be null in the array
         daysAvailable := 0
         Loop this.forecastDays {
            l := tempMin[A_Index], h := tempMax[A_Index]
            if !IsNumber(l) || !IsNumber(h)
               break
            lows.Push(Round(l)), highs.Push(Round(h))
            daysAvailable++
         }
         If (daysAvailable) {
            loMin := Min(lows*), loMax := Max(lows*)
            hiMin := Min(highs*), hiMax := Max(highs*)
            ; bar track runs from the coldest low to the warmest high (and today's current temp, if outside that)
            this.Ctl.daily.SetBarScale(Min(loMin, tf), Max(hiMax, tf), this.TempStops)
         }
         winds := this.List(day, "wind_speed_10m_max")
         windg := this.List(day, "wind_gusts_10m_max")
         ; dirs  := this.List(day, "wind_direction_10m_dominant")
         preps := this.List(day, "precipitation_sum")
         snows := this.List(day, "snowfall_sum")
         codes := this.List(day, "weather_code")
         Loop daysAvailable {
            i := A_Index
            w := winds[i]
            g := windg[i]
            ; c := dirs[i]
            ; ― = HORIZONTAL BAR
            ; — = Em Dash, same as Horz bar
            If i == 1
               rows.Push([
                 { t: "Day", al: "Left", c: hc }
               , { t: "―――Temp―――", span: 4, al: "Center", c: hc }
               , { t: "-Prec-", span: 3, al: "Center", c: hc }
               , { t: "W" wsu, span: 2, al: "Center", c: hc }
               ])
            psum := IsNumber(preps[i]) ? Number(preps[i]) : 0 ; total water precepitation in / mm
            ssum := IsNumber(snows[i]) ? Number(snows[i]) : 0 ; total Snow in / cm
            ; TODO we could incorporate the weather code groupings for rain/snow
            ; NBM can report snowfall with 0.0 liquid precipitation, so snow wins in that case
            snowWE := this.mks ? ssum : ssum / 10 ; assumes 10:1 snow-to-water, as mm / in of water
            If (ssum > 0 && (psum < 0.01 || snowWE >= psum * 0.5))
               pVal := Round(ssum, rnd), pUnit := this.mks ? "㎝" : '"', pIcon := "❄", clr := tc
            Else If (psum >= 0.01)
               pVal := Round(psum, rnd), pUnit := this.mks ? "㎜" : '"', pIcon := "💧", clr := tc
            Else
               pVal := Round(0, rnd), pUnit := this.mks ? "㎜" : '"', pIcon := "", clr := tcdim
               
            gusting := g >= w + (this.mks ? 8 : 5) ? true : false

            rows.Push([
               i == 1 ? "Today" : FormatTime(Trim(StrReplace(days[i], '-'), '"'), "dd ddd")
               , { t: this.fixfix(lows[i] "°"), c: cc ? TempColor(lows[i], loMin, loMax) : tc }
               , { bar: i == 1 ? [lows[i], highs[i], tf] : [lows[i], highs[i]] }
               , { t: this.fixfix(highs[i] "°"), c: cc ? TempColor(highs[i], hiMin, hiMax) : tc }
               , this.emoji.get(Integer(codes[i]), "🌈")
               , { t: pVal, c: clr }
               , pUnit
               , pIcon
               , gusting ? Round(g, 0) : Round(w, 0)
               , gusting ? "🌀" : ""   ;💨🌀🍃
            ])
         }
         this.Ctl.daily.SetRows(rows)
      }
      ;-----------------------------------------------------------------------
      ; Updated footer
      ;-----------------------------------------------------------------------
      this.Ctl.updated.Text := "Updated " FormatTime(, "h:mm tt") "    Local Time " FormatTime(localNow, "MMM d, h:mm tt")
      ;-----------------------------------------------------------------------
      ; Condition ICON
      ;-----------------------------------------------------------------------
      If (this.Icons.has(code)) {
         Icon := this.Assets . this.Icons[code] . ".ico"
         ; Night time has some adjustments
         If (NOT isDay) {
            AltIcon := this.Assets . "Night " . this.Icons[code] . ".ico"
            if (FileExist(AltIcon))
               Icon := AltIcon
         }
         ; Only change if different
         If (Icon != this.ActiveIcon) {
            If (FileExist(Icon)) {
               TraySetIcon(Icon)
               this.Ctl.Icon.Value := Icon
               this.ActiveIcon := Icon
            } Else {
               OutputDebug("Missing expected Icon File:" Icon)
            }
         }
         A_IconTip := this.userName "`n" (Round(this.Value(cur, "temperature_2m")) . "° - " . this.Codes[code])
      }
      /**
       * Convert a wind direction to a 16-point arrow/compass label (arrow points where the wind blows to)
       * @param {Number | String} deg Direction the wind comes from, in degrees
       * @returns {String} Arrow label, or "?" if deg isn't a number
       */
      static Compass(deg) {
         if (!IsNumber(deg))
            return "?"
         return ["🡓","🡗N","🡗","🡗E","🡐","🡔E","🡔","🡔S","🡑","S🡕","🡕","W🡕","🡒","W🡖","🡖","N🡖"][Mod(Round(deg / 22.5), 16) + 1]
      }
      /**
       * Interpolate a color for a temperature along the Weather.TempStops gradient (cold -> hot)
       * @param {Number} v Temperature to color
       * @param {Number} lo Temperature mapped to the first (coldest) stop
       * @param {Number} hi Temperature mapped to the last (hottest) stop
       * @returns {Integer} 0xRRGGBB color (the midpoint if hi <= lo)
       */
      Static TempColor(v, lo, hi) {
       ; Static stops := ["0x74a2ec", "0x61cbc6", "0xe8ce78", "0xed837d"]
      ;  Static stops := ["0x89B4FA", "0xBAC2DE", "0xFAB387"]     ; soft blue -> pale neutral -> soft peach
         stops := Weather.TempStops
         n   := stops.Length - 1
         t   := hi > lo ? (v - lo) * n * 256 // (hi - lo) : n * 128   ; 0..n*256, one 256-wide segment per pair of stops
         seg := Min(t // 256, n - 1), f := t - seg * 256
         a   := stops[seg + 1], b := stops[seg + 2]
         r   := ((a >> 16 & 255) * (256 - f) + (b >> 16 & 255) * f) >> 8
         g   := ((a >> 8 & 255) * (256 - f) + (b >> 8 & 255) * f) >> 8
         bl  := ((a & 255) * (256 - f) + (b & 255) * f) >> 8
         Return (r << 16) | (g << 8) | bl
      }
   }
   /**
    * DPI of the monitor the widget is on
    * @returns {Integer} DPI (96 = 100%)
    */
   Static Dpi()               => DllCall("GetDpiForWindow", "Ptr", Weather.Gui.Hwnd, "UInt")
   /**
    * Extract the body of a flat JSON object by name (no nested objects)
    * @param {String} json JSON text
    * @param {String} name Object name, e.g. "current"
    * @returns {String} Text between the braces, or "" if not found
    */
   static Section(json, name) => RegExMatch(json, '"' name '":\{([^}]*)\}', &m) ? m[1] : ""
   /**
    * Extract a numeric value from JSON text
    * @param {String} sec JSON text (typically from Section)
    * @param {String} key Key name
    * @returns {String} The number as text, or "" if not found/not numeric
    */
   static Value(sec, key)     => RegExMatch(sec, '"' key '":(-?[\d.]+)', &m) ? m[1] : ""
   /**
    * Extract a JSON array as raw strings (nulls stay as "null", strings keep their quotes)
    * @param {String} sec JSON text (typically from Section)
    * @param {String} key Key name
    * @returns {Array} Array elements, or an empty array if not found
    */
   static List(sec, key)      => RegExMatch(sec, '"' key '":\[([^\]]*)\]', &m) ? StrSplit(m[1], ",") : []
   /**
    * Format a 24-hour clock hour as 12-hour time
    * @param {Integer} h Hour (wraps modulo 24)
    * @returns {String} e.g. "12 AM", "3 PM"
    */
   static Hour12(h)           => ((h := Mod(h, 24)) = 0 ? 12 : h > 12 ? h - 12 : h) (h < 12 ? " AM" : " PM")
   /**
    * Swap spaces and hyphens for fixed-width (figure) equivalents so numbers line up in the grids
    * @param {String} st Text to convert
    * @returns {String} Converted text
    */
   static fixfix(st)          => StrReplace(StrReplace(st," "," "),"-","‒")

   /**
    * Brighten (pct > 0) or dim (pct < 0) a color while keeping the channel ratios, so the hue is unchanged.
    * Brightening stops when the brightest channel reaches 255 instead of clipping channels individually.
    * +pct is the inverse of -pct (+25 = x1.333, -25 = x0.75) until the cap is hit.
    * @param {Integer} rgb 0xRRGGBB
    * @param {Integer} pct -100..100 (-100 = black; +100 = the fully bright version of the same hue)
    * @returns {Integer} 0xRRGGBB
    */
   Static ScaleBrightness(rgb, pct) {
      pct := Max(-100, Min(100, pct))
      r := (rgb >>> 16) & 0xFF, g := (rgb >>> 8) & 0xFF, b := rgb & 0xFF
      m := Max(r, g, b)
      If (m = 0)
         Return rgb                                   ; black has no hue to preserve
      If (pct >= 0)
         num := 100, den := 100 - Min(pct, 99)
      Else
         num := 100 + pct, den := 100
      If (m * num > 255 * den)                        ; would clip: limit so the brightest channel lands on 255
         num := 255, den := m
      half := den >> 1                                ; round to nearest
      r := (r * num + half) // den
      g := (g * num + half) // den
      b := (b * num + half) // den
      Return (r << 16) | (g << 8) | b
   }
   /**
    * Round the corners of the GUI on Windows 11 (build 22000+), ignored on Windows 10.
    * Also draws a rounded border. Needed since we don't have a caption.
    * @param {Integer} hWnd Window handle
    * @param {Integer} how DWM_WINDOW_CORNER_PREFERENCE: 1 = no rounding, 2 = round, 3 = round small
    */
   Static Round11Corners(hWnd, how := 2) {
      howRound := how
      ; round corners on windows 11, ignored by windows 10
      ; DWMWA_WINDOW_CORNER_PREFERENCE = 33
      ; DWMWCP_ROUND=2, 4 = size of int
      DllCall("dwmapi\DwmSetWindowAttribute"
         , "Ptr", hWnd
         , "UInt", DWMWA_WINDOW_CORNER_PREFERENCE := 33
         , "Int*", &howRound
         , "UInt", 4)

   }   
   /**
    * Give the captionless window the standard Windows 11 drop shadow (and border)
    * by enabling DWM non-client rendering and extending the frame by 1px.
    * Doesn't work on layered windows.
    * @param {Integer} hwnd Window handle
    */
   Static DropShadow(hwnd) {
      policy := 2   ; DWMNCRP_ENABLED
      DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 2, "Int*", &policy, "UInt", 4)
      mar := Buffer(16, 0)
      NumPut("Int", 1, "Int", 1, "Int", 1, "Int", 1, mar)
      DllCall("dwmapi\DwmExtendFrameIntoClientArea", "Ptr", hwnd, "Ptr", mar)
   }

   /**
    * Tray icon message handler (0x404). Left-click shows the window and snaps it on-screen;
    * Ctrl+left-click hides it.
    * @param {Integer} wParam Tray icon id
    * @param {Integer} lParam Mouse message (e.g. 0x202 = WM_LBUTTONUP)
    * @param {Integer} uMsg Message number
    * @param {Integer} hWnd Script window handle
    */
   Static TrayMessage(wParam, lParam, uMsg, hWnd) {
      ; debug(hex(lParam))
      Switch lParam {
         Case 0x201:   ; user left-clicked tray icon
            ; Send "#{Tab}"
         Case 0x202:   ; user left-clicked tray icon
            If (GetKeyState("Ctrl", "P"))
               this.Gui.hide()
            Else {
               this.Gui.show()
               this.SnapToWorkArea(this.Gui, "", "", "")
            }
         Case 0x203:   ; user double left-clicked tray icon
         Case 0x204:   ; user right-clicked tray icon
         Case 0x208:   ; user middle-clicked tray icon
         Default:
      }
   }
   /**
    * Determine if a window has the WS_VISIBLE style
    * @param {Integer} hwndTry Window handle
    * @returns {Integer} Nonzero if visible
    */
   Static IsWindowVisible(hwndTry) => DllCall("User32.dll\IsWindowVisible", "Ptr", hwndTry)
   /**
    * Trim this process's working set to reduce reported memory use
    * @returns {Integer} Nonzero on success
    */
   Static PruneMemory() => DllCall("psapi\EmptyWorkingSet", "ptr", -1)

   /**
    * Resolve a location name to coordinates, using the ini cache first and OpenStreetMap Nominatim otherwise.
    * If userName is blank, prompts the user (pre-filled with an IP-based guess).
    * @param {String} userName Name of the location
    * @returns {Object | Boolean} {userName, fullName, lat, lon, CC, Model, cached}, or false on failure/cancel
    */
   Static GeocodeName(userName) {
      If (!userName) {
         default := this.GetLocalPlaceName()
         res := InputBox("Enter Default Weather Location`nAn estimated location is shown below`nModify as needed", "Weather Locaiton Needed",,default)
         If (res.Result = "Ok") {
            userName := res.Value
         } else {
            return false
         }
      }
      ; See if location is cached
      lat      := IniRead(this.iniFile, userName, "Lat", "")
      lon      := IniRead(this.iniFile, userName, "Lon", "")
      CC       := IniRead(this.iniFile, userName, "CC", "us")
      fullName := IniRead(this.iniFile, userName, "FullName", "")
      Model    := IniRead(this.iniFile, userName, "Model", "")
      if (IsNumber(lon) AND IsNumber(lat))
         return {userName:userName, fullName:fullName, lat: Round(lat,7), lon: Round(lon,7), CC: CC, Model: Model, cached:1}
      ; Query location data from openstreetmap
      url := "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&q=" UriEncode(userName)
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(5000, 5000, 10000, 10000)
         http.Open("GET", url, false)
         http.SetRequestHeader("User-Agent", "AHK2-GeoLookup/1.0")   ; required by Nominatim
         http.Send()
         txt := http.ResponseText
      } catch
         return false

      if !RegExMatch(txt, '"lat":"(-?[\d.]+)"', &mLat)
      || !RegExMatch(txt, '"lon":"(-?[\d.]+)"', &mLon)
         return false   ; empty result "[]"

      RegExMatch(txt, '"display_name":"((?:[^"\\]|\\.)*)"', &mName)
      RegExMatch(txt, '"country_code":"([a-z]{2})"', &mCC)
      return {userName:userName, fullName:mName ? mName[1] : userName, lat: Round(mLat[1],7), lon: Round(mLon[1],7), CC: mCC ? mCC[1] : "", Model:Model, cached:0}

      /**
       * Percent-encode a string as UTF-8 for use in a URL query (RFC 3986 unreserved chars kept)
       * @param {String} s Text to encode
       * @returns {String} Encoded text
       */
      UriEncode(s) {
         n := StrPut(s, "UTF-8") - 1
         buf := Buffer(n + 1)
         StrPut(s, buf, "UTF-8")
         out := ""
         Loop n {
            b := NumGet(buf, A_Index - 1, "UChar")
            if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
            || b = 45 || b = 46 || b = 95 || b = 126
               out .= Chr(b)
            else
               out .= Format("%{:02X}", b)
         }
         return out
      }   
   }
   /**
    * Estimate the current location from the public IP address (ipwho.is)
    * @returns {String} "City, Region, Country", or "" if the lookup fails
    */
   Static GetLocalPlaceName() {
      try {
         whr := ComObject("WinHttp.WinHttpRequest.5.1")
         whr.SetTimeouts(5000, 5000, 10000, 10000)
         whr.Open("GET", "https://ipwho.is/?fields=success,city,region,country", false)
         whr.Send()
         txt := whr.ResponseText
      } catch
         Return ""
      If !RegExMatch(txt, '"success":\s*true')
         Return ""
      place := ""
      For key in ["city", "region", "country"]
         If RegExMatch(txt, '"' key '":\s*"((?:[^"\\]|\\.)*)"', &m) && m[1] != ""
            place .= (place = "" ? "" : ", ") m[1]
      Return place
   }
   /**
    * Refresh the GUI without it flashing
    * Native controls have transparent backgrounds, so they need refresh when updated
    * Once that is done call the D2D refresh for the D2D based controls
    * If we just invalidate the whole GUI, the native controls will temporally flash
    */
   Static RefreshMe() {
      ; Refresh the native controls only
      Weather.RefreshNative() ; needed for when widget is on a disabled screen, background doesn't always erase
      ; Refresh the D2D controls
      D2DText.RefreshAll(this.Gui)
   } 
   /**
    * Erase and invalidate only the transparent native text/picture controls, then repaint
    * them in a single UPDATENOW pass. D2D controls clear themselves.
    */
   Static RefreshNative() {
      hG := this.Gui.Hwnd
      rc := Buffer(16)
      For name, ctl in this.Ctl.OwnProps() {
         If !(ctl is Gui.Text OR ctl is Gui.PIC)
            Continue
         DllCall("GetWindowRect", "Ptr", ctl.Hwnd, "Ptr", rc)
         DllCall("MapWindowPoints", "Ptr", 0, "Ptr", hG, "Ptr", rc, "UInt", 2)   ; screen -> client
         DllCall("RedrawWindow", "Ptr", hG, "Ptr", rc, "Ptr", 0, "UInt", 0x0001|0x0004|0x0080)   ; INVALIDATE|ERASE|ALLCHILDREN
      }
      DllCall("RedrawWindow", "Ptr", hG, "Ptr", 0, "Ptr", 0, "UInt", 0x0100|0x0080)   ; one UPDATENOW pass for everything queued
   }   
   /**
    * Update the active location name (and its label) after it was renamed in LocationManager
    * @param {String} newName New location name to use
    */
   Static ChangeActiveLocationName(newName) {
      this.userName := newName
      this.Ctl.loc.Text := newName
   }

   /**
    * Path of this program's shortcut in the user's Startup folder
    * @returns {String}
    */
   Static StartupLink => A_Startup "\" RegExReplace(A_ScriptName, "\.[^.]+$") ".lnk"
   /**
    * True only if the startup shortcut exists and points at this EXE
    * (a stale shortcut from a moved EXE reads as disabled)
    * @returns {Boolean}
    */
   Static StartupEnabled {
      Get {
         If !FileExist(this.StartupLink)
            Return false
         Try FileGetShortcut(this.StartupLink, &target)
         Catch
            Return false
         Return target = A_ScriptFullPath
      }
   }

   /**
    * Add or remove the startup shortcut
    * @param {Boolean} enable true = create/refresh, false = delete
    * @returns {Boolean} true on success
    */
   Static SetStartup(enable) {
      link := this.StartupLink
      Try {
         If (enable)
            FileCreateShortcut(A_ScriptFullPath, link, A_ScriptDir, , "Weather Widget")
         Else If FileExist(link)
            FileDelete(link)
      } Catch
         Return false
      Return true
   }   
}
/**
 * Register for session lock/unlock, suspend/resume, display power and display change
 * notifications, pausing updates while locked/off and refreshing promptly when the user returns.
 * Handlers are unregistered on exit.
 */
SetupEventMonitoring() {
   Static WM_POWERBROADCAST     := 0x0218
   Static WM_DISPLAYCHANGE      := 0x7E
   Static WM_WTSSESSION_CHANGE  := 0x2B1
   Static hwndNotification      := 0
   Static sessionNotificationOK := 0
   Static hDisplay              := 0
   ; Registers to receive notification when the system is suspended or resumed
   hwndNotification := DllCall("RegisterSuspendResumeNotification", "Ptr", A_ScriptHwnd, "UInt", 0, "Ptr")
   ; Registers the specified window to receive session change notifications
   sessionNotificationOK := DllCall("Wtsapi32\WTSRegisterSessionNotification", "Ptr", A_ScriptHwnd, "UInt", 0) ; NOTIFY_FOR_THIS_SESSION = 0
   ; GUID_CONSOLE_DISPLAY_STATE on, off or dimmed
   DllCall("ole32\CLSIDFromString", "Str", "{6FE69556-704A-47A0-8F24-C28D936FDA47}", "Ptr", guid := Buffer(16))
   hDisplay := DllCall("RegisterPowerSettingNotification", "Ptr", A_ScriptHwnd, "Ptr", guid, "UInt", 0, "Ptr")   ; DEVICE_NOTIFY_WINDOW_HANDLE

   ; Message Handelers are closures
   OnMessage(WM_POWERBROADCAST, cbPowerChangeEvent)
   OnMessage(WM_WTSSESSION_CHANGE, cbSessionChange)
   OnMessage(WM_DISPLAYCHANGE, cbDisplayChange)   ; WM_DISPLAYCHANGE

   OnExit UnRegisterHandlers
   Return
   /**
    * WM_WTSSESSION_CHANGE handler: stop updates on lock, refresh shortly after unlock
    * @param {Integer} wParam Session change event (WTS_SESSION_LOCK / WTS_SESSION_UNLOCK)
    * @param {Integer} lParam Session id
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Receiving window handle
    */
   cbSessionChange(wParam, lParam, msg, hwnd) {
      Static WTS_SESSION_LOCK := 0x7, WTS_SESSION_UNLOCK := 0x8
      If (wParam = WTS_SESSION_LOCK) {
         OutputDebug("WeatherWidget: Session Change : Locked")
         SetTimer(Weather.cbUpdateData, 0)
      } Else If (wParam = WTS_SESSION_UNLOCK) {
         OutputDebug("WeatherWidget: Session Change : Unlocked")
         SetTimer(Weather.cbUpdateData, -2000)
         SetTimer(Weather.cbRefreshMe, -8000)   ; let the display stack settle first
      }
   }
   /**
    * WM_POWERBROADCAST handler: refresh after resume from sleep, and stop/resume updates
    * when the console display turns off/on (GUID_CONSOLE_DISPLAY_STATE)
    * @param {Integer} wParam Power event (PBT_*)
    * @param {Integer} lParam Pointer to POWERBROADCAST_SETTING for PBT_POWERSETTINGCHANGE
    * @param {Integer} Msg Message number
    * @param {Integer} hWnd Receiving window handle
    */
   cbPowerChangeEvent(wParam, lParam, Msg, hWnd) {
      Static PBT_APMRESUMESUSPEND := 0x7, PBT_APMRESUMEAUTOMATIC := 0x12
      Static PBT_POWERSETTINGCHANGE := 0x8013
      Switch wParam {
         Case PBT_APMRESUMESUSPEND, PBT_APMRESUMEAUTOMATIC:
            SetTimer(Weather.cbUpdateData, -15000)
            SetTimer(Weather.cbRefreshMe, -5000)   ; let the display stack settle first
            OutputDebug("WeatherWidget: Resume from Standby")
         Case PBT_POWERSETTINGCHANGE: ; Monitor power times out
            if ((A_TickCount - Weather.Launched) < 5000)
               Return
            ; GUID_SESSION_DISPLAY_STATUS
            ; Is this notification for GUID_CONSOLE_DISPLAY_STATE?"
            ; GUID_CONSOLE_DISPLAY_STATE {6FE69556-704A-47A0-8F24-C28D936FDA47}
            If NumGet(lParam, 0, "Int64") != 0x47A0704A6FE69556
            || NumGet(lParam, 8, "Int64") != 0x47DA6F938DC2248F
               Return            
            ; Check for POWERBROADCAST_SETTING
            ; GUID (16) + DataLength (4) + Data (4)
            If NumGet(lParam, 16, "UInt") != 4
               Return
            ; Read GUID_SESSION_DISPLAY_STATUS
            state := NumGet(lParam, 20, "UInt") 
            Switch state {
               Case 1 : ; Monitor power on
                  SetTimer(Weather.cbRefreshMe, -2000)   ; let the display stack settle first
                  SetTimer(Weather.cbUpdateData, -6000)
                  OutputDebug("WeatherWidget: Monitor Power Coming back on")
               Case 0 : ; Monitor power off, prevent updates
                  SetTimer(Weather.cbUpdateData, 0)
                  OutputDebug("WeatherWidget: Monitor Power going off")
               Default :
            }
         Default:
      }
   }
   /**
    * WM_DISPLAYCHANGE handler: refresh the data and repaint the GUI after the display settles
    * @param {Integer} wParam New bit depth
    * @param {Integer} lParam New resolution (low word is width, high word is height)
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Receiving window handle
    */
   cbDisplayChange(wParam, lParam, msg, hwnd) {
      SetTimer(Weather.cbRefreshMe, -8000)   ; let the display stack settle first
      SetTimer(Weather.cbUpdateData, -2000)
      Return
   }
   /**
    * OnExit callback: unregister the notifications and message handlers set up above
    * @param {String} ExitReason Reason the script is exiting
    * @param {Integer} ExitCode Exit code
    */
   UnRegisterHandlers(ExitReason, ExitCode) {
      if (sessionNotificationOK)
         DllCall("Wtsapi32.dll\WTSUnRegisterSessionNotification", "ptr", A_ScriptHwnd)
      If (hwndNotification)
         DllCall("UnregisterSuspendResumeNotification", "ptr", hwndNotification)
      If (hDisplay)
         DllCall("UnregisterPowerSettingNotification", "Ptr", hDisplay)         
      OnMessage(WM_POWERBROADCAST, cbPowerChangeEvent,0)
      OnMessage(WM_WTSSESSION_CHANGE, cbSessionChange,0)
      OnMessage(WM_DISPLAYCHANGE, cbDisplayChange,0)   ; WM_DISPLAYCHANGE
   }
}

class MenuDarkMode {
   /**
    * Set the app's menu theme via undocumented uxtheme ordinals (SetPreferredAppMode/FlushMenuThemes)
    * @param {Integer} mode 0 Default, 1 AllowDark (follows system), 2 ForceDark, 3 ForceLight
    */
   static Enable(mode := 2) {   ; 0 Default, 1 AllowDark (follows system), 2 ForceDark, 3 ForceLight
      static hMod := DllCall("LoadLibrary", "Str", "uxtheme", "Ptr")
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 135, "Ptr"), "Int", mode)
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 136, "Ptr"))
   }
}
/*
 * Class to manage thw weather widget locations
*/
class LocationManager {
   static IniFile := A_ScriptDir "\WeatherWidget.ini"
   static Section := "Locations"
   static Items := []
   static Gui := ""
   static LB := ""
   static Edit := ""

   static InitW := 430
   static InitH := 340
   static Margin := 10
   static Gap := 5

   /**
    * Show the location manager window, creating it on first use (or re-showing it if already open)
    */
   static Show() {
      if this.Gui {
         this.Gui.Show()
         return
      }
      this.Load()
      g := this.Gui := Gui("+Resize", "Manage Weather Locations")
      g.SetFont("s10")
      this.LB        := g.AddListBox("r15")
      this.BtnUp     := g.AddButton("w90 left", "🡅 Move &Up")
      this.BtnDown   := g.AddButton("w90 left", "🡇 Move &Down")
      this.BtnSelect := g.AddButton("w90 left", "◀ &Select")
      this.BtnRemove := g.AddButton("w90 left", "✂ &Remove")
      this.BtnRename := g.AddButton("w90 left", "✎ Re&name")      
      this.Edit      := g.AddEdit()
      this.BtnAdd    := g.AddButton("w85 Default", "🡄 &Add")
      this.BtnClose  := g.AddButton("w85", "&Close")

      this.BtnUp.OnEvent("Click", this.Move.Bind(this, -1))
      this.BtnDown.OnEvent("Click", this.Move.Bind(this, 1))
      this.BtnRemove.OnEvent("Click", this.Remove.Bind(this))
      this.BtnRename.OnEvent("Click", this.Rename.Bind(this))
      this.BtnSelect.OnEvent("Click", this.Select.Bind(this))
      this.BtnAdd.OnEvent("Click", this.Add.Bind(this))
      this.BtnClose.OnEvent("Click", this.Close.Bind(this))

      g.OnEvent("Close", this.Close.Bind(this))
      g.OnEvent("Escape", this.Close.Bind(this))
      g.OnEvent("Size", this.Size.Bind(this))

      this.PlaceControls(this.InitW, this.InitH)
      this.RefreshListBox()
      g.Opt("+MinSize" this.InitW "x" this.InitH)
      g.Show("w" this.InitW " h" this.InitH)
   }

   /**
    * Lay out the controls for the given client size: list box filling the left,
    * button column on the right, edit box and Add/Close buttons along the bottom
    * @param {Integer} w Client width
    * @param {Integer} h Client height
    */
   static PlaceControls(w, h) {
      m := this.Margin, gap := this.Gap
      this.BtnUp.GetPos(, , &bw, &bh)         ; right column button size
      this.BtnAdd.GetPos(, , &bw2)            ; bottom row button width
      this.Edit.GetPos(, , , &eh)

      rightX := w - m - bw                    ; right button column
      rowY   := h - m - bh                      ; bottom row
      closeX := w - m - bw2
      addX   := closeX - gap - bw2

      this.LB.Move(m, m, rightX - gap - m, rowY - gap - m)
      this.BtnUp.Move(rightX, m)
      this.BtnDown.Move(rightX, m + (bh + gap))
      this.BtnSelect.Move(rightX, m + (bh + gap) * 2)
      this.BtnRemove.Move(rightX, m + (bh + gap) * 3)
      this.BtnRename.Move(rightX, m + (bh + gap) * 4)
      this.Edit.Move(m, rowY + (bh - eh) // 2, addX - gap - m)
      this.BtnAdd.Move(addX, rowY)
      this.BtnClose.Move(closeX, rowY)
   }

   /**
    * GUI Size event: re-layout the controls unless minimized
    * @param {Gui} gui The GUI
    * @param {Integer} minMax -1 minimized, 1 maximized, 0 otherwise
    * @param {Integer} w New client width
    * @param {Integer} h New client height
    */
   static Size(gui, minMax, w, h) {
      if minMax != -1                         ; skip minimize
         this.PlaceControls(w, h)
   }

   /**
    * Close button / Close / Escape event: destroy the window
    */
   static Close(*) {
      this.Gui.Destroy()
      this.Gui := ""
   }

   /**
    * Read the whole ini file, reporting its encoding so it can be written back the same way
    * @param {VarRef} enc Receives the file encoding (with -RAW appended if the file has no BOM)
    * @returns {String} File contents, or "" if the file doesn't exist
    */
   static ReadText(&enc) {
      enc := "UTF-16"   ; used if the file doesn't exist yet
      if !FileExist(this.IniFile)
         return ""
      f := FileOpen(this.IniFile, "r")
      enc := f.Encoding
      if f.Pos = 0 && InStr(enc, "UTF") && !InStr(enc, "RAW")
         enc .= "-RAW"   ; no BOM in the original, so don't add one
      text := f.Read()
      f.Close()
      return text
   }

   /**
    * Load the location list from the ini file's Locations section into Items, dropping duplicates
    */
   static Load() {
      this.Items := []
      dupCheck := Map()
      inSec := false
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         line := Trim(line)
         if RegExMatch(line, "^\[[^\]]+\]$") {
            inSec := (line = "[" this.Section "]")
            continue
         }
         If inSec && line != "" {
            If !(dupCheck.has(line)) {
               this.Items.Push(line)
               dupCheck[line] := 1
            }
         }
      }
   }

   /**
    * Write Items back to the ini file's Locations section (creating it if missing),
    * preserving all other sections and the original encoding
    */
   static Save() {
      out := ""
      skipping := found := false
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         t := Trim(line)
         if RegExMatch(t, "^\[[^\]]+\]$") {
            skipping := false
            out .= (out = "" ? "" : "`r`n") line "`r`n"   ; blank line before every header except the first
            if t = "[" this.Section "]" {
               found := skipping := true
               for item in this.Items
                  out .= item "`r`n"
            }
         }
         else if !skipping && t != ""
            out .= line "`r`n"
      }
      if !found {
         out .= (out = "" ? "" : "`r`n") "[" this.Section "]`r`n"
         for item in this.Items
            out .= item "`r`n"
      }
      f := FileOpen(this.IniFile, "w", enc)
      f.Write(out)
      f.Close()
   }

   /**
    * Reload the list box from Items and optionally select a row
    * @param {Integer} sel 1-based row to select, or 0 for none
    */
   static RefreshListBox(sel := 0) {
      this.LB.Delete()
      if this.Items.Length
         this.LB.Add(this.Items)
      if sel
         this.LB.Choose(sel)
   }

   /**
    * Add button: validate the location in the edit box by geocoding it, cache it and append it to the list.
    * Rejects blanks and duplicates (case-insensitive).
    */
   static Add(*) {
      userName := Trim(this.Edit.Value)
      if userName = ""
         return
      for item in this.Items {
         if item = userName {   ; case-insensitive duplicate check
            MsgBox("Already in the list.", "Duplicate", "Icon!")
            return
         }
      }
      ; Validate via URL
      If (obj := Weather.GeocodeName(userName)) {
         ; Cache location to INI file
         Weather.cacheUserLocation(obj)
         ; Save the new location
         this.Items.Push(userName)
         this.Save()
         this.RefreshListBox(this.Items.Length)
         this.Edit.Value := ""
         this.Edit.Focus()
      } Else {
         MsgBox("Could not find location " userName,,0x10)
      }
   }

   /**
    * Remove button: delete the selected location from the list and remove its cached ini section
    */
   static Remove(*) {
      i := this.LB.Value
      place := this.LB.Text
      if !i
         return
      this.Items.RemoveAt(i)
      this.Save()
      this.RefreshListBox(Min(i, this.Items.Length))
      IniDelete(Weather.iniFile, place)
   }
   /**
    * Select button: make the selected location the active one in the widget
    */
   static Select(*) {
      i := this.LB.Value
      if !i
         return
      Weather.SetLocation(this.Items[i],"","")
   }
   /**
    * Rename button: prompt for a new name and rename the location everywhere in the ini file
    * (its own section, the Locations list and any Loc= entries), updating the widget if it is active
    */
   static Rename(*) {
      i := this.LB.Value
      if !i
         return
      this.Gui.Opt("+OwnDialogs")
      oldName := this.Items[i]
      ib := InputBox("New name for this location:", "Rename Location", "w320 h110", oldName)
      if ib.Result != "OK"
         return
      newName := Trim(ib.Value)
      if newName = "" || newName == oldName
         return
      for j, item in this.Items {
         if j != i && item = newName {   ; case-insensitive duplicate check
            MsgBox("Already in the list.", "Duplicate", "Icon!")
            return
         }
      }
      ; Rename all locations in the INI File
      out := ""
      section := ""
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         t := Trim(line)
         if RegExMatch(t, "^\[([^\]]+)\]$", &m) {
            section := m[1]
            if section = oldName               ; location's own section
               line := "[" newName "]"
         }
         else if section = this.Section && t = oldName   ; entry in the Locations list
            line := newName
         else if RegExMatch(line, "i)^(\s*Loc\s*=\s*)(.*?)\s*$", &m) && m[2] = oldName
            line := m[1] newName               ; Loc=<oldname> in any section
         out .= (A_Index = 1 ? "" : "`r`n") line
      }
      f := FileOpen(this.IniFile, "w", enc)
      f.Write(out)
      f.Close()
      ; If old entry was active, update to new name
      if (this.Items[i] == Weather.UserName)
         Weather.ChangeActiveLocationName(newName)
      this.Items[i] := newName
      this.RefreshListBox(i)
   }
   /**
    * Move Up/Down buttons: swap the selected location with its neighbor and save
    * @param {Integer} dir -1 to move up, 1 to move down
    */
   static Move(dir, *) {
      i := this.LB.Value
      j := i + dir
      if !i || j < 1 || j > this.Items.Length
         return
      tmp := this.Items[i]
      this.Items[i] := this.Items[j]
      this.Items[j] := tmp
      this.Save()
      this.RefreshListBox(j)
   }
}
/**
 * Inclusive numeric range enumerator for use in a for loop, e.g. `for i in Range(0, 15, 5)`
 * @param {Number} Start First value
 * @param {Number} Stop Last value (inclusive)
 * @param {Number} Step Increment (may be negative)
 * @returns {Func} Enumerator function
 */
Range(Start, Stop, Step := 1) => (&n) => (n := Start, Start += Step, Step > 0 ? n <= Stop : n >= Stop)

; Start things up here
MenuDarkMode.Enable(1)   ; use 1 to follow the system theme instead of forcing dark
Weather.Init()
SetupEventMonitoring()

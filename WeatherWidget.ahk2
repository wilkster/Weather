;@Ahk2Exe-SetName Weather
;@Ahk2Exe-SetDescription Weather App
;@Ahk2Exe-Set Comments, Weather
;@Ahk2Exe-SetVersion 2026.10.12
;@Ahk2Exe-SetCopyright Copyright (c) 2026 Tom Wilkason
;@Ahk2Exe-SetOrigFilename Weather.exe
;@Ahk2Exe-SetMainIcon Partly Cloudy.ico
#SingleInstance Off
#Requires AutoHotkey v2.1-
#include DirectWriteClass.ahk2
/*
TODO
- seems to stay on all desktops, this is desired
- Don't make static so would could have multiple instances at once for different locations
  Pass in location name into __Init
- Consider differnt layouts like MAC OS weather widget
- https://github.com/Makin-Things/weather-icons (SVG, some are animated)
*/

class Weather {
   static Lat           := 0.0
   static Lon           := 0.0
   static CC            := ""
   static Name          := ""
   static Interval      := 30 ; minutes
   /** @type {Gui} */
   static Gui           := ""
   static Ctl           := {}
   static Menu          := ""
   Static ActiveIcon    := ""
   Static forecastDays  := 2
   Static hourIncrement := 3
   Static maxRows       := 8
   Static OnTop         := 0
   Static mks           := 0
   Static fontScaleFactor := 1
   Static ColorCodeDaily := 1
   Static Assets        := A_ScriptDir . "\Assets\"
  /*
      WMO Weather Codes Reference
      Code	      Description
      0	         Clear sky
      1, 2, 3	   Mainly clear, partly cloudy, and overcast
      45, 48	   Fog and depositing rime fog
      51, 53, 55	Drizzle: Light, moderate, and dense intensity
      56, 57	   Freezing Drizzle: Light and dense intensity
      61, 63, 65	Rain: Slight, moderate and heavy intensity
      66, 67	   Freezing Rain: Light and heavy intensity
      71, 73, 75	Snow fall: Slight, moderate, and heavy intensity
      77	         Snow grains
      80, 81, 82	Rain showers: Slight, moderate, and violent
      85, 86	   Snow showers slight and heavy
      95	         Thunderstorm: Slight or moderate
      96, 99	   Thunderstorm with slight and heavy hail

   */
   static Codes    := Map(
      0,  "Clear",
      1,  "Mainly clear",
      2,  "Partly cloudy",
      3,  "Overcast",
      45, "Fog",
      48, "Rime fog",
      51, "Light drizzle",
      53, "Drizzle",
      55, "Heavy drizzle",
      56, "Light Freezing drizzle",
      57, "Dense Freezing drizzle",
      61, "Light rain",
      63, "Rain",
      65, "Heavy rain",
      66, "Light Freezing rain",
      67, "Heavy Freezing rain",
      71, "Light snow",
      73, "Snow",
      75, "Heavy snow",
      77, "Snow grains",
      80, "Light showers",
      81, "Showers",
      82, "Heavy showers",
      85, "Snow showers",
      86, "Heavy snow showers",
      95, "Thunderstorm",
      96, "Thunderstorm, hail",
      97, "Thunderstorm",
      99, "Heavy Thunderstorm, hail"
   )
   Static Icons := Map(
      0, "Clear",               ;"Clear",
      1, "Light Clouds",        ;"Mainly clear",
      2, "Partly Cloudy",       ;"Partly cloudy",
      3, "Overcast",            ;"Overcast",
      45, "Fog",                ;"Fog",
      48, "Fog",                ;"Rime fog",
      51, "Drizzle",            ;"Light drizzle",
      53, "Drizzle",            ;"Drizzle",
      55, "Drizzle",            ;"Heavy drizzle",
      56, "Freezing drizzle",   ;"Freezing drizzle",
      57, "Freezing drizzle",   ;"Freezing drizzle",
      61, "Light Showers",      ;"Light rain",
      63, "Rain",               ;"Rain",
      65, "Rain",               ;"Heavy rain",
      66, "Freezing rain",      ;"Freezing rain",
      67, "Freezing rain",      ;"Freezing rain",
      71, "Light Snow",         ;"Light snow",
      73, "Snow",               ;"Snow",
      75, "Heavy Snow",         ;"Heavy snow",
      77, "Snow",               ;"Snow grains",
      80, "Light Showers",      ;"Light showers",
      81, "Light Showers",      ;"Showers",
      82, "Rain",               ;"Heavy showers",
      85, "Snow",               ;"Snow showers",
      86, "Snow",               ;"Heavy snow showers",
      95, "Thunderstorm",       ;"Thunderstorm",
      96, "Thunderstorm",       ;"Thunderstorm, hail",
      97, "Thunderstorm",       ;"Heavy Thunderstorm",
      99, "Thunderstorm"        ;"Thunderstorm, hail"
   )
   Static emoji := map(
       0, "☀️",         ;"Clear",
       1, "🌤️",        ;"Mainly clear",
       2, "⛅",        ;"Partly cloudy",
       3, "☁️",         ;"Overcast",
      45, "🌫️",        ;"Fog",
      48, "🌫️",        ;"Rime fog",
      51, "🌦️",        ;"Light drizzle",
      53, "🌧️",        ;"Drizzle",
      55, "☔",       ;"Heavy drizzle",
      56, "🧊",       ;"Freezing drizzle",
      57, "🧊",       ;"Freezing drizzle",
      61, "🌦️",       ;"Light rain",
      63, "🌧️",        ;"Rain",
      65, "☔",        ;"Heavy rain",
      66, "🧊",        ;"Freezing rain",
      67, "🧊",        ;"Freezing rain",
      71, "🌨️",        ;"Light snow",
      73, "❄",        ;"Snow",
      75, "⛄",       ;"Heavy snow",
      77, "🌨️",        ;"Snow grains",
      80, "🌦️",       ;"Light showers",
      81, "🌦️",       ;"Showers",
      82, "⛈️",        ;"Heavy showers",
      85, "❄",        ;"Snow showers",
      86, "⛄",        ;"Heavy snow showers",
      95, "🌩️",        ;"Thunderstorm",
      96, "⛈️",        ;"Thunderstorm, hail",
      97, "🌩️",        ;"Heavy Thunderstorm",
      99, "⛈️"         ;"Thunderstorm, hail"
   )
   /**
    * Called during program startup
    */
   static Init() {
      this.Menu := Menu()
      this.iniFile := A_ScriptDir "\WeatherWidget.ini"
      this.NeedGeo := 1
      this.hourlyAQI := Map()
      this.Launched := A_TickCount

      ; Set default locations
      this.Name := IniRead(this.iniFile, A_ComputerName, "Loc", "")
      If (obj := this.GeocodeName(this.Name)) {
         this.Lat     := obj.lat
         this.Lon     := obj.lon
         this.CC      := obj.CC
         ; Default was initially used
         ; name is long name from geocide
         ; place is term user used for search and will be the tag
         If (this.Name != obj.Place) {
            IniWrite(obj.Place, this.iniFile, A_ComputerName, "Loc")
            IniWrite(obj.Place, this.iniFile, "Locations")
            IniWrite(obj.CC, this.iniFile, obj.Place, "CC")
            IniWrite(obj.Lat, this.iniFile, obj.Place, "Lat")
            IniWrite(obj.Lon, this.iniFile, obj.Place, "Lon")
            IniWrite(obj.Name, this.iniFile, obj.Place, "FullName")
         }
         this.Name    := obj.Place
         this.NeedGeo := 0
      } Else {
         if (MsgBox("Failed to set a location for weather, do you want to continue?",,0x4) = "No") 
            ExitApp()
      }
      this.Interval        := Integer(IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30))
      this.OnTop           := Integer(IniRead(this.iniFile, A_ComputerName, "OnTop", this.OnTop))
      this.MKS             := Integer(IniRead(this.iniFile, A_ComputerName, "MKS", this.MKS))
      this.forecastDays    := Integer(IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays))
      this.hourIncrement   := Integer(IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement))
      this.maxRows         := Integer(IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows))
      this.fontScaleFactor := Number(IniRead(this.iniFile, A_ComputerName, "FontScaling", this.fontScaleFactor))
      this.ColorCodeDaily  := IniRead(this.iniFile, A_ComputerName, "Color Code Daily", this.ColorCodeDaily)

      ; Build the GUI, should be DPI aware, composting helps with flicker
      X := IniRead(this.iniFile, A_ComputerName, "X", 0)
      Y := IniRead(this.iniFile, A_ComputerName, "Y", 0)

      g := this.BuildGUI(X?, Y?)
      OnMessage(0x404, this.TrayMessage.Bind(this))
      this.cbUpdateData := this.RefreshData.bind(this)
      If (ComObject("{DCB00C01-570F-4A9B-8D69-199FDBA5723B}").IsConnectedToInternet) {
         this.RefreshData()
      } Else {
         MsgBox("You do not seem to be connected to the internet which is required for data")
         SetTimer(this.cbUpdateData, this.Interval * 60000)
      }
      OnExit this.SaveOnExit.bind(this)
      Sleep(100)
   }
   /**
    * Build/Rebuild the GUI
    * @returns {unset?} 
    */
   Static BuildGUI(X, Y) {
      If (this.Gui) {
         D2DText.DisposeAll(this.Gui)
         this.Gui.Destroy()
      }
      /** @type {Gui} */
      g := this.Gui := Gui("-Caption +ToolWindow +Border +DPIScale +E0x02000000")
      g.BackColor := "1E1E2E"
      g.MarginX := fs(10), g.MarginY := fs(8)
      /*
         y+N is relative to the bottom edge of the previous control.
         yp+N is relative to the top edge (Y position) of the previous control. p = previous
         ym adds a margin
         r8 means 8 rows
      */
      this.Ctl.loc     := this.AddTextCtl(fs("w280"),                    this.Name,    fs("s11 Bold") " cA6ADC8", "Segoe UI")  ; Los Angeles

      this.Ctl.temp    := this.AddTextCtl(fs("w78 y+2") " Right",        "---°",       fs("s28") " cCDD6F4 Bold", "Segoe UI")  ; 75
      this.Ctl.AQI     := this.AddTextCtl(fs("w43 x+0 yp+12") " Right",  "---",        fs("s20") " cCDD6F4 Bold", "Segoe UI")  ; 34 same row
      this.Ctl.AQIlab  := this.AddTextCtl(fs("w30 x+2 yp+13"),           "aqi",        fs("s9")  " cA6ADC8 Norm", "Segoe UI")  ; aqi same row

      this.Ctl.hilo    := this.AddTextCtl(fs("w280 xm y+20"),            "Loading...", fs("s11") " cCDD6F4 Norm", "Segoe UI")  ; H/L temp
      this.Ctl.cond    := this.AddTextCtl("wp xp-8 yp Right",,                         fs("s11") " cCDD6F4 Bold", "Segoe UI")  ; Partly Cloudy on right

      this.Ctl.detail  := this.AddTextCtl(fs("wp xm y+8"),,                            fs("s11") " cc7cfeb Norm", "Segoe UI")  ; Feels like ...

      this.Gui.SetFont(fs("S14"), "Consolas")
      this.Ctl.srss   := this.Gui.AddD2DText(fs("w200 xm y+8"), ,                   "Segoe UI", fs(12), "f3f4cd")   ; Sunrise/Sunset
      this.Gui.SetFont(fs("S22"), "Consolas")
      this.Ctl.moon   := this.Gui.AddD2DText(fs("w50 x+8 yp-6 Right"), ,            "Segoe UI", fs(20), "f3f4cd")   ; Moon phase, larger
      ; The grids take their row height from the GUI font in effect here (r<N> sizing), so match it to the grid font
      this.Gui.SetFont(fs("S10") " Norm", "Segoe UI")
      ; Column widths are measured from the text; only the gaps (DIPs, scaled with fs like everything else) are tuned
      this.Ctl.hourly := this.Gui.AddD2DGrid(fs("w280 xm y+8") " r" (this.maxRows + 1),,"Segoe UI", fs(10), "CDD6F4")   ; Direct Write grid for emojis
      this.Ctl.hourly.SetColumns([ ; gap is after the entry
         {al: "Right", w: "auto", gap: fs(4)},    ; time
         {al: "Left",  w: "auto", gap: fs(10)},   ; day / night icon
         {al: "Right", w: "auto", gap: fs(4)},    ; temp
         {al: "Left",  w: "auto", gap: fs(12)},   ; condition icon
         {al: "Right", w: "auto", gap: fs(10)},   ; aqi
         {al: "Right", w: "auto", gap: fs(12)},   ; precip %
         {al: "Right", w: "auto", gap: fs(2)},    ; wind speed
         {al: "Right", w: "auto", gap: fs(2)},    ; "-"
         {al: "Right", w: "auto", gap: fs(8)},    ; wind speed gusts
         {al: "Left",  w: "auto"}])               ; wind direction
      this.Ctl.daily  := this.Gui.AddD2DGrid(fs("wp y+8") " r" (this.forecastDays + 1),,"Segoe UI", fs(10), "CDD6F4")   ; Direct Write grid for emojis
      this.Ctl.daily.SetColumns([
         {al: "Left",  w: "auto", gap: fs(10)},   ; day
         {al: "Right", w: "auto", gap: fs(4)},    ; low
         {al: "Left",  w: "auto", gap: fs(4)},    ; "to"
         {al: "Right", w: "auto", gap: fs(2)},    ; high
         {al: "Left",  w: "auto", gap: fs(12)},   ; condition icon
         {al: "Right", w: "auto", gap: fs(3)},    ; precip amount
         {al: "Left",  w: "auto", gap: fs(2)},    ; precip unit
         {al: "Left",  w: "auto", gap: fs(12)},   ; precip icon
         {al: "Right", w: "auto", gap: fs(2)},    ; wind speed
         {al: "Right", w: "auto", gap: fs(2)},    ; "-"
         {al: "Right", w: "auto", gap: fs(8)},    ; wind speed gusts
         {al: "Left",  w: "auto"}])               ; wind direction
      this.Ctl.updated := this.AddTextCtl(fs("wp y+8"),,                                fs("s9")  " c7F849C", "Segoe UI")  ; overlay1
      this.ActiveIcon := ""
      this.Ctl.Icon    := g.AddPicture(fs("H96 W96 X175 Y0"))      ; Pretty up the window
      if (this.dpi() > 96)
         this.DropShadow(g.hWnd) ; also border
      else
         this.Round11Corners(g.hWnd, 3) ; use slightly smaller corners, lowdpi less clipping on corners, breaks drop shadows
      ; Make the grid space with full width, looks better
      this.Ctl.hourly.SetJustify()
      this.Ctl.daily.SetJustify()
      ; Hand mouse drag/tray click/RMB Menu
      g.OnEvent("ContextMenu", (*) => this.ShowRMB())

      ; Keep on visible monitors, measure first
      g.Show("NoActivate Hide AutoSize")
      this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      g.Show("NoActivate x" X " y" Y)
      this.SnapToWorkArea(g, 0, 0, 0) ; in case it was off the screen

      ; in Init, after the controls are created
      this.Ctl.daily.GetPos(,,, &h1)
      this.Ctl.hourly.GetPos(,,, &h2)
      this.rowH1 := h1 // (this.forecastDays + 1)
      this.rowH2 := h2 // (this.maxRows + 1)      
      ; In case days/maxRows was zerod out, squash the title height
      if !(this.forecastDays && this.maxRows) 
         this.ApplyRowCounts()
      g.OnMessage(0x201, this.Drag.bind(this))
      g.OnMessage(0x232, this.SnapToWorkArea.bind(this))   ; WM_EXITSIZEMOVE

      Return g

   fs(val, r := 1) {
      k := this.fontScaleFactor
      if IsNumber(val)
         return Round(val * k, r)
      out := ""
      for tok in StrSplit(Trim(val), [" ", "`t"]) {
         if tok = ""
            continue
         if RegExMatch(tok, "i)^([xywh][msp]?[+-]?|s)(\d+(?:\.\d+)?)$", &m)
            tok := m[1] Round(m[2] * k, m[1] = "s" ? r : 0)
         out .= (out = "" ? "" : " ") tok
      }
      return out
   }

   }
   /**
    * Rebuild the GUI, most likely with a new scale factor
    * @param sf New Scale factor to use
    * @returns {unset?} 
    */
   Static ReBuildGUI(sf?) {
      If (IsSet(sf)) {
         If Abs(sf - this.fontScaleFactor) > 0.01 {
            this.fontScaleFactor := sf
            this.Gui.GetPos(&X, &Y, &W, &H)
            this.BuildGUI(X, Y)
            this.RefreshData()
         }
      }
   }
   /**
    * Call after adjusting one of the three settings that impact daily/hourly numbers below
    */
   Static ApplyRowCounts() {
      c := this.Ctl
      hg := c.hourly, dg := c.daily
      gap := 8
      hg.GetPos(, &hY)
      hH := this.maxRows ? Ceil((this.maxRows + 1) * hg._lineH + 2 * hg._pad) : -gap
      dH := this.forecastDays ? Ceil((this.forecastDays + 1) * dg._lineH + 2 * dg._pad) : -gap
      dY := hY + hH + gap
      hg.Move(, , , hH)               ; adjust height only
      dg.Move(, dY, , dH)             ; height and new Y
      c.updated.Move(, dY + dH + gap) ; new Y only
      this.Gui.Show("NoActivate AutoSize")
   }
   /**
    * Return the approzimate moon phase unicode symbol
    * @returns Unicode character for moon phase 
    */
   Static MoonPhase(deltaDay:=0) {
      p := 29.530588853                                  ; synodic month, days
      age := Mod(DateDiff(A_NowUTC, "20000106181400", "S") / 86400 + deltaDay, p)   ; days since the 2000-01-06 new moon
      idx := Mod(Floor(age / p * 8 + 0.5), 8)            ; 0 = new, 4 = full
      Return Chr(0x1F311 + idx)                          ; 🌑🌒🌓🌔🌕🌖🌗🌘
   }
   /**
    * Read the locations in the order they are in the ini file
    * loc=... is optional
    * Allows user to reorder as desired
    * @param iniFile Name of ini file
    * @param {String} section 
    * @returns {Array} Location names
    */
   Static ReadLocations(iniFile, section := "Locations") {
      cities := []
      for line in StrSplit(IniRead(iniFile, section), "`n", "`r") {
         pos := InStr(line, "=")
         city := Trim(pos ? SubStr(line, pos + 1) : line)
         if (city != "")
            cities.Push(city)
      }
      return cities
   } 
   /**
    * Helper method to add a text control with a font, returns the control
    * @param options size/placement options
    * @param default initial text
    * @param fontOpt font options (size, color, weight)
    * @param fontName font name
    * @returns {Gui.Text} the new control
    */
   Static AddTextCtl(options, default?, fontOpt?, fontName?) {
      if (IsSet(fontOpt) || IsSet(fontName))
         this.gui.SetFont(fontOpt ?? "", fontName ?? "")
      return this.gui.AddText(options " BackgroundTrans", default ?? "")
   }
   /**
    * Build/Rebuild/Show the RMB menu
    */
   Static ShowRMB() {
      this.BuildRMB()
      this.Menu.Show()
   }
   /**
    * Rebuild the RMB menu before launching it in case the settings file changed
    */
   Static BuildRMB() {
      this.Menu.Delete()
      this.Menu := Menu()
      ; Read the whole section to so retain order in the file vs by number
      ; This allows duplicate entries or just loc=.......
      If (FileExist(this.iniFile)) {
         this.Menu.Add("Manage Locations", (*) => LocationManager.Show())  ; Creates a new menu item.
         Try this.Menu.SetIcon("Manage Locations", this.Assets "Location.Ico")
         this.Menu.Add()
         maxLoc :=IniRead(this.iniFile, "Default", "Max Locations", 50)
         for idx,loc in this.ReadLocations(this.iniFile) {
            this.menu.add(loc, this.setlocation.bind(this))
            if (loc = this.Name)
               this.menu.Check(loc)
            if idx >= maxLoc
               break
         }
      } else
         this.Menu.Add("Refresh now", this.cbUpdateData)
      this.Menu.add()
      this.Menu.Add("Display Max Hourly Rows", this.BuildNumMenu("maxRows", "Max Rows", 15,1, 0))
      this.Menu.Add("Display Hourly Interval", this.BuildNumMenu("hourIncrement", "Hours Increment", 6))
      this.Menu.Add("Display Forecast Days",   this.BuildNumMenu("forecastDays", "Forecast Days", 16,1, 0))
      this.Menu.Add("Refresh Minute Interval", this.BuildNumMenu("Interval", "Refresh Minutes", 60, 5, 5))
      this.Menu.Add("Display Scale Factor",    this.BuildSFMenu("fontScaleFactor", "FontScaling", 
      ["0.75", "0.8", "0.9", "0.95", "1", "1.05", "1.1", "1.2", "1.25", "1.5", "1.75", "2.0"]))

      this.Menu.Add()
      this.Menu.Add("Edit Settings File", (*) => Run(this.iniFile))  ; Creates a new menu item.
      Try this.Menu.SetIcon("Edit Settings File", this.Assets "Settings.Ico")

      mn := "Always On Top"
      this.Menu.Add(mn, ToggleOnTop)  ; Creates a new menu item.
      If (this.OnTop)
         this.Menu.Check(mn)

      mn := "Metric Units"
      this.Menu.Add(mn, ToggleMKS)  ; Creates a new menu item.
      if (this.mks)
         this.Menu.Check(mn)

      mn := "Color Code Temperature"
      this.Menu.Add(mn, ToggleTemp)  ; Creates a new menu item.
      if (this.ColorCodeDaily)
         this.Menu.Check(mn)

      this.Menu.Add()
      this.Menu.Add("Exit", (*) => ExitApp())
      Try this.Menu.SetIcon("Exit", this.Assets "Exit.Ico")
      ToggleOnTop(*) {
         this.OnTop := !this.OnTop
         IniWrite(this.OnTop, this.iniFile, A_ComputerName, "OnTop")
         this.gui.opt(this.OnTop ? "+AlwaysOnTop" : "-AlwaysOnTop")
      }
      ToggleMKS(*) {
         this.mks := !this.mks
         IniWrite(this.mks, this.iniFile, A_ComputerName, "MKS")
         this.RefreshData()
      }
      ToggleTemp(*) {
         this.ColorCodeDaily := !this.ColorCodeDaily
         IniWrite(this.ColorCodeDaily, this.iniFile, A_ComputerName, "Color Code Daily")
         this.RefreshData()
      }
   }
   ; Build a menu for the scale factor will callback to set it
   static BuildSFMenu(prop, iniKey, vals) {
      sub := Menu()
      for v in vals {
         sub.Add(v, Rebuild.bind(v, prop, iniKey))
         if (v = this.%prop%)
            sub.Check(v)
      }
      return sub
      Rebuild(sf, prop, iniKey, *) {
         this.ReBuildGUI(sf)
         IniWrite(sf, this.iniFile, A_ComputerName, iniKey)
      }
   }
   ; Builds a 1-10 submenu for the property named prop, checking the current value
   static BuildNumMenu(prop, iniKey, mx:=10, inc:=1, mn := 1) {
      sub := Menu()
      For I in Range(mn, mx, inc) {
         sub.Add(I, this.SetNum.Bind(this, prop, iniKey))
         if (I = this.%prop%)
            sub.Check(I)
      }
      return sub
   }
   static SetNum(prop, iniKey, itemName, itemPos, sub) {
      Try sub.Uncheck(this.%prop%) ; skip if value was set not on the menu
      this.%prop% := Integer(itemName)
      sub.Check(itemName)
      IniWrite(this.%prop%, this.iniFile, A_ComputerName, iniKey)
      this.ApplyRowCounts()
      this.RefreshData()
   }
   
   /**
    * Callback when user selects a new location
    * @param place Name of location
    * @param ItemPos menu position
    * @param MyMenu menu handle
    */
   Static SetLocation(place, ItemPos, MyMenu) {
      If (place != this.Name) {
         If (obj := this.GeocodeName(place)) {
            this.Lat     := obj.lat
            this.Lon     := obj.lon
            this.CC      := obj.CC
            this.Name    := place
            this.NeedGeo := 0
            IniWrite(place, this.iniFile, A_ComputerName, "Loc")
            If (!obj.cached) {
               IniWrite(this.CC, this.iniFile, place, "CC")
               IniWrite(this.Lat, this.iniFile, place, "Lat")
               IniWrite(this.Lon, this.iniFile, place, "Lon")
               IniWrite(obj.Name, this.iniFile, place, "FullName")
            }
         } Else {
            this.NeedGeo := 1
            this.Ctl.updated.Text := "Location lookup failed for " place
            MsgBox("Failed to get a location for`n" place, "Location Error", 0x30)
         }
      }
      ; User may have changed these by hand
      this.Interval      := Integer(IniRead(this.iniFile, A_ComputerName, "Refresh Minutes", 30))
      this.forecastDays  := Integer(IniRead(this.iniFile, A_ComputerName, "Forecast Days", this.forecastDays) )
      this.hourIncrement := Integer(IniRead(this.iniFile, A_ComputerName, "Hours Increment", this.hourIncrement) )
      this.maxRows       := Integer(IniRead(this.iniFile, A_ComputerName, "Max Rows", this.maxRows) )
      this.RefreshData()
   }
   /**
    * Save Gui location on exit
    */
   static SaveOnExit(ExitReason, ExitCode) {
      this.Gui.GetPos(&X, &Y)
      IniWrite(this.Name, this.iniFile, A_ComputerName, "Loc")
      IniWrite(X, this.iniFile, A_ComputerName, "X")
      IniWrite(Y, this.iniFile, A_ComputerName, "Y")
      this.writeIfBlank(this.ColorCodeDaily, A_ComputerName, "Color Code Daily")
      this.writeIfBlank(this.Interval, A_ComputerName, "Refresh Minutes")
      this.writeIfBlank(this.forecastDays, A_ComputerName, "Forecast Days")
      this.writeIfBlank(this.fontScaleFactor, A_ComputerName, "FontScaling") ;
      this.writeIfBlank(this.maxRows, A_ComputerName, "Max Rows")
   }
   Static writeIfBlank(val, section, tag) {
      If (IniRead(this.iniFile, section, tag, "xxx") == "xxx") {
         IniWrite(val, this.iniFile, section, tag)
      }
   }
   /**
    * Drag the GUI on a message since we don't have a caption
    */
   static Drag(GuiOrCtrlObj, wParam, lParam, msg) {
      DllCall("ReleaseCapture")
      PostMessage(0xA1, 2, , , GuiOrCtrlObj.hWnd)   ; WM_NCLBUTTONDOWN, HTCAPTION
   }
   /**
    * Snap the GUI so it is fully enclosed by a monitor
    */
   Static SnapToWorkArea(GuiOrCtrlObj, wParam, lParam, msg) {
      hMon := DllCall("MonitorFromWindow", "Ptr", GuiOrCtrlObj.hwnd, "UInt", 2, "Ptr")   ; MONITOR_DEFAULTTONEAREST
      mi := Buffer(40, 0)
      NumPut("UInt", 40, mi)                                                 ; MONITORINFO.cbSize
      DllCall("GetMonitorInfo", "Ptr", hMon, "Ptr", mi)
      L := NumGet(mi, 20, "Int"), T := NumGet(mi, 24, "Int")                 ; rcWork
      R := NumGet(mi, 28, "Int"), B := NumGet(mi, 32, "Int")
      WinGetPos(&x, &y, &w, &h, GuiOrCtrlObj)
      nx := Max(L, Min(x, R - w))
      ny := Max(T, Min(y, B - h))
      If (nx != x || ny != y)
         WinMove(nx, ny, , , GuiOrCtrlObj)
   }
   /**
    * Refresh the weather and Air Quality data
    * Reschedule the timer depending on result
    */
   Static RefreshData(*) {
      SendMessage(0x000B, 0, 0, , this.Gui.hwnd)   ; WM_SETREDRAW , helps with flicker
      Try {
         ok := this.UpdateAirQuality()
         ok := this.UpdateWeather() && ok
      } finally {
         SendMessage(0x000B, 1, 0, , this.Gui.hwnd)   ; WM_SETREDRAW on
      }
      ; Everything updated, now refresh all at once
      this.RefresMe()
      SetTimer(this.cbUpdateData, ok ? this.Interval * 60000 : -60000)
      this.PruneMemory()
      OutputDebug("WeatherWidget: Updated Weather and Air Quality for " this.name)
   }
   /**
    * Resolve lat/lon from the location name if needed.
    * @returns {Boolean} true if coordinates are available, false if the lookup failed
    */
   Static EnsureGeo() {
      If (!this.NeedGeo)
         Return true
      If (!(obj := this.GeocodeName(this.Name))) {
         this.Ctl.updated.Text := "Location lookup failed for " this.Name " - " FormatTime(, "h:mm tt")
         Return false
      }
      this.Lat := obj.lat, this.Lon := obj.lon, this.CC :=obj.CC, this.NeedGeo := 0
      Return true
   }

   /**
    * GET a URL and hand the response text to a renderer.
    * On any failure, shows the error and schedules a retry.
    * @param url The full request URL
    * @param renderer Callback that receives the response text
    */
   Static Query(url, renderer) {
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(3000, 3000, 8000, 8000)
         http.Open("GET", url, false)
         http.Send()
         if (http.Status != 200)
            throw Error("HTTP " http.Status)
      } catch Any as e {
         this.Ctl.updated.Text := "Update failed " FormatTime(, "h:mm tt") " (" e.Message ")"
         OutputDebug("Update failed " FormatTime(, "h:mm tt") " (" e.Message ")")
         Return false
      }
      Try {
         renderer(http.ResponseText)
      } Catch Any As e {
         this.Ctl.updated.Text := "Render Error " FormatTime(, "h:mm tt") " (" e.Message ")"
         OutputDebug("Render Error " FormatTime(, "h:mm tt") " (" e.Message ")")
         Return false
      }
      Return true
   }

   /**
    * Query the JSON Air Quality data
    * NOTE : If location is in europe (), may be better to use the europe standard of european_aqi.
    *        Note, the color coding breakpoints would be differnt
    */
   Static UpdateAirQuality(*) {
      If (!this.EnsureGeo())
         Return false
      url := "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" this.Lat "&longitude=" this.Lon
         . "&current=us_aqi&hourly=us_aqi&forecast_hours=" this.maxRows * this.hourIncrement + 2 "&timezone=auto"
      Return this.Query(url, this.RenderAQI.Bind(this))
   }

   /**
    * Query the JSON Weather data
    */
   Static UpdateWeather(*) {
      If (!this.EnsureGeo())
         Return false
      If (this.mks) {
         ws := "kmh"
         tu := "celsius"
         pu := "mm"
      } Else {
         ws := "mph"
         tu := "fahrenheit"
         pu := "inch"
      }
      url := "https://api.open-meteo.com/v1/forecast?latitude=" this.Lat "&longitude=" this.Lon
         . "&current=weather_code,temperature_2m,,wind_gusts_10m,wind_speed_10m,wind_direction_10m,apparent_temperature,relative_humidity_2m,is_day"
         . "&hourly=weather_code,temperature_2m,precipitation_probability,wind_speed_10m,wind_gusts_10m,wind_direction_10m,is_day"
         . "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,snowfall_sum,precipitation_probability_max,wind_speed_10m_max,wind_gusts_10m_max,wind_direction_10m_dominant,sunrise,sunset"
         . "&precipitation_unit=" pu 
         . "&temperature_unit=" tu "&wind_speed_unit=" ws "&forecast_days=" max(this.forecastDays,1)
         . "&forecast_hours=" this.maxRows * this.hourIncrement + 2 "&timezone=auto"
      Return this.Query(url, this.RenderWeather.Bind(this))
   }

   /**
    * Render the US Air Quality data based on JSON data
    * @param json Query Results
    */
   Static RenderAQI(json) {
      cur   := this.Section(json, "current")
      hrs   := this.Section(json, "hourly")
      times := this.List(hrs, "time")
      haqi  := this.List(hrs, "us_aqi")
      ; Save this for weather render stage, keyed by hour so it aligns with the weather data
      this.hourlyAQI := Map()
      Loop times.Length
         this.hourlyAQI[times[A_Index]] := haqi.Has(A_Index) ? haqi[A_Index] : ""
      v := this.Value(cur, "us_aqi")
      If (!IsNumber(v)) {
         this.Ctl.AQI.Text := "---"
         Return
      }
      aqi := Integer(v)
      this.Ctl.AQI.Text := aqi
      this.Ctl.AQI.SetFont("C" this.AqiColor(aqi))
   }
   Static AqiColor(aqi) {
      Return (aqi = "" || aqi < 0) ? "ffffff"
      : aqi <= 50 ? "1dd31d"
      : aqi <= 100 ? "cece1f"
      : aqi <= 150 ? "c9721b"
      : aqi <= 200 ? "f93434"
      : aqi <= 300 ? "99004C"
      : "7E0023"
   }
   /**
    * Render the weather related text fields with updated data
    * @param json Json text to parse
    */
   static RenderWeather(json) {
      cur    := this.Section(json, "current")
      day    := this.Section(json, "daily")
      hrs    := this.Section(json, "hourly")

      code  := Integer(this.Value(cur, "weather_code"))
      isDay := Integer(this.Value(cur, "is_day"))
      tf    := Round(this.Value(cur, "temperature_2m"))
      d     := Compass(this.Value(cur, "wind_direction_10m"))
      ; Time for weather location
      off      := Integer(this.Value(json, "utc_offset_seconds"))
      localNow := DateAdd(A_NowUTC, off, "Seconds")

      ; change background if transitioning from day ⬌ Night
      bgc := isDay ? "1E1E2E" : "11111B"
      If (this.Gui.BackColor != bgc) {
         this.Gui.BackColor := bgc
      }
      ;-----------------------------------------------------------------------
      ; Constants
      ;-----------------------------------------------------------------------
      hc := 0xFFFFFF ; Header Color
      tc := this.Ctl.daily._fg ; Normal Text Color (same as default)
      cc := this.ColorCodeDaily
      ;-----------------------------------------------------------------------
      ; Current
      ;-----------------------------------------------------------------------
      this.Ctl.loc.Text  := this.Name
      this.Ctl.temp.Text := tf "°"
      wsu                := this.mks ? " km/h " : " mph "
      sr                 := "☀↑  " StrLower(FormatTime(RegExReplace(this.List(day, "sunrise")[1] , "\D"), "h:mm tt"))   ; "7:22 am"
      ss                 := "🌙↓  " StrLower(FormatTime(RegExReplace(this.List(day, "sunset")[1] , "\D"), "h:mm tt"))   ; "7:22 am"
      this.Ctl.srss.Text := sr . "  " ss ; . "       " this.MoonPhase()
      this.Ctl.moon.Text := this.MoonPhase()
      hi                 := Round(this.List(day, "temperature_2m_max")[1])
      lo                 := Round(this.List(day, "temperature_2m_min")[1])
      this.Ctl.cond.Text := this.Codes.Get(code, "Code " code)
      this.Ctl.hilo.Text := "🡩" hi "° 🡫" lo "°" ; 45 is hand tuned
      cold := this.mks ? 4 : 40, hot := this.mks ? 32 : 90
      this.Ctl.detail.Text := (tf < cold ? "❄ " : tf > hot ? "🌡️ " : "") 
         . "Feels " Round(this.Value(cur, "apparent_temperature")) "°"
         . "   Hum " Round(this.Value(cur, "relative_humidity_2m")) "%"
         . "   Wind " Round(this.Value(cur, "wind_speed_10m")) . wsu . d
      ;-----------------------------------------------------------------------
      ; Hourly data starts at the current hour (forecast_hours), not midnight
      ;-----------------------------------------------------------------------
      times := this.List(hrs, "time")
      temps := this.List(hrs, "temperature_2m")
      pops  := this.List(hrs, "precipitation_probability")
      winds := this.List(hrs, "wind_speed_10m")
      windg := this.List(hrs, "wind_gusts_10m")
      dirs  := this.List(hrs, "wind_direction_10m")
      codes := this.List(hrs, "weather_code")
      dns   := this.List(hrs, "is_day")
      RegExMatch(times[1], "T(\d+)", &m)
      h0    := Integer(m[1])      ; clock hour of array element 1
      ; Get the temperature range
      hrArray := []
      Loop temps.length {
         t := IsNumber(temps[A_Index]) ? Round(temps[A_Index]) : 0 ; if every 0 will through off range
         hrArray.push(t)
      }
      loHr := Min(hrArray*), hiHr := Max(hrArray*)
      i := 2
      rows := []
      while (A_Index <= this.maxRows && i <= temps.Length) {
         hr := Mod(h0 + i - 1, 24)   ; clock hour for this element
         dn := dns[i]
         t  := temps[i]
         p  := pops[i]
         w  := winds[i]
         g  := windg[i]
         a  := this.hourlyAQI.Get(times[i], "")   ; from AQI query, matched by hour
         d  := Compass(dirs[i])
         wcn := Integer(codes[i])
         if (wcn = 0 and !dn)
            wc := this.MoonPhase()
         else
            wc := this.emoji.get(wcn, "🌈")
         if A_Index == 1
            rows.Push([
               {t: "―Time―", span: 2, al: "Center", c:hc}, 
               {t: "Temp", span: 2, al: "Center", c:hc}, 
               {t: "AQI",  al: "Center", c:hc}, 
               {t: "Prec", al: "Center", c:hc}, 
               {t: "Wind" . wsu, span: 4, al: "Center", c:hc}
            ])
         rows.Push([
              this.Hour12(hr)
            , daynight(dn)
            , { t: (IsNumber(t) ? this.fixfix(Round(t) "°") : "--"), c: cc && IsNumber(t) ? TempColor(Round(t), loHr, hiHr) : tc }
            , wc
            , IsNumber(a) ? {t: a, c: this.AqiColor(a)} : "--"
            , IsNumber(p) ? p "%" : "--"
            , IsNumber(w) ? Round(w) : "--"
            , "-"
            , IsNumber(g) ? Round(g) : "--"
            , d
         ])
         i += this.hourIncrement
      }
      this.Ctl.hourly.SetRows(rows)
      ;-----------------------------------------------------------------------
      ; Daily Forecast
      ;-----------------------------------------------------------------------
      If (this.forecastDays) {
         rows := []
         lows := [], highs := []
         Loop this.forecastDays {
            lows.Push(Round(this.List(day, "temperature_2m_min")[A_Index]))
            highs.Push(Round(this.List(day, "temperature_2m_max")[A_Index]))
         }
         loMin := Min(lows*),        loMax := Max(lows*)
         hiMin := Min(highs*),       hiMax := Max(highs*)
      ; oMin  := Min(loMin, hiMin), oMax  := Max(loMax, hiMax)
         winds := this.List(day, "wind_speed_10m_max")
         windg := this.List(day, "wind_gusts_10m_max")
         dirs  := this.List(day, "wind_direction_10m_dominant")
         preps := this.List(day, "precipitation_sum")
         snows := this.List(day, "snowfall_sum")
         days  := this.List(day, "time")
         codes := this.List(day, "weather_code")
         Loop this.forecastDays {
            i := A_Index
            w := winds[i]
            g := windg[i]
            c := dirs[i]
            If i == 1
               rows.Push([
                 { t: "Day", al: "Left", c: hc }
               , { t: "―Temp―", span: 4, al: "Center", c: hc }
               , { t: "―Prec―", span: 3, al: "Center", c: hc }
               , { t: "Wind" wsu, span: 4, al: "Center", c: hc }
               ])
            ; TODO - can use rain_sum or showers_sum vs precipitation_sum to determine showfall
            psum := IsNumber(preps[i]) ? Number(preps[i]) : 0 ; total water precepitation in / mm
            ssum := IsNumber(snows[i]) ? Number(snows[i]) : 0 ; total rainfall precepitation in / cm
            If (psum < 0.01)
               pVal := Round(ssum, 1), pUnit := this.mks ? "mm" : "in", pIcon := ""
            Else If ((this.mks ? ssum : ssum / 10) >= psum * 0.5) ; Assume snow is 10:1 expansion for water
               pVal := Round(ssum, 1), pUnit := this.mks ? "cm" : "in", pIcon := "❄"
            Else
               pVal := Round(psum, 1), pUnit := this.mks ? "mm" : "in", pIcon := "🌧️"

            rows.Push([
               i == 1 ? "Today" : FormatTime(Trim(StrReplace(days[i], '-'), '"'), "ddd")
               , { t: this.fixfix(lows[i] "°"), c: cc ? TempColor(lows[i], loMin, loMax) : tc }
               , "🠊"
               , { t: this.fixfix(highs[i] "°"), c: cc ? TempColor(highs[i], hiMin, hiMax) : tc }
               , this.emoji.get(Integer(codes[i]), "🌈")
               , pVal
               , pUnit
               , pIcon
               , isnumber(w) ? round(w) : "--"
               , "-" 
               , isnumber(g) ? Round(g) : "--"
               , isnumber(c) ? Compass(c) : ""
            ])
         }
         this.Ctl.daily.SetRows(rows)
      }
      ;-----------------------------------------------------------------------
      ; Updated footer
      ;-----------------------------------------------------------------------
      this.Ctl.updated.Text := "Updated " FormatTime(, "h:mm tt") "    Local Time " FormatTime(localNow, "MMM d, h:mm tt")
      ;-----------------------------------------------------------------------
      ; Condition ICON
      ;-----------------------------------------------------------------------
      If (this.Icons.has(code)) {
         Icon := this.Assets . this.Icons[code] . ".ico"
         ; Night time has some adjustments
         If (NOT isDay) {
            AltIcon := this.Assets . "Night " . this.Icons[code] . ".ico"
            if (FileExist(AltIcon))
               Icon := AltIcon
         }
         ; Only change if different
         If (Icon != this.ActiveIcon) {
            If (FileExist(Icon)) {
               TraySetIcon(Icon)
               this.Ctl.Icon.Value := Icon
               this.ActiveIcon := Icon
            } Else {
               OutputDebug("Missing expected Icon File:" Icon)
            }
         }
         A_IconTip := this.Name "`n" (Round(this.Value(cur, "temperature_2m")) . "° - " . this.Codes[code])
      }
      static Compass(deg) {
         if (!IsNumber(deg))
            return "?"
         return ["🡓","🡗N","🡗","🡗E","🡐","🡔E","🡔","🡔S","🡑","S🡕","🡕","W🡕","🡒","W🡖","🡖","N🡖"][Mod(Round(deg / 22.5), 16) + 1]
      }
      static daynight(dn) => !IsNumber(dn) ? "?" : dn ? "🌞" : "🌙"
      Static TempColor(v, lo, hi) {
         Static stops := [0x4A90FF, 0x3CCBC4, 0xFFD23F, 0xFF3B30]
         t     := hi > lo ? (v - lo) * 768 // (hi - lo) : 384   ; 0..768, three 256-wide segments
         seg   := Min(t // 256, 2), f := t - seg * 256
         a     := stops[seg + 1],   b := stops[seg + 2]
         r     := ((a >> 16 & 255) * (256 - f) + (b >> 16 & 255) * f) >> 8
         g     := ((a >> 8 & 255) * (256 - f) + (b >> 8 & 255) * f) >> 8
         bl    := ((a & 255) * (256 - f) + (b & 255) * f) >> 8
         Return (r << 16) | (g << 8) | bl
      }
   }
   Static Dpi()               => DllCall("GetDpiForWindow", "Ptr", Weather.Gui.Hwnd, "UInt")
   static Section(json, name) => RegExMatch(json, '"' name '":\{([^}]*)\}', &m) ? m[1] : ""
   static Value(sec, key)     => RegExMatch(sec, '"' key '":(-?[\d.]+)', &m) ? m[1] : ""
   static List(sec, key)      => RegExMatch(sec, '"' key '":\[([^\]]*)\]', &m) ? StrSplit(m[1], ",") : []
   static Hour12(h)           => ((h := Mod(h, 24)) = 0 ? 12 : h > 12 ? h - 12 : h) (h < 12 ? " AM" : " PM")
   static fixfix(st)          => StrReplace(StrReplace(st," "," "),"-","‒")
   Static FormatLR(left, right, total := 80) {
      pad := Max(total - StrLen(left), StrLen(right))
      Return Format("{1}{2:" pad "s}", left, right)
   }
   ;----------------------------------------------------------------------------
   ; Round the corners of the GUI for windows 11, ignored on Windows 10
   ; Also draws a rounded border
   ; Needed since we don't have a caption
   ; This value is supported starting with Windows 11 Build 22000
   ;----------------------------------------------------------------------------
   Static Round11Corners(hWnd, how := 2) {
      howRound := how
      ; round corners on windows 11, ignored by windows 10
      ; DWMWA_WINDOW_CORNER_PREFERENCE = 33
      ; DWMWCP_ROUND=2, 4 = size of int
      DllCall("dwmapi\DwmSetWindowAttribute"
         , "Ptr", hWnd
         , "UInt", DWMWA_WINDOW_CORNER_PREFERENCE := 33
         , "Int*", &howRound
         , "UInt", 4)

   }   
   /**
    * Give the window a drop shadow, since no caption it won't do it by default
    * Also gives it the standard windows 11 drop shadow
    * Doesn't work on layered windows
    */
   Static DropShadow(hwnd) {
      policy := 2   ; DWMNCRP_ENABLED
      DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 2, "Int*", &policy, "UInt", 4)
      mar := Buffer(16, 0)
      NumPut("Int", 1, "Int", 1, "Int", 1, "Int", 1, mar)
      DllCall("dwmapi\DwmExtendFrameIntoClientArea", "Ptr", hwnd, "Ptr", mar)
   }

   /**
    * Tray message callback when icon is clicked, toggle the window visibility
    */
   Static TrayMessage(wParam, lParam, uMsg, hWnd) {
      ; debug(hex(lParam))
      Switch lParam {
         Case 0x201:   ; user left-clicked tray icon
            ; Send "#{Tab}"
         Case 0x202:   ; user left-clicked tray icon
            If (GetKeyState("Ctrl", "P"))
               this.Gui.hide()
            else
               this.Gui.show()
         Case 0x203:   ; user double left-clicked tray icon
         Case 0x204:   ; user right-clicked tray icon
         Case 0x208:   ; user middle-clicked tray icon
         Default:
      }
   }
   Static IsWindowVisible(hwndTry) => DllCall("User32.dll\IsWindowVisible", "Ptr", hwndTry)
   Static PruneMemory() => DllCall("psapi\EmptyWorkingSet", "ptr", -1)
   Static IsTopVisible(hwnd) {
      cloaked := Buffer(4)
      cur := hwnd
      while (cur := DllCall("GetWindow", "Ptr", cur, "UInt", 3, "Ptr")) {
         if !DllCall("IsWindowVisible", "Ptr", cur) || DllCall("IsIconic", "Ptr", cur)
            continue
         DllCall("dwmapi\DwmGetWindowAttribute", "Ptr", cur, "UInt", 14, "Ptr", cloaked, "UInt", 4)
         if NumGet(cloaked, 0, "UInt")
            continue
         return false
      }
      return true
   }
   Static FitGridWidth() {
      need := Ceil(Max(this.Ctl.hourly.ContentW, this.Ctl.daily.ContentW))
      If (need > this.gridW) {
         this.gridW := need
         this.Ctl.hourly.Move(, , need)
         this.Ctl.daily.Move(, , need)
         this.Gui.Show("NoActivate AutoSize")
      }
   }
/**
    * Return an object with the lat/long of some place
    * @param place Name of location
    * @returns {Integer | Object}  n.lat, n.lon, n.name
    */
   Static GeocodeName(place) {
      If (!place) {
         default := this.GetLocalPlaceName()
         res := InputBox("Enter Default Weather Location`nAn estimated location is shown below`nModify as needed", "Weather Locaiton Needed",,default)
         If (res.Result = "Ok") {
            place := res.Value
         } else {
            return false
         }
      }
      ; See if location is cached
      lat := IniRead(this.iniFile, place, "Lat", "")
      lon := IniRead(this.iniFile, place, "Lon", "")
      CC  := IniRead(this.iniFile, place, "CC", "us")
      if (IsNumber(lon) AND IsNumber(lat))
         return {place: place, lat: Round(lat,7), lon: Round(lon,7), name: place, CC: CC, cached:1}
      ; Query location data from openstreetmap
      url := "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&q=" UriEncode(place)
      try {
         http := ComObject("WinHttp.WinHttpRequest.5.1")
         http.SetTimeouts(5000, 5000, 10000, 10000)
         http.Open("GET", url, false)
         http.SetRequestHeader("User-Agent", "AHK2-GeoLookup/1.0")   ; required by Nominatim
         http.Send()
         txt := http.ResponseText
      } catch
         return false

      if !RegExMatch(txt, '"lat":"(-?[\d.]+)"', &mLat)
      || !RegExMatch(txt, '"lon":"(-?[\d.]+)"', &mLon)
         return false   ; empty result "[]"

      RegExMatch(txt, '"display_name":"((?:[^"\\]|\\.)*)"', &mName)
      RegExMatch(txt, '"country_code":"([a-z]{2})"', &mCC)
      return {place: place, lat: Round(mLat[1],7), lon: Round(mLon[1],7), name: mName ? mName[1] : place, CC: mCC ? mCC[1] : "", cached:0}
      
      UriEncode(s) {
         n := StrPut(s, "UTF-8") - 1
         buf := Buffer(n + 1)
         StrPut(s, buf, "UTF-8")
         out := ""
         Loop n {
            b := NumGet(buf, A_Index - 1, "UChar")
            if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
            || b = 45 || b = 46 || b = 95 || b = 126
               out .= Chr(b)
            else
               out .= Format("%{:02X}", b)
         }
         return out
      }   
   }
   /**
    * Return the closest location of local network
    * @returns Closest location of network 
    */
   Static GetLocalPlaceName() {
      try {
         whr := ComObject("WinHttp.WinHttpRequest.5.1")
         whr.SetTimeouts(5000, 5000, 10000, 10000)
         whr.Open("GET", "https://ipwho.is/?fields=success,city,region,country", false)
         whr.Send()
         txt := whr.ResponseText
         OutputDebug(txt)
      } catch
         Return ""
      If !InStr(txt, '"success": true')
         Return ""
      place := ""
      For key in ["city", "region", "country"]
         If RegExMatch(txt, '"' key '":\s*"((?:[^"\\]|\\.)*)"', &m) && m[1] != ""
            place .= (place = "" ? "" : ", ") m[1]
      Return place
   }
   /**
    * Refresh the GUI without it flashing
    * Native controls have transparent backgrounds, so they need refresh when updated
    * Once that is done call the D2D refresh for the D2D based controls
    * If we just invalidate the whole GUI, the native controls will temporally flash
    */
   Static RefresMe() {
      ; Refresh the native controls only
      Weather.RefreshNative() ; needed for when widget is on a disabled screen, background doesn't always erase
      ; Refresh the D2D controls
      D2DText.RefreshAll(this.Gui)
   } 
   /**
    * Erase-and-invalidate only the transparent native text controls; D2D controls clear themselves.
    * Follow with RefresMe(false) to paint everything in one pass.
    */
   Static RefreshNative() {
      hG := this.Gui.Hwnd
      rc := Buffer(16)
      For name, ctl in this.Ctl.OwnProps() {
         If !(ctl is Gui.Text OR ctl is Gui.PIC)
            Continue
         DllCall("GetWindowRect", "Ptr", ctl.Hwnd, "Ptr", rc)
         DllCall("MapWindowPoints", "Ptr", 0, "Ptr", hG, "Ptr", rc, "UInt", 2)   ; screen -> client
         DllCall("RedrawWindow", "Ptr", hG, "Ptr", rc, "Ptr", 0, "UInt", 0x0001|0x0004|0x0080)   ; INVALIDATE|ERASE|ALLCHILDREN
      }
      DllCall("RedrawWindow", "Ptr", hG, "Ptr", 0, "Ptr", 0, "UInt", 0x0100|0x0080)   ; one UPDATENOW pass for everything queued
   }   
   /**
    * Update the active location name if it was renamed
    * @param newName New location name to use
    * @returns {unset?} 
    */
   Static ChangeLocationName(newName) {
      If this.Name != newName {
         this.Name := newName
         this.Ctl.loc.Text := newName
      }
   }
}
/**
 * On unlock or resume from sleep, refresh immediatly
 */
SetupEventMonitoring() {
   Static WM_POWERBROADCAST    := 0x0218
   Static WM_DISPLAYCHANGE     := 0x7E
   Static WM_WTSSESSION_CHANGE := 0x2B1
   ; Registers to receive notification when the system is suspended or resumed
   Static hwndNotification := 0
   Static hDisplay := 0
   hwndNotification := DllCall("RegisterSuspendResumeNotification", "Ptr", A_ScriptHwnd, "UInt", 0, "Ptr")
   ; Registers the specified window to receive session change notifications
   ; DllCall("Wtsapi32.dll\WTSRegisterSessionNotification", "ptr", A_ScriptHwnd, "uint", 1)
   DllCall("Wtsapi32\WTSRegisterSessionNotification", "Ptr", A_ScriptHwnd, "UInt", 0) ; NOTIFY_FOR_THIS_SESSION = 0
   ; Message Hanlders are closures
   OnMessage(WM_POWERBROADCAST, cbPowerChangeEvent)
   OnMessage(WM_WTSSESSION_CHANGE, cbSessionChange)
   OnMessage(WM_DISPLAYCHANGE, cbDisplayChange)   ; WM_DISPLAYCHANGE
   ; GUID_CONSOLE_DISPLAY_STATE
   DllCall("ole32\CLSIDFromString", "Str", "{6FE69556-704A-47A0-8F24-C28D936FDA47}", "Ptr", guid := Buffer(16))
   hDisplay := DllCall("RegisterPowerSettingNotification", "Ptr", A_ScriptHwnd, "Ptr", guid, "UInt", 0, "Ptr")   ; DEVICE_NOTIFY_WINDOW_HANDLE
   /*==============================================================================
   Suspend resume messages, 7 means the user also initiated it vs system background
   AHK2 WM_BROADCAST:18, lparam=0, msg=536 PBT_APMRESUMEAUTOMATIC
   AHK2 WM_BROADCAST:7, lparam=0, msg=536 PBT_APMRESUMESUSPEND
   ================================================================================*/
   OnExit UnRegisterPower
   Return
   ; Session Change lock/unlock
   cbSessionChange(wParam, lParam, msg, hwnd) {
      Static WTS_SESSION_LOCK := 0x7, WTS_SESSION_UNLOCK := 0x8
      If (wParam = WTS_SESSION_LOCK) {
         SetTimer(Weather.cbUpdateData, 0)
      } Else If (wParam = WTS_SESSION_UNLOCK) {
         Weather.RefresMe()
         ; D2DText.RefreshAll(Weather.Gui)
         OutputDebug("WeatherWidget: Session Change")
         SetTimer(Weather.cbUpdateData, -5000)
      }
   }
   ; Resume from sleep
   cbPowerChangeEvent(wParam, lParam, Msg, hWnd) {
      Static PBT_APMRESUMESUSPEND := 0x7, PBT_APMRESUMEAUTOMATIC := 0x12
      Static PBT_POWERSETTINGCHANGE := 0x8013
      Switch wParam {
         Case PBT_APMRESUMESUSPEND, PBT_APMRESUMEAUTOMATIC:
            Weather.RefresMe()
            ; D2DText.RefreshAll(Weather.Gui)
            SetTimer(Weather.cbUpdateData, -10000)
            OutputDebug("WeatherWidget: Resume from Suspension")
         Case PBT_POWERSETTINGCHANGE:
            ; POWERBROADCAST_SETTING: GUID (16) + DataLength (4) + Data
            ; Data: 0 = off, 1 = on, 2 = dimmed, ignore initial trigger at launch
            If (A_TickCount > (Weather.Launched + 60000) AND NumGet(lParam, 20, "UChar") = 1) {
               Weather.RefresMe()
               SetTimer(Weather.cbUpdateData, -5000)
               OutputDebug("WeatherWidget: PBT_POWERSETTINGCHANGE")
            }

         Default:
      }
   }
   /**
    * Hack if the GUI was on a disabled monitor, the composting will not
    * update the window itself
    * wParam = new bit depth
    * lParam is resolution (low word is width, high word is height)
    */
   cbDisplayChange(wParam, lParam, msg, hwnd) {
      OutputDebug("Redrawing Window due to refresh:")
      SetTimer(RefreshGui, -4000)   ; let the display stack settle first
      Return
      Static RefreshGui() {
         Weather.RefresMe()
      }
   }
   ;----------------------------------------------------------------------
   ; On exit, unregister handlers
   ;----------------------------------------------------------------------
   UnRegisterPower(ExitReason, ExitCode) {
      DllCall("Wtsapi32.dll\WTSUnRegisterSessionNotification", "ptr", A_ScriptHwnd)
      If (hwndNotification)
         DllCall("UnregisterSuspendResumeNotification", "ptr", hwndNotification)
      If (hDisplay)
         DllCall("UnregisterPowerSettingNotification", "Ptr", hDisplay)
   }
}

class MenuDarkMode {
   static Enable(mode := 2) {   ; 0 Default, 1 AllowDark (follows system), 2 ForceDark, 3 ForceLight
      static hMod := DllCall("LoadLibrary", "Str", "uxtheme", "Ptr")
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 135, "Ptr"), "Int", mode)
      DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 136, "Ptr"))
   }
}
/*
 * Class to manage thw weather widget locations
*/
class LocationManager {
   static IniFile := A_ScriptDir "\WeatherWidget.ini"
   static Section := "Locations"
   static Items := []
   static Gui := ""
   static LB := ""
   static Edit := ""

   static InitW := 430
   static InitH := 340
   static Margin := 10
   static Gap := 5

   static Show() {
      if this.Gui {
         this.Gui.Show()
         return
      }
      this.Load()
      g := this.Gui := Gui("+Resize", "Manage Weather Locations")
      g.SetFont("s10")
      this.LB        := g.AddListBox("r15")
      this.BtnUp     := g.AddButton("w90 left", "🡅 Move &Up")
      this.BtnDown   := g.AddButton("w90 left", "🡇 Move &Down")
      this.BtnSelect := g.AddButton("w90 left", "◀ &Select")
      this.BtnRemove := g.AddButton("w90 left", "✂ &Remove")
      this.BtnRename := g.AddButton("w90 left", "✎ Re&name")      
      this.Edit      := g.AddEdit()
      this.BtnAdd    := g.AddButton("w85 Default", "🡄 &Add")
      this.BtnClose  := g.AddButton("w85", "&Close")

      this.BtnUp.OnEvent("Click", this.Move.Bind(this, -1))
      this.BtnDown.OnEvent("Click", this.Move.Bind(this, 1))
      this.BtnRemove.OnEvent("Click", this.Remove.Bind(this))
      this.BtnRename.OnEvent("Click", this.Rename.Bind(this))
      this.BtnSelect.OnEvent("Click", this.Select.Bind(this))
      this.BtnAdd.OnEvent("Click", this.Add.Bind(this))
      this.BtnClose.OnEvent("Click", this.Close.Bind(this))

      g.OnEvent("Close", this.Close.Bind(this))
      g.OnEvent("Escape", this.Close.Bind(this))
      g.OnEvent("Size", this.Size.Bind(this))

      this.PlaceControls(this.InitW, this.InitH)
      this.RefreshListBox()
      g.Opt("+MinSize" this.InitW "x" this.InitH)
      g.Show("w" this.InitW " h" this.InitH)
   }

   static PlaceControls(w, h) {
      m := this.Margin, gap := this.Gap
      this.BtnUp.GetPos(, , &bw, &bh)         ; right column button size
      this.BtnAdd.GetPos(, , &bw2)            ; bottom row button width
      this.Edit.GetPos(, , , &eh)

      rightX := w - m - bw                    ; right button column
      rowY   := h - m - bh                      ; bottom row
      closeX := w - m - bw2
      addX   := closeX - gap - bw2

      this.LB.Move(m, m, rightX - gap - m, rowY - gap - m)
      this.BtnUp.Move(rightX, m)
      this.BtnDown.Move(rightX, m + (bh + gap))
      this.BtnSelect.Move(rightX, m + (bh + gap) * 2)
      this.BtnRemove.Move(rightX, m + (bh + gap) * 3)
      this.BtnRename.Move(rightX, m + (bh + gap) * 4)
      this.Edit.Move(m, rowY + (bh - eh) // 2, addX - gap - m)
      this.BtnAdd.Move(addX, rowY)
      this.BtnClose.Move(closeX, rowY)
   }

   static Size(gui, minMax, w, h) {
      if minMax != -1                         ; skip minimize
         this.PlaceControls(w, h)
   }

   static Close(*) {
      this.Gui.Destroy()
      this.Gui := ""
   }

   static ReadText(&enc) {
      enc := "UTF-16"   ; used if the file doesn't exist yet
      if !FileExist(this.IniFile)
         return ""
      f := FileOpen(this.IniFile, "r")
      enc := f.Encoding
      if f.Pos = 0 && InStr(enc, "UTF") && !InStr(enc, "RAW")
         enc .= "-RAW"   ; no BOM in the original, so don't add one
      text := f.Read()
      f.Close()
      return text
   }

   static Load() {
      this.Items := []
      inSec := false
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         line := Trim(line)
         if RegExMatch(line, "^\[[^\]]+\]$") {
            inSec := (line = "[" this.Section "]")
            continue
         }
         if inSec && line != ""
            this.Items.Push(line)
      }
   }

   static Save() {
      out := ""
      skipping := found := false
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         t := Trim(line)
         if RegExMatch(t, "^\[[^\]]+\]$") {
            skipping := false
            out .= (out = "" ? "" : "`r`n") line "`r`n"   ; blank line before every header except the first
            if t = "[" this.Section "]" {
               found := skipping := true
               for item in this.Items
                  out .= item "`r`n"
            }
         }
         else if !skipping && t != ""
            out .= line "`r`n"
      }
      if !found {
         out .= (out = "" ? "" : "`r`n") "[" this.Section "]`r`n"
         for item in this.Items
            out .= item "`r`n"
      }
      f := FileOpen(this.IniFile, "w", enc)
      f.Write(out)
      f.Close()
   }

   static RefreshListBox(sel := 0) {
      this.LB.Delete()
      if this.Items.Length
         this.LB.Add(this.Items)
      if sel
         this.LB.Choose(sel)
   }

   static Add(*) {
      place := Trim(this.Edit.Value)
      if place = ""
         return
      for item in this.Items {
         if item = place {   ; case-insensitive duplicate check
            MsgBox("Already in the list.", "Duplicate", "Icon!")
            return
         }
      }
      ; Validate via URL
      If (obj := Weather.GeocodeName(place)) {
         ; Cache location to INI file
         IniWrite(obj.CC, this.iniFile, place, "CC")
         IniWrite(obj.Lat, this.iniFile, place, "Lat")
         IniWrite(obj.Lon, this.iniFile, place, "Lon")
         IniWrite(obj.Name, this.iniFile, place, "FullName")
         ; Save the new location
         this.Items.Push(place)
         this.Save()
         this.RefreshListBox(this.Items.Length)
         this.Edit.Value := ""
         this.Edit.Focus()
      } Else {
         MsgBox("Could not find location " place,,0x10)
      }
   }

   static Remove(*) {
      i := this.LB.Value
      place := this.LB.Text
      if !i
         return
      this.Items.RemoveAt(i)
      this.Save()
      this.RefreshListBox(Min(i, this.Items.Length))
      IniDelete(Weather.iniFile, place)
   }
   static Select(*) {
      i := this.LB.Value
      if !i
         return
      Weather.SetLocation(this.Items[i],"","")
   }
   static Rename(*) {
      i := this.LB.Value
      if !i
         return
      this.Gui.Opt("+OwnDialogs")
      oldName := this.Items[i]
      ib := InputBox("New name for this location:", "Rename Location", "w320 h110", oldName)
      if ib.Result != "OK"
         return
      newName := Trim(ib.Value)
      if newName = "" || newName == oldName
         return
      for j, item in this.Items {
         if j != i && item = newName {   ; case-insensitive duplicate check
            MsgBox("Already in the list.", "Duplicate", "Icon!")
            return
         }
      }
      ; Rename all locations in the INI File
      out := ""
      section := ""
      for line in StrSplit(this.ReadText(&enc), "`n", "`r") {
         t := Trim(line)
         if RegExMatch(t, "^\[([^\]]+)\]$", &m) {
            section := m[1]
            if section = oldName               ; location's own section
               line := "[" newName "]"
         }
         else if section = this.Section && t = oldName   ; entry in the Locations list
            line := newName
         else if RegExMatch(line, "i)^(\s*Loc\s*=\s*)(.*?)\s*$", &m) && m[2] = oldName
            line := m[1] newName               ; Loc=<oldname> in any section
         out .= (A_Index = 1 ? "" : "`r`n") line
      }
      f := FileOpen(this.IniFile, "w", enc)
      f.Write(out)
      f.Close()
      this.Items[i] := newName
      Weather.ChangeLocationName(newName)
      this.RefreshListBox(i)
   }
   static Move(dir, *) {
      i := this.LB.Value
      j := i + dir
      if !i || j < 1 || j > this.Items.Length
         return
      tmp := this.Items[i]
      this.Items[i] := this.Items[j]
      this.Items[j] := tmp
      this.Save()
      this.RefreshListBox(j)
   }
}
Range(Start, Stop, Step := 1) => (&n) => (n := Start, Start += Step, Step > 0 ? n <= Stop : n >= Stop)


; Start things up here
MenuDarkMode.Enable(1)   ; use 1 to follow the system theme instead of forcing dark
Weather.Init()
SetupEventMonitoring()
